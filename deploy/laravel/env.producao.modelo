# Modelo do .env de produção do CRM em Laravel (chmod 600; cópia dos segredos na pasta de segredos do servidor).
# Gere a chave com: docker compose run --rm app php artisan key:generate --show
APP_NAME=CRM
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://crm.areacli.com
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database

# Atrás do nginx do servidor: confiar nos cabeçalhos X-Forwarded-*
TRUSTED_PROXIES=*

# Modo de demonstração (só na instalação pública): usuários públicos, dados fictícios recriados
# todo dia no horário de Brasília e arquivo enviado trocado por um fictício. Fora dela, deixe CRM_DEMO desligado.
CRM_DEMO=1
CRM_DEMO_DOMAIN=demo.crm.areacli.com
CRM_DEMO_CUSTOMERS=1000
CRM_DEMO_RESET_AT=04:00
WEB_PORT=3210
