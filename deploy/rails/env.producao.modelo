# Modelo do .env de produção do CRM em Rails (chmod 600; cópia dos segredos na pasta de segredos do servidor).
# Gere a chave com: openssl rand -hex 64
RAILS_ENV=production
SECRET_KEY_BASE=
# Chave mestra das credenciais cifradas (config/credentials/production.yml.enc). Fica só aqui e na cópia de segredos; nunca no repositório.
RAILS_MASTER_KEY=
RAILS_LOG_LEVEL=info
RAILS_SERVE_STATIC_FILES=1

DB_HOST=db
DB_DATABASE=crm
# Decisão 0024: a aplicação entra com o papel crm_app (sem superusuário, sem BYPASSRLS, sem ser dono das tabelas), criado ou atualizado a cada
# subida com a senha de DB_PASSWORD; as migrações rodam com o dono (DB_ADMIN_*), que é o usuário que o contêiner do banco cria.
# Gere as duas senhas com: openssl rand -hex 24
DB_USERNAME=crm_app
DB_PASSWORD=
DB_ADMIN_USERNAME=crm
DB_ADMIN_PASSWORD=

# Valkey (fila do Sidekiq, Action Cable e cache). Gere a senha com: openssl rand -hex 24
REDIS_PASSWORD=
REDIS_URL=redis://:SENHA@valkey:6379/0

# Nomes aceitos no cabeçalho Host e origens aceitas no WebSocket (separados por vírgula).
CRM_HOSTS=crm.areacli.com,127.0.0.1,localhost
CRM_ORIGINS=https://crm.areacli.com
SIDEKIQ_CONCURRENCY=5
WEB_PORT=3220

# Modo de demonstração pública (só na instalação da vitrine; marco B): CRM_DEMO=1 liga a faixa de aviso, as restrições, o fornecedor falso e a
# recriação diária às 4h (Sidekiq). Sem esta variável, nada disso existe. Detalhes em o documento da demonstração do projeto.
# CRM_DEMO=1
# CRM_DEMO_DOMAIN=demo.crm.areacli.com
# CRM_DEMO_CUSTOMERS=10000
# CRM_DEMO_RESET_AT=04:00
