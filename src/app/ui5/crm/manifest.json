{
  "_version": "1.65.0",
  "sap.app": {
    "id": "crm",
    "type": "application",
    "title": "{{titulo}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "i18n": {
      "bundleName": "crm.i18n.i18n",
      "supportedLocales": [
        "pt_BR"
      ],
      "fallbackLocale": "pt_BR"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "crm.view.App",
      "type": "XML",
      "id": "app",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.tnt": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "crm.i18n.i18n",
          "supportedLocales": [
            "pt_BR"
          ],
          "fallbackLocale": "pt_BR"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "tema/tema-areacli.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "async": true
      },
      "routes": [],
      "targets": {}
    }
  }
}
