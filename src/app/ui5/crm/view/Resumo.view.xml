<mvc:View controllerName="crm.controller.Resumo" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" height="100%">
	<!-- Resumo da carteira (R23; modelo Resumo): só números e tabelas curtas; a definição de cada indicador fica no (i). -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>resumo.titulo}" level="H2" /></f:heading>
				<f:expandedContent><Text text="{dados>/referencia}" visible="{= !${dados>/vazio} }" /></f:expandedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox renderType="Bare" class="resumo">
				<IllustratedMessage illustrationType="sapIllus-NoData" title="{i18n>resumo.vazio}" visible="{= ${dados>/vazio} === true }" />
				<FlexBox renderType="Bare" class="grade-de-indicadores" items="{path: 'dados>/indicadores', templateShareable: false}">
					<core:Fragment fragmentName="crm.fragment.Indicador" type="XML" />
				</FlexBox>
				<FlexBox renderType="Bare" class="grade-de-indicadores" items="{path: 'dados>/recuperacao', templateShareable: false}">
					<core:Fragment fragmentName="crm.fragment.Indicador" type="XML" />
				</FlexBox>
				<MessageStrip text="{dados>/aviso_das_faixas}" type="Information" showIcon="true" visible="{= !!${dados>/aviso_das_faixas} }" class="sapUiSmallMarginBottom" />
				<FlexBox renderType="Bare" class="grade-de-cartoes" visible="{= !${dados>/vazio} }">
					<f:Card>
						<f:header><card:Header title="{i18n>resumo.recuperadoPorMeio}" /></f:header>
						<f:content>
							<Table fixedLayout="false" noData="{i18n>resumo.semPagamento}" columns="{path: 'dados>/recuperado_por_meio/colunas', templateShareable: false}" items="{path: 'dados>/recuperado_por_meio/linhas', templateShareable: false}">
								<columns><Column hAlign="{= ${dados>numero} ? 'End' : 'Begin' }"><Text text="{dados>texto}" wrapping="false" /></Column></columns>
								<items><ColumnListItem cells="{path: 'dados>celulas', templateShareable: false}"><cells><Text text="{dados>}" wrapping="false" /></cells></ColumnListItem></items>
							</Table>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="{i18n>resumo.acordosPorMes}" /></f:header>
						<f:content>
							<Table fixedLayout="false" items="{dados>/acordos_por_mes/linhas}">
								<columns>
									<Column><Text text="{i18n>ficha.situacao}" /></Column>
									<Column hAlign="End"><Text text="{dados>/acordos_por_mes/mes}" wrapping="false" /></Column>
									<Column hAlign="End"><Text text="{dados>/acordos_por_mes/anterior}" wrapping="false" /></Column>
								</columns>
								<items><ColumnListItem><cells><Text text="{dados>situacao}" /><Text text="{dados>mes}" /><Text text="{dados>anterior}" /></cells></ColumnListItem></items>
							</Table>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="{i18n>resumo.descontos}" /></f:header>
						<f:content>
							<Table fixedLayout="false" items="{dados>/descontos}">
								<columns><Column><Text text="{i18n>resumo.componente}" /></Column><Column hAlign="End"><Text text="{i18n>ficha.valor}" /></Column></columns>
								<items><ColumnListItem><cells><Text text="{dados>rotulo}" /><Text text="{dados>valor}" wrapping="false" /></cells></ColumnListItem></items>
							</Table>
						</f:content>
					</f:Card>
					<f:Card class="cartao-largo">
						<f:header><card:Header title="{i18n>acionamentos.titulo}">
							<card:toolbar><Button icon="sap-icon://hint" type="Transparent" tooltip="{i18n>acionamentos.titulo}" press=".mostrarDefinicao" app:definicao="{i18n>resumo.acionamentos.ajuda}" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" /></card:toolbar>
						</card:Header></f:header>
						<f:content>
							<Table fixedLayout="false" columns="{path: 'dados>/acionamentos/colunas', templateShareable: false}" items="{path: 'dados>/acionamentos/linhas', templateShareable: false}">
								<columns><Column hAlign="{= ${dados>numero} ? 'End' : 'Begin' }"><Text text="{dados>texto}" wrapping="false" /></Column></columns>
								<items><ColumnListItem cells="{path: 'dados>celulas', templateShareable: false}"><cells><Text text="{dados>}" wrapping="false" /></cells></ColumnListItem></items>
							</Table>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="{i18n>ficha.promessas}">
							<card:toolbar><Button icon="sap-icon://hint" type="Transparent" tooltip="{i18n>ficha.promessas}" press=".mostrarDefinicao" app:definicao="{i18n>resumo.promessas.ajuda}" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" /></card:toolbar>
						</card:Header></f:header>
						<f:content>
							<Table fixedLayout="false" columns="{path: 'dados>/promessas/colunas', templateShareable: false}" items="{path: 'dados>/promessas/linhas', templateShareable: false}">
								<columns><Column hAlign="{= ${dados>numero} ? 'End' : 'Begin' }"><Text text="{dados>texto}" wrapping="false" /></Column></columns>
								<items><ColumnListItem cells="{path: 'dados>celulas', templateShareable: false}"><cells><Text text="{dados>}" wrapping="false" /></cells></ColumnListItem></items>
							</Table>
						</f:content>
					</f:Card>
					<core:Fragment fragmentName="crm.fragment.FaixasDoResumo" type="XML" />
				</FlexBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
