<mvc:View controllerName="crm.controller.Distribuicao" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" height="100%">
	<!-- Distribuição (14, R311, R317, R326; modelo Lista): o que está com cada operação, desde quando e com qual exposição. Distribuir vai ao painel
	     lateral; editar e recolher, a um modal pequeno; o lote abre a tela própria numa aba. -->
	<f:FlexibleColumnLayout id="colunas" layout="OneColumn" backgroundDesign="Solid">
		<f:beginColumnPages>
			<f:DynamicPage toggleHeaderOnTitleClick="false" fitContent="true">
				<f:title><f:DynamicPageTitle>
					<f:heading><Title text="{i18n>distribuicao.titulo}" level="H2" /></f:heading>
					<f:expandedContent><Text text="{i18n>distribuicao.subtitulo}" /></f:expandedContent>
					<f:actions>
						<Button text="{i18n>distribuicao.emLote}" visible="{dados>/pode_distribuir}" press=".distribuirEmLote" />
						<Button text="{i18n>distribuicao.distribuir}" type="Emphasized" visible="{dados>/pode_distribuir}" press=".distribuir" />
					</f:actions>
				</f:DynamicPageTitle></f:title>
				<f:header>
					<f:DynamicPageHeader pinnable="false">
						<FlexBox wrap="Wrap" alignItems="End" renderType="Bare" class="filtros">
							<VBox><Label text="{i18n>distribuicao.busca}" labelFor="busca" /><SearchField id="busca" value="{filtro>/q}" liveChange=".buscarAoDigitar" search=".buscar" width="18rem" placeholder="{i18n>distribuicao.busca}" /></VBox>
							<VBox><Label text="{i18n>distribuicao.operacao}" labelFor="operacao" />
								<Select id="operacao" selectedKey="{filtro>/operation}" change=".buscar" items="{path: 'dados>/filtros/operacoes', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
							<VBox><Label text="{i18n>importacoes.situacao}" labelFor="situacao" />
								<Select id="situacao" selectedKey="{filtro>/status}" change=".buscar" items="{path: 'dados>/filtros/situacoes', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
							<VBox><Label text="{i18n>ficha.contatos.origem}" labelFor="origem" />
								<Select id="origem" selectedKey="{filtro>/source}" change=".buscar" items="{path: 'dados>/filtros/origens', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
							<VBox visible="{dados>/varios_credores}"><Label text="{i18n>clientes.credor}" labelFor="credor" />
								<Select id="credor" selectedKey="{filtro>/tenant}" change=".buscar" items="{path: 'dados>/filtros/credores', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
						</FlexBox>
					</f:DynamicPageHeader>
				</f:header>
				<f:content>
					<VBox renderType="Bare">
						<Table items="{dados>/linhas}" sticky="ColumnHeaders" fixedLayout="false" noData="{i18n>distribuicao.vazio}" itemPress=".mostrarDetalhe">
							<columns>
								<Column><Text text="{i18n>distribuicao.alvo}" /></Column><Column><Text text="{i18n>distribuicao.operacao}" /></Column>
								<Column visible="{dados>/varios_credores}"><Text text="{i18n>clientes.credor}" /></Column><Column><Text text="{i18n>distribuicao.exposicao}" /></Column>
								<Column><Text text="{i18n>distribuicao.periodo}" /></Column><Column><Text text="{i18n>ficha.contatos.origem}" /></Column>
								<Column><Text text="{i18n>importacoes.situacao}" /></Column><Column hAlign="End"><Text text="" /></Column>
							</columns>
							<items>
								<ColumnListItem type="{= ${dados>detalhe} ? 'Active' : 'Inactive' }" highlight="{= ${dados>id} === ${ui>/detalhe/id} ? 'Information' : 'None' }">
									<cells>
										<Link text="{dados>alvo}" enabled="{= !!${dados>cliente_id} }" press=".abrirFicha" /><Text text="{dados>operacao}" wrapping="false" />
										<Text text="{dados>credor}" wrapping="false" /><Text text="{dados>exposicao}" /><Text text="{dados>periodo}" wrapping="false" />
										<Text text="{dados>origem}" wrapping="false" /><ObjectStatus text="{dados>situacao/texto}" state="{dados>situacao/estado}" inverted="true" />
										<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>lista.acoes}" press=".acoes" visible="{dados>aberta}" />
									</cells>
								</ColumnListItem>
							</items>
						</Table>
						<Panel visible="{= !!${ui>/detalhe/detalhe} }" class="detalhe-da-linha"><Text text="{ui>/detalhe/detalhe}" /></Panel>
						<core:Fragment fragmentName="crm.fragment.Paginacao" type="XML" />
					</VBox>
				</f:content>
			</f:DynamicPage>
		</f:beginColumnPages>
	</f:FlexibleColumnLayout>
</mvc:View>
