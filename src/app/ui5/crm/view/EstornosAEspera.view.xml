<mvc:View controllerName="crm.controller.EstornosAEspera" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" height="100%">
	<!-- Estornos à espera do gestor (11, R233, AH2, AJ1; modelo Lista): os que esperam, com a decisão num modal pequeno, e os decididos há pouco. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{i18n>estornos.titulo}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{i18n>estornos.subtitulo}" /></f:expandedContent>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<f:Card>
					<f:header><card:Header title="{i18n>estornos.esperando}" subtitle="{i18n>estornos.esperando.ajuda}" /></f:header>
					<f:content>
						<VBox renderType="Bare" width="100%">
							<Table items="{path: 'dados>/esperando', templateShareable: false}" fixedLayout="false" noData="{i18n>estornos.vazio}" itemPress=".mostrarDetalhe">
								<columns>
									<Column><Text text="{i18n>estornos.pagamento}" /></Column><Column hAlign="End"><Text text="{i18n>titulo.valor}" /></Column>
									<Column><Text text="{i18n>clientes.credor}" /></Column><Column><Text text="{i18n>estornos.motivo}" /></Column>
									<Column hAlign="End"><Text text="{i18n>estornos.esperaHa}" /></Column><Column><Text text="{i18n>estornos.acordo}" /></Column>
									<Column><Text text="{i18n>clientes.coluna.cliente}" /></Column><Column><Text text="{i18n>estornos.contrato}" /></Column><Column hAlign="End"><Text text="" /></Column>
								</columns>
								<items>
									<ColumnListItem type="Active" highlight="{= ${dados>id} === ${ui>/detalhe/id} ? 'Information' : 'None' }">
										<cells>
											<Text text="{dados>pagamento}" wrapping="false" /><Text text="{dados>valor}" wrapping="false" /><Text text="{dados>credor}" wrapping="false" />
											<Text text="{dados>motivo}" /><Text text="{dados>espera}" wrapping="false" />
											<Link text="{= ${dados>acordo} || '—' }" enabled="{= !!${dados>acordo_id} }" press=".abrirAcordo" />
											<Link text="{= ${dados>cliente} || '—' }" enabled="{= !!${dados>cliente_id} }" press=".abrirFicha" />
											<Text text="{dados>contrato}" wrapping="false" />
											<Button text="{i18n>estornos.decidir}" press=".decidir" />
										</cells>
									</ColumnListItem>
								</items>
							</Table>
							<core:Fragment fragmentName="crm.fragment.Paginacao" type="XML" />
							<Panel visible="{= !!${ui>/detalhe/detalhe} }" class="detalhe-da-linha"><Text text="{ui>/detalhe/detalhe}" /></Panel>
						</VBox>
					</f:content>
				</f:Card>
				<f:Card visible="{= (${dados>/decididos} || []).length > 0 }" class="sapUiSmallMarginTop">
					<f:header><card:Header title="{i18n>estornos.decididos}" /></f:header>
					<f:content>
						<Table items="{path: 'dados>/decididos', templateShareable: false}" fixedLayout="false">
							<columns>
								<Column><Text text="{i18n>estornos.quando}" /></Column><Column><Text text="{i18n>estornos.acordo}" /></Column><Column hAlign="End"><Text text="{i18n>titulo.valor}" /></Column>
								<Column><Text text="{i18n>estornos.decisao}" /></Column><Column><Text text="{i18n>estornos.quem}" /></Column><Column><Text text="{i18n>estornos.motivoDaDecisao}" /></Column>
							</columns>
							<items><ColumnListItem><cells>
								<Text text="{dados>quando}" wrapping="false" /><Link text="{= ${dados>acordo} || '—' }" enabled="{= !!${dados>acordo_id} }" press=".abrirAcordo" />
								<Text text="{dados>valor}" wrapping="false" /><Text text="{dados>decisao}" /><Text text="{dados>quem}" /><Text text="{dados>motivo}" />
							</cells></ColumnListItem></items>
						</Table>
					</f:content>
				</f:Card>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
