<mvc:View controllerName="crm.controller.EditorDeSegmento" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" height="100%">
	<!-- Editor do segmento (13, R285, R301 a R305; criar, duplicar e editar): à esquerda o nome e a caixa de texto na linguagem, com "Como escrever"
	     e o glossário; à direita a coluna "Como fica", refeita pelo rascunho a cada pausa na digitação (sem refazer a caixa), "Conferir" em segundo
	     plano e onde o segmento é usado. Segmento em uso: salvar leva à conferência do impacto (R272). -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{= ${dados>/sujeito_fixo} ? ${i18n>segmentos.editar.titulo} : ${i18n>segmentos.novo.titulo} }" level="H2" /></f:heading>
			<f:expandedContent><Text text="{dados>/credor}" /></f:expandedContent>
			<f:actions>
				<Button text="{= ${dados>/usado} ? ${i18n>enquadramento.conferir} : ${i18n>segmentos.salvar} }" type="Emphasized" press=".salvar" enabled="{= !${ui>/enviando} }" />
				<Button text="{i18n>acao.cancelar}" press=".cancelar" />
			</f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<FlexBox wrap="Wrap" alignItems="Start" renderType="Bare" class="ficha">
				<VBox renderType="Bare" class="ficha-principal">
					<MessageStrip text="{ui>/erro}" type="Error" showIcon="true" visible="{= !!${ui>/erro} }" class="sapUiSmallMarginBottom" />
					<MessageStrip text="{i18n>segmentos.novo.aviso}" type="Information" showIcon="true" visible="{= !${dados>/sujeito_fixo} }" class="sapUiSmallMarginBottom" />
					<f:Card class="sapUiSmallMarginBottom" visible="{= (${dados>/exemplos} || []).length > 0 }">
						<f:header><card:Header title="{i18n>segmentos.exemplos}" subtitle="{i18n>segmentos.exemplos.ajuda}" /></f:header>
						<f:content>
							<FlexBox wrap="Wrap" renderType="Bare" class="sapUiSmallMargin" items="{path: 'dados>/exemplos', templateShareable: false}">
								<Link text="{dados>nome}" press=".usarExemplo" class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
							</FlexBox>
						</f:content>
					</f:Card>
					<f:Card class="sapUiSmallMarginBottom">
						<f:header><card:Header title="{i18n>segmentos.nome}" /></f:header>
						<f:content>
							<VBox renderType="Bare" class="sapUiSmallMargin" width="100%">
								<Label text="{i18n>segmentos.nomeDoSegmento}" labelFor="nome" required="true" />
								<Input id="nome" value="{dados>/nome}" maxLength="100" required="true" width="100%" liveChange=".marcarTrabalho" ariaDescribedBy="ajudaDoNome" />
								<Text id="ajudaDoNome" text="{i18n>segmentos.nome.ajuda}" class="nota" />
							</VBox>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="{i18n>segmentos.condicoes}" subtitle="{i18n>segmentos.condicoes.ajuda}" /></f:header>
						<f:content>
							<VBox renderType="Bare" class="sapUiSmallMargin" width="100%">
								<Label text="{i18n>segmentos.texto}" labelFor="texto" />
								<TextArea id="texto" value="{dados>/texto}" rows="12" width="100%" growing="false" class="codigo editor-de-segmento"
									liveChange=".aoEscrever" ariaDescribedBy="comoEscrever" />
								<Title text="{i18n>segmentos.comoEscrever}" level="H3" class="sapUiSmallMarginTop" />
								<FormattedText id="comoEscrever" htmlText="{i18n>segmentos.comoEscrever.html}" />
								<Text text="{i18n>segmentos.sujeitoFixo}" class="nota" visible="{= !!${dados>/sujeito_fixo} }" />
								<HBox alignItems="Center" renderType="Bare" class="sapUiSmallMarginTop">
									<Text text="{i18n>segmentos.glossario.antes}" class="sapUiTinyMarginEnd" />
									<Link text="{i18n>segmentos.glossario.link}" press=".abrirGlossario" />
								</HBox>
							</VBox>
						</f:content>
					</f:Card>
				</VBox>
				<VBox renderType="Bare" class="ficha-lateral">
					<f:Card class="sapUiSmallMarginBottom">
						<f:header><card:Header title="{i18n>conferencia.comoFica}" /></f:header>
						<f:content>
							<VBox id="leituraAoVivo" renderType="Bare" class="sapUiSmallMargin" width="100%">
								<Text text="{i18n>segmentos.comoFica.vazio}" visible="{= !${dados>/como_fica/escrito} }" />
								<VBox renderType="Bare" items="{path: 'dados>/como_fica/linhas', templateShareable: false}">
									<VBox renderType="Bare" class="sapUiTinyMarginBottom">
										<Text text="{dados>numero}. {dados>texto}" class="codigo" />
										<Text text="{dados>leitura}" visible="{= !!${dados>leitura} }" />
										<VBox renderType="Bare" items="{path: 'dados>erros', templateShareable: false}">
											<ObjectStatus text="{dados>}" state="Error" />
										</VBox>
									</VBox>
								</VBox>
								<Text text="{dados>/como_fica/leitura}" visible="{= !!${dados>/como_fica/leitura} }" class="sapUiSmallMarginTop leitura-do-segmento" />
								<ObjectStatus text="{dados>/como_fica/erros}" state="Error" visible="{= !!${dados>/como_fica/erros} }" class="sapUiSmallMarginTop" />
								<HBox renderType="Bare" class="sapUiSmallMarginTop">
									<Button text="{i18n>segmentos.conferir}" press=".conferir" enabled="{= ${dados>/conferir/estado} !== 'contando' }" />
								</HBox>
								<!-- Resultado do "Conferir" (R288, revisão 3). -->
								<HBox alignItems="Center" renderType="Bare" class="sapUiSmallMarginTop">
									<BusyIndicator size="1rem" visible="{= ${dados>/conferir/estado} === 'contando' }" class="sapUiTinyMarginEnd" />
									<Text text="{dados>/conferir/texto}" />
								</HBox>
								<MessageStrip text="{dados>/conferir/aviso}" type="Warning" showIcon="true" visible="{= !!${dados>/conferir/aviso} || ${dados>/conferir/estado} === 'tempo' }" class="sapUiSmallMarginTop" />
								<Table items="{path: 'dados>/conferir/condicoes', templateShareable: false}" fixedLayout="false" class="sapUiSmallMarginTop"
									headerText="{i18n>segmentos.cadaCondicao}" visible="{= (${dados>/conferir/condicoes} || []).length > 0 }">
									<columns><Column><Text text="{i18n>segmentos.condicao}" /></Column><Column hAlign="End"><Text text="{dados>/conferir/coluna}" /></Column></columns>
									<items><ColumnListItem><cells>
										<Text text="{dados>condicao}" class="codigo" />
										<ObjectStatus text="{dados>quantos}" state="{= ${dados>zera} ? 'Warning' : 'None' }" />
									</cells></ColumnListItem></items>
								</Table>
							</VBox>
						</f:content>
					</f:Card>
					<f:Card visible="{= !!${dados>/sujeito_fixo} }">
						<f:header><card:Header title="{i18n>segmentos.ondeEUsado}" /></f:header>
						<f:content>
							<VBox renderType="Bare" class="sapUiSmallMargin" width="100%">
								<VBox renderType="Bare" items="{path: 'dados>/usos', templateShareable: false}"><Text text="{dados>}" /></VBox>
								<Text text="{= ${dados>/usado} ? ${i18n>segmentos.uso.conferencia} : ${i18n>segmentos.uso.semUso} }" class="nota" />
							</VBox>
						</f:content>
					</f:Card>
				</VBox>
			</FlexBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
