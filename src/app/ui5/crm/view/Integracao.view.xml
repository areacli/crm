<mvc:View controllerName="crm.controller.Integracao" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form" height="100%">
	<!-- Página da integração (12, R259 a R269): os dados e os campos do manifesto do fornecedor (segredo e arquivo nunca voltam), a conexão, as ações que
	     valem (testar, ativar ou desativar, gerar segredo, excluir) e o histórico. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><HBox alignItems="Center" renderType="Bare"><Title text="{dados>/nome}" level="H2" class="sapUiSmallMarginEnd" />
				<ObjectStatus text="{dados>/situacao/texto}" state="{dados>/situacao/estado}" inverted="true" /></HBox></f:heading>
			<f:expandedContent><Text text="{dados>/subtitulo}" /></f:expandedContent>
			<f:actions>
				<Button text="{i18n>integracao.testar}" visible="{dados>/disponivel}" press=".testar" />
				<Button text="{i18n>integracao.ativar}" visible="{= !${dados>/ativa} }" press=".ativar" />
				<Button text="{i18n>integracao.desativar}" visible="{dados>/ativa}" press=".desativar" />
				<Button text="{i18n>integracao.gerarSegredo}" visible="{dados>/com_webhook}" press=".gerarSegredo" />
				<Button text="{i18n>acao.excluir}" visible="{dados>/pode_excluir}" press=".excluir" />
			</f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<MessageStrip text="{i18n>integracao.indisponivel}" type="Warning" showIcon="true" visible="{= !${dados>/disponivel} }" class="sapUiSmallMarginBottom" />
				<FlexBox wrap="Wrap" alignItems="Start" renderType="Bare" class="ficha">
					<f:Card class="ficha-principal">
						<f:header><card:Header title="{i18n>integracao.dados}">
							<card:toolbar><Button text="{i18n>acao.salvar}" type="Emphasized" press=".salvar" busy="{ui>/enviando}" /></card:toolbar>
						</card:Header></f:header>
						<f:content>
							<VBox renderType="Bare" width="100%">
								<form:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2" labelSpanL="12" labelSpanM="12" width="100%">
									<Label text="{i18n>integracao.apelido}" required="true" /><Input value="{dados>/apelido}" maxLength="100" />
									<Label text="{i18n>integracao.metodo}" required="true" />
									<Select selectedKey="{dados>/metodo_id}" items="{path: 'dados>/metodos', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
								</form:SimpleForm>
								<form:SimpleForm id="campos" editable="true" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2" labelSpanL="12" labelSpanM="12" width="100%" />
							</VBox>
						</f:content>
					</f:Card>
					<f:Card class="ficha-lateral">
						<f:header><card:Header title="{i18n>integracao.conexao}" /></f:header>
						<f:content>
							<VBox class="pares" width="100%" items="{path: 'dados>/conexao', templateShareable: false}" renderType="Bare">
								<VBox renderType="Bare" class="par"><Label text="{dados>rotulo}" /><Text text="{dados>valor}" /></VBox>
							</VBox>
						</f:content>
					</f:Card>
				</FlexBox>
				<f:Card class="sapUiSmallMarginTop">
					<f:header><card:Header title="{i18n>integracao.historico}" /></f:header>
					<f:content>
						<Table items="{path: 'dados>/historico', templateShareable: false}" fixedLayout="false" noData="{i18n>integracao.semHistorico}">
							<columns>
								<Column><Text text="{i18n>estornos.quando}" /></Column><Column><Text text="{i18n>estornos.quem}" /></Column><Column><Text text="{i18n>integracao.ato}" /></Column>
								<Column><Text text="{i18n>integracao.campo}" /></Column><Column><Text text="{i18n>integracao.antes}" /></Column><Column><Text text="{i18n>integracao.depois}" /></Column>
							</columns>
							<items><ColumnListItem><cells>
								<Text text="{dados>quando}" wrapping="false" /><Text text="{dados>quem}" /><Text text="{dados>ato}" /><Text text="{dados>campo}" /><Text text="{dados>antes}" /><Text text="{dados>depois}" />
							</cells></ColumnListItem></items>
						</Table>
					</f:content>
				</f:Card>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
