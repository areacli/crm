<mvc:View controllerName="crm.controller.Fila" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" height="100%">
	<!-- Uma fila (15, R357; modelo Lista): quem está nela, em ordem, com a situação; "Liberar" a entrega aberta. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false" fitContent="true">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{dados>/nome}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{dados>/ordem}" /></f:expandedContent>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<Table items="{dados>/linhas}" sticky="ColumnHeaders" fixedLayout="false" noData="{i18n>fila.vazia}">
					<columns>
						<Column hAlign="End" width="6rem"><Text text="{i18n>fila.posicao}" /></Column><Column><Text text="{dados>/coluna_do_sujeito}" /></Column>
						<Column><Text text="{i18n>importacoes.situacao}" /></Column><Column hAlign="End"><Text text="" /></Column>
					</columns>
					<items><ColumnListItem><cells>
						<Text text="{dados>posicao}" /><Text text="{dados>sujeito}" /><ObjectStatus text="{dados>situacao/texto}" state="{dados>situacao/estado}" inverted="true" />
						<Button text="{i18n>filas.liberar}" visible="{= !!${dados>entrega_id} }" press=".liberar" />
					</cells></ColumnListItem></items>
				</Table>
				<core:Fragment fragmentName="crm.fragment.Paginacao" type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
