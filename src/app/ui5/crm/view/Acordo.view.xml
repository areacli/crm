<mvc:View controllerName="crm.controller.Acordo" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" height="100%">
	<!-- Página do acordo (11, R216 a R239; modelo Ficha): situação, avisos, títulos e base, entrada e parcelas, títulos de acordo e de estorno,
	     histórico; na lateral, as condições, o aceite e as quitações. As ações seguem a regra de ação (modal pequeno; o aceite, no painel lateral). -->
	<f:FlexibleColumnLayout id="colunas" layout="OneColumn" backgroundDesign="Solid">
		<f:beginColumnPages>
			<f:DynamicPage toggleHeaderOnTitleClick="false">
				<f:title>
					<f:DynamicPageTitle>
						<f:heading>
							<HBox alignItems="Center" wrap="Wrap" renderType="Bare">
								<Title text="{parts: ['i18n>acordo.titulo', 'dados>/numero'], formatter: '.formatarTexto'}" level="H2" class="sapUiSmallMarginEnd" />
								<HBox items="{path: 'dados>/selos', templateShareable: false}" renderType="Bare"><ObjectStatus text="{dados>texto}" state="{dados>estado}" inverted="true" class="sapUiTinyMarginEnd" /></HBox>
							</HBox>
						</f:heading>
						<f:expandedContent>
							<HBox renderType="Bare"><Link text="{dados>/cliente}" press=".abrirFicha" class="sapUiTinyMarginEnd" /><Text text="· {dados>/credor}" /></HBox>
						</f:expandedContent>
						<f:actions>
							<Button text="{i18n>acordo.abrirTermo}" visible="{dados>/pode/termo}" press=".abrirTermo" />
							<Button text="{i18n>acordo.registrarAceite}" type="Emphasized" visible="{dados>/pode/aceitar}" press=".registrarAceite" />
							<Button text="{i18n>acordo.aprovar}" type="Emphasized" visible="{dados>/pode/aprovar}" press=".aprovar" />
							<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>acordo.maisAcoes}" press=".maisAcoes"
								visible="{= ${dados>/pode/recusar} || ${dados>/pode/cancelar} || ${dados>/pode/quitar} || ${dados>/pode/quebrar} || ${dados>/pode/reverter} || ${dados>/pode/concluir} }" />
						</f:actions>
					</f:DynamicPageTitle>
				</f:title>
				<f:content>
					<FlexBox wrap="Wrap" alignItems="Start" renderType="Bare" class="ficha">
						<VBox renderType="Bare" class="ficha-principal">
							<VBox items="{path: 'dados>/avisos', templateShareable: false}" renderType="Bare">
								<MessageStrip text="{dados>texto}" type="{= ${dados>estado} === 'Error' ? 'Error' : ${dados>estado} === 'Warning' ? 'Warning' : 'Information' }" showIcon="true" class="sapUiTinyMarginBottom" />
							</VBox>
							<f:Card class="sapUiSmallMarginBottom">
								<f:header><card:Header title="{i18n>acordo.titulosEBase}" /></f:header>
								<f:content>
									<Table fixedLayout="false" columns="{path: 'dados>/titulos/colunas', templateShareable: false}" items="{path: 'dados>/titulos/linhas', templateShareable: false}">
										<columns><Column hAlign="{= ${dados>numero} ? 'End' : 'Begin' }"><Text text="{dados>texto}" wrapping="false" /></Column></columns>
										<items><ColumnListItem cells="{path: 'dados>celulas', templateShareable: false}"><cells><Text text="{dados>}" wrapping="false" /></cells></ColumnListItem></items>
									</Table>
								</f:content>
							</f:Card>
							<f:Card class="sapUiSmallMarginBottom">
								<f:header><card:Header title="{i18n>acordo.entradaEParcelas}" /></f:header>
								<f:content>
									<Table fixedLayout="false" items="{dados>/parcelas}">
										<columns><Column><Text text="{i18n>acordo.tituloDeAcordo}" /></Column><Column><Text text="{i18n>ficha.vencimento}" /></Column>
											<Column hAlign="End"><Text text="{i18n>ficha.valor}" /></Column><Column hAlign="End"><Text text="{i18n>acordo.juros}" /></Column>
											<Column hAlign="End"><Text text="{i18n>acordo.amortizacao}" /></Column><Column hAlign="End"><Text text="{i18n>acordo.faltaAmortizar}" /></Column></columns>
										<items><ColumnListItem><cells><Text text="{dados>titulo}" /><Text text="{dados>vencimento}" /><Text text="{dados>valor}" wrapping="false" />
											<Text text="{dados>juros}" wrapping="false" /><Text text="{dados>amortizacao}" wrapping="false" /><Text text="{dados>falta}" wrapping="false" /></cells></ColumnListItem></items>
									</Table>
								</f:content>
							</f:Card>
							<f:Card class="sapUiSmallMarginBottom" visible="{= ${dados>/titulos_de_acordo}.length > 0 }">
								<f:header><card:Header title="{i18n>acordo.titulosDeAcordo}" subtitle="{dados>/ajuda_dos_titulos_de_acordo}" /></f:header>
								<f:content>
									<Table fixedLayout="false" items="{dados>/titulos_de_acordo}">
										<columns><Column><Text text="{i18n>ficha.titulo}" /></Column><Column><Text text="{i18n>ficha.vencimento}" /></Column><Column hAlign="End"><Text text="{i18n>ficha.valor}" /></Column>
											<Column hAlign="End"><Text text="{i18n>ficha.pago}" /></Column><Column hAlign="End"><Text text="{i18n>acordo.moraDeHoje}" /></Column>
											<Column hAlign="End"><Text text="{i18n>acordo.devidoHoje}" /></Column><Column><Text text="{i18n>ficha.situacao}" /></Column></columns>
										<items><ColumnListItem><cells><Link text="{dados>numero}" href="{dados>endereco}" /><Text text="{dados>vencimento}" /><Text text="{dados>valor}" wrapping="false" />
											<Text text="{dados>pago}" wrapping="false" /><Text text="{dados>mora}" wrapping="false" /><Text text="{dados>devido}" wrapping="false" />
											<ObjectStatus text="{dados>selo/texto}" state="{dados>selo/estado}" inverted="true" /></cells></ColumnListItem></items>
									</Table>
								</f:content>
							</f:Card>
							<f:Card class="sapUiSmallMarginBottom" visible="{= ${dados>/titulos_de_estorno}.length > 0 }">
								<f:header><card:Header title="{i18n>acordo.titulosDeEstorno}" subtitle="{i18n>acordo.titulosDeEstorno.ajuda}" /></f:header>
								<f:content>
									<Table fixedLayout="false" items="{dados>/titulos_de_estorno}">
										<columns><Column><Text text="{i18n>ficha.titulo}" /></Column><Column><Text text="{i18n>ficha.vencimento}" /></Column><Column hAlign="End"><Text text="{i18n>ficha.valor}" /></Column>
											<Column hAlign="End"><Text text="{i18n>ficha.pago}" /></Column><Column><Text text="{i18n>ficha.situacao}" /></Column></columns>
										<items><ColumnListItem><cells><Link text="{dados>numero}" href="{dados>endereco}" /><Text text="{dados>vencimento}" /><Text text="{dados>valor}" wrapping="false" />
											<Text text="{dados>pago}" wrapping="false" /><ObjectStatus text="{dados>selo/texto}" state="{dados>selo/estado}" inverted="true" /></cells></ColumnListItem></items>
									</Table>
								</f:content>
							</f:Card>
							<f:Card>
								<f:header><card:Header title="{i18n>ficha.aba.historico}" /></f:header>
								<f:content>
									<Table fixedLayout="false" items="{dados>/historico}">
										<columns><Column><Text text="{i18n>ficha.quando}" /></Column><Column><Text text="{i18n>ficha.oQueAconteceu}" /></Column><Column><Text text="{i18n>ficha.quem}" /></Column></columns>
										<items><ColumnListItem><cells><Text text="{dados>quando}" wrapping="false" /><Text text="{dados>evento}" /><Text text="{dados>quem}" /></cells></ColumnListItem></items>
									</Table>
								</f:content>
							</f:Card>
						</VBox>
						<VBox renderType="Bare" class="ficha-lateral" visible="{= !${ui>/painelAberto} }">
							<f:Card class="sapUiSmallMarginBottom">
								<f:header><card:Header title="{i18n>acordo.condicoes}" /></f:header>
								<f:content>
									<VBox class="pares" width="100%" renderType="Bare" items="{path: 'dados>/condicoes', templateShareable: false}">
										<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{dados>rotulo}" /><Text text="{dados>valor}" textAlign="End" /></HBox>
									</VBox>
								</f:content>
							</f:Card>
							<f:Card class="sapUiSmallMarginBottom" visible="{= ${dados>/aceite}.length > 0 }">
								<f:header><card:Header title="{i18n>acordo.aceiteRegistrado}" /></f:header>
								<f:content>
									<VBox class="pares" width="100%" renderType="Bare" items="{path: 'dados>/aceite', templateShareable: false}">
										<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{dados>rotulo}" /><Text text="{dados>valor}" textAlign="End" /></HBox>
									</VBox>
								</f:content>
							</f:Card>
							<f:Card visible="{= ${dados>/quitacoes}.length > 0 }">
								<f:header><card:Header title="{i18n>acordo.quitacoes}" /></f:header>
								<f:content>
									<VBox class="pares" width="100%" renderType="Bare" items="{path: 'dados>/quitacoes', templateShareable: false}"><Text text="{dados>}" class="par" /></VBox>
								</f:content>
							</f:Card>
						</VBox>
					</FlexBox>
				</f:content>
			</f:DynamicPage>
		</f:beginColumnPages>
	</f:FlexibleColumnLayout>
</mvc:View>
