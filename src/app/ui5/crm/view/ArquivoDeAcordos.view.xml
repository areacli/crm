<mvc:View controllerName="crm.controller.ArquivoDeAcordos" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" height="100%">
	<!-- Arquivo de acordos (11, R244): exportar (modal pequeno) e as exportações dos últimos 30 dias para baixar. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false" fitContent="true">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{i18n>arquivo.titulo}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{i18n>arquivo.subtitulo}" /></f:expandedContent>
			<f:actions><Button text="{i18n>arquivo.exportar}" type="Emphasized" press=".exportar" /></f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<MessageStrip type="Warning" showIcon="true" visible="{= ${dados>/pendencias}.length > 0 }" text="{i18n>arquivo.pendencias}" class="sapUiTinyMarginBottom" />
				<List items="{dados>/pendencias}" visible="{= ${dados>/pendencias}.length > 0 }" class="sapUiSmallMarginBottom">
					<StandardListItem type="Active" press=".abrirAcordo" title="{dados>titulo}" description="{dados>credor}, vence em {dados>vencimento}" />
				</List>
				<Table items="{dados>/exportacoes}" fixedLayout="false" headerText="{i18n>arquivo.exportacoes}" noData="{i18n>arquivo.vazio}">
					<columns><Column><Text text="{i18n>ficha.quando}" /></Column><Column><Text text="{i18n>clientes.credor}" /></Column><Column><Text text="{i18n>acordos.forma}" /></Column>
						<Column hAlign="End"><Text text="{i18n>arquivo.linhas}" /></Column><Column><Text text="{i18n>ficha.quem}" /></Column><Column><Text text="{i18n>arquivo.arquivo}" /></Column></columns>
					<items><ColumnListItem><cells>
						<Text text="{dados>quando}" wrapping="false" /><Text text="{dados>credor}" /><Text text="{dados>forma}" /><Text text="{dados>linhas}" /><Text text="{dados>quem}" />
						<HBox renderType="Bare"><Link text="{i18n>arquivo.baixar}" href="{dados>endereco}" visible="{= !!${dados>endereco} }" /><Text text="{i18n>arquivo.apagado}" visible="{= !${dados>endereco} }" /></HBox>
					</cells></ColumnListItem></items>
				</Table>
				<Text text="{i18n>arquivo.ajuda}" class="nota sapUiSmallMarginTop" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
