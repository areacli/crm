<mvc:View controllerName="crm.controller.Importacao" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" height="100%">
	<!-- Página da importação (R10, R56, R63): situação e andamento ao vivo, confirmar ou descartar a conferida, o resultado do tipo, as seções da carga de
	     carteira (contatos com aviso, mantidos pelo credor, divergências, acréscimos) e as linhas recusadas. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><HBox alignItems="Center" renderType="Bare"><Title text="{parts: ['i18n>importacao.titulo', 'dados>/recebida'], formatter: '.formatarTexto'}" level="H2" class="sapUiSmallMarginEnd" />
				<ObjectStatus text="{dados>/situacao/texto}" state="{dados>/situacao/estado}" inverted="true" /></HBox></f:heading>
			<f:expandedContent><Text text="{dados>/credor}" /></f:expandedContent>
			<f:actions>
				<Button text="{i18n>importacao.confirmar}" type="Emphasized" visible="{dados>/pode_confirmar}" press=".confirmar" />
				<Button text="{i18n>importacao.descartar}" type="Reject" visible="{dados>/pode_confirmar}" press=".descartar" />
			</f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<MessageStrip text="{i18n>importacao.nadaGravado}" type="Warning" showIcon="true" visible="{dados>/pode_confirmar}" class="sapUiSmallMarginBottom" />
				<MessageStrip text="{dados>/falha}" type="Error" showIcon="true" visible="{= !!${dados>/falha} }" class="sapUiSmallMarginBottom" />
				<FlexBox wrap="Wrap" alignItems="Start" renderType="Bare" class="ficha">
					<f:Card class="ficha-principal">
						<f:header><card:Header title="{i18n>importacoes.situacao}" /></f:header>
						<f:content>
							<VBox class="pares" width="100%" renderType="Bare">
								<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{i18n>importacoes.arquivo}" /><Text text="{dados>/arquivo}" textAlign="End" /></HBox>
								<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{i18n>importacoes.tipo}" /><Text text="{dados>/tipo}" textAlign="End" /></HBox>
								<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{i18n>importacoes.enviadaPor}" /><Text text="{dados>/enviada_por}" textAlign="End" /></HBox>
								<ProgressIndicator visible="{dados>/trabalhando}" percentValue="{dados>/percentual}" displayValue="{= ${dados>/percentual} + '%' + (${dados>/andamento} ? ' — ' + ${dados>/andamento} : '') }"
									showValue="true" state="Information" tooltip="{i18n>importacao.andamento}" />
							</VBox>
						</f:content>
					</f:Card>
					<f:Card class="ficha-principal" visible="{= !!${dados>/resultado} }">
						<f:header><card:Header title="{dados>/resultado/titulo}" /></f:header>
						<f:content>
							<VBox class="pares" width="100%" renderType="Bare">
								<VBox items="{path: 'dados>/resultado/pares', templateShareable: false}" renderType="Bare">
									<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{dados>rotulo}" />
										<VBox alignItems="End" renderType="Bare"><Text text="{dados>valor}" textAlign="End" /><Text text="{dados>detalhe}" visible="{= !!${dados>detalhe} }" textAlign="End" class="nota" /></VBox></HBox>
								</VBox>
								<VBox items="{path: 'dados>/resultado/notas', templateShareable: false}" renderType="Bare"><Text text="{dados>}" class="nota" /></VBox>
							</VBox>
						</f:content>
					</f:Card>
				</FlexBox>
				<f:Card visible="{= !!${dados>/avisos_de_contato} }" class="sapUiSmallMarginTop">
					<f:header><card:Header title="{dados>/avisos_de_contato/titulo}" subtitle="{dados>/avisos_de_contato/ajuda}" /></f:header>
					<f:content>
						<List items="{path: 'dados>/avisos_de_contato/linhas', templateShareable: false}" width="100%"><StandardListItem title="{dados>}" /></List>
					</f:content>
				</f:Card>
				<f:Card visible="{= !!${dados>/mantidos} }" class="sapUiSmallMarginTop">
					<f:header><card:Header title="{dados>/mantidos/titulo}" subtitle="{dados>/mantidos/ajuda}" /></f:header>
					<f:content>
						<Table items="{path: 'dados>/mantidos/linhas', templateShareable: false}" fixedLayout="false">
							<columns>
								<Column><Text text="{i18n>clientes.coluna.cliente}" /></Column><Column><Text text="{i18n>importacao.dado}" /></Column><Column><Text text="{i18n>importacao.hoje}" /></Column>
								<Column><Text text="{i18n>importacao.aCargaTraz}" /></Column><Column><Text text="{i18n>divergencias.efeito}" /></Column>
							</columns>
							<items><ColumnListItem><cells><Text text="{dados>cliente}" /><Text text="{dados>dado}" /><Text text="{dados>hoje}" /><Text text="{dados>carga}" /><Text text="{dados>efeito}" /></cells></ColumnListItem></items>
						</Table>
					</f:content>
				</f:Card>
				<f:Card visible="{= !!${dados>/divergencias} }" class="sapUiSmallMarginTop">
					<f:header><card:Header title="{dados>/divergencias/titulo}" subtitle="{dados>/divergencias/ajuda}" /></f:header>
					<f:content>
						<Table items="{path: 'dados>/divergencias/linhas', templateShareable: false}" fixedLayout="false">
							<columns>
								<Column><Text text="{i18n>titulo.titulo.coluna}" /></Column><Column><Text text="{i18n>clientes.coluna.cliente}" /></Column>
								<Column hAlign="End"><Text text="{i18n>importacao.valorVigente}" /></Column><Column hAlign="End"><Text text="{i18n>divergencias.informado}" /></Column>
								<Column hAlign="End"><Text text="{i18n>importacao.pago}" /></Column><Column hAlign="End"><Text text="{i18n>divergencias.saldoAntes}" /></Column>
								<Column hAlign="End"><Text text="{i18n>divergencias.saldoDepois}" /></Column><Column hAlign="End"><Text text="{i18n>importacao.excedente}" /></Column>
								<Column><Text text="{i18n>divergencias.efeito}" /></Column>
							</columns>
							<items><ColumnListItem><cells>
								<Text text="{dados>titulo}" wrapping="false" /><Text text="{dados>cliente}" /><Text text="{dados>vigente}" wrapping="false" /><Text text="{dados>informado}" wrapping="false" />
								<Text text="{dados>pago}" wrapping="false" /><Text text="{dados>saldo_antes}" wrapping="false" /><Text text="{dados>saldo_depois}" wrapping="false" />
								<Text text="{dados>excedente}" wrapping="false" /><Text text="{dados>efeito}" />
							</cells></ColumnListItem></items>
						</Table>
					</f:content>
				</f:Card>
				<f:Card visible="{= !!${dados>/acrescimos_informados} }" class="sapUiSmallMarginTop">
					<f:header><card:Header title="{i18n>importacao.acrescimos}" subtitle="{i18n>importacao.acrescimos.ajuda}" /></f:header>
					<f:content>
						<VBox class="pares" width="100%" items="{path: 'dados>/acrescimos_informados', templateShareable: false}" renderType="Bare">
							<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{dados>rotulo}" /><Text text="{dados>valor}" textAlign="End" /></HBox>
						</VBox>
					</f:content>
				</f:Card>
				<f:Card visible="{= !!${dados>/comparacao} }" class="sapUiSmallMarginTop">
					<f:header><card:Header title="{i18n>importacao.comparacao}" subtitle="{dados>/comparacao/ajuda}" /></f:header>
					<f:content>
						<VBox renderType="Bare" width="100%">
							<Table items="{path: 'dados>/comparacao/totais', templateShareable: false}" fixedLayout="false">
								<columns>
									<Column><Text text="{i18n>importacao.componente}" /></Column><Column hAlign="End"><Text text="{i18n>importacao.informadoPeloCredor}" /></Column>
									<Column hAlign="End"><Text text="{i18n>importacao.calculadoPeloCrm}" /></Column><Column hAlign="End"><Text text="{i18n>importacao.diferenca}" /></Column>
								</columns>
								<items><ColumnListItem><cells><Text text="{dados>componente}" /><Text text="{dados>informado}" wrapping="false" /><Text text="{dados>calculado}" wrapping="false" /><Text text="{dados>diferenca}" wrapping="false" /></cells></ColumnListItem></items>
							</Table>
							<Text text="{dados>/comparacao/legenda}" visible="{= !!${dados>/comparacao/legenda} }" class="nota sapUiSmallMargin" />
							<Table items="{path: 'dados>/comparacao/maiores', templateShareable: false}" fixedLayout="false" visible="{= !!${dados>/comparacao/legenda} }">
								<columns>
									<Column><Text text="{i18n>titulo.titulo.coluna}" /></Column><Column hAlign="End" visible="{= !!${dados>/comparacao/com_linha} }"><Text text="{i18n>importacao.linha}" /></Column>
									<Column hAlign="End"><Text text="{i18n>divergencias.informado}" /></Column><Column hAlign="End"><Text text="{i18n>importacao.calculado}" /></Column>
									<Column hAlign="End"><Text text="{i18n>importacao.diferenca}" /></Column>
								</columns>
								<items><ColumnListItem><cells><Text text="{dados>titulo}" wrapping="false" /><Text text="{dados>linha}" /><Text text="{dados>informado}" wrapping="false" />
									<Text text="{dados>calculado}" wrapping="false" /><Text text="{dados>diferenca}" wrapping="false" /></cells></ColumnListItem></items>
							</Table>
						</VBox>
					</f:content>
				</f:Card>
				<f:Card visible="{= !!${dados>/recusadas} }" class="sapUiSmallMarginTop">
					<f:header><card:Header title="{dados>/recusadas/titulo}" subtitle="{dados>/recusadas/ajuda}" /></f:header>
					<f:content>
						<Table items="{path: 'dados>/recusadas/linhas', templateShareable: false}" fixedLayout="false">
							<columns><Column hAlign="End" width="6rem"><Text text="{i18n>importacao.linha}" /></Column><Column><Text text="{i18n>estornos.motivo}" /></Column></columns>
							<items><ColumnListItem><cells><Text text="{dados>linha}" /><Text text="{dados>motivo}" /></cells></ColumnListItem></items>
						</Table>
					</f:content>
				</f:Card>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
