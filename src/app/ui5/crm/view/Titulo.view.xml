<mvc:View controllerName="crm.controller.Titulo" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" height="100%">
	<!-- Página do título (R100; 09, R174): situação e valores, a cobrança que o prende, a memória de cálculo, as versões do valor e a linha do tempo. Só leitura. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><HBox alignItems="Center" renderType="Bare"><Title text="{parts: ['i18n>titulo.titulo', 'dados>/numero'], formatter: '.formatarTexto'}" level="H2" class="sapUiSmallMarginEnd" />
				<ObjectStatus text="{dados>/selo/texto}" state="{dados>/selo/estado}" inverted="true" /></HBox></f:heading>
			<f:expandedContent><HBox renderType="Bare"><Link text="{dados>/cliente}" press=".abrirFicha" class="sapUiTinyMarginEnd" /><Text text="· {dados>/credor}" /></HBox></f:expandedContent>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<FlexBox renderType="Bare" class="grade-de-indicadores" items="{path: 'dados>/indicadores', templateShareable: false}">
					<core:Fragment fragmentName="crm.fragment.Indicador" type="XML" />
				</FlexBox>
				<f:Card visible="{= ${dados>/notas}.length > 0 || ${dados>/composicao}.length > 0 }" class="sapUiSmallMarginTop">
					<f:header><card:Header title="{i18n>titulo.naCobranca}" /></f:header>
					<f:content>
						<VBox class="pares" width="100%" renderType="Bare">
							<VBox items="{path: 'dados>/notas', templateShareable: false}" renderType="Bare">
								<HBox renderType="Bare" class="par"><Text text="{dados>texto}" class="sapUiTinyMarginEnd" /><Link text="{dados>acordo}" visible="{= !!${dados>acordo_id} }" press=".abrirAcordo" /></HBox>
							</VBox>
							<VBox items="{path: 'dados>/composicao', templateShareable: false}" renderType="Bare">
								<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{dados>rotulo}" /><Text text="{dados>valor}" textAlign="End" /></HBox>
							</VBox>
							<Text text="{dados>/nota_da_composicao}" visible="{= !!${dados>/nota_da_composicao} }" class="nota" />
						</VBox>
					</f:content>
				</f:Card>
				<f:Card visible="{= !!${dados>/memoria} }" class="sapUiSmallMarginTop">
					<f:header><card:Header title="{i18n>titulo.memoria}" subtitle="{dados>/memoria/legenda}" /></f:header>
					<f:content>
						<VBox renderType="Bare" width="100%">
							<Table items="{path: 'dados>/memoria/periodos', templateShareable: false}" fixedLayout="false">
								<columns>
									<Column><Text text="{i18n>titulo.memoria.periodo}" /></Column><Column hAlign="End"><Text text="{i18n>titulo.memoria.dias}" /></Column>
									<Column><Text text="{i18n>titulo.memoria.enquadramento}" /></Column><Column><Text text="{i18n>titulo.memoria.correcao}" /></Column>
									<Column hAlign="End"><Text text="{i18n>titulo.memoria.fator}" /></Column><Column><Text text="{i18n>titulo.memoria.juros}" /></Column>
									<Column hAlign="End"><Text text="{i18n>titulo.memoria.taxa}" /></Column><Column hAlign="End"><Text text="{i18n>titulo.memoria.meses}" /></Column>
									<Column hAlign="End"><Text text="{i18n>titulo.memoria.base}" /></Column><Column hAlign="End"><Text text="{i18n>titulo.memoria.jurosDoPeriodo}" /></Column>
								</columns>
								<items><ColumnListItem><cells>
									<Text text="{dados>periodo}" wrapping="false" /><Text text="{dados>dias}" /><Text text="{dados>enquadramento}" /><Text text="{dados>correcao}" />
									<Text text="{dados>fator}" /><Text text="{dados>juros}" /><Text text="{dados>taxa}" wrapping="false" /><Text text="{dados>meses}" />
									<Text text="{dados>base}" wrapping="false" /><Text text="{dados>juros_do_periodo}" wrapping="false" />
								</cells></ColumnListItem></items>
							</Table>
							<VBox items="{path: 'dados>/memoria/observacoes', templateShareable: false}" renderType="Bare" class="sapUiSmallMargin"><Text text="{dados>}" class="nota" /></VBox>
							<Link text="{i18n>titulo.memoria.verIndices}" visible="{= !!${dados>/memoria/pode_ver_indices} }" href="/configuracao/indices" class="sapUiSmallMargin" />
						</VBox>
					</f:content>
				</f:Card>
				<FlexBox wrap="Wrap" alignItems="Start" renderType="Bare" class="ficha sapUiSmallMarginTop">
					<f:Card class="ficha-principal">
						<f:header><card:Header title="{i18n>titulo.versoes}" subtitle="{i18n>titulo.versoes.ajuda}" /></f:header>
						<f:content>
							<Table items="{path: 'dados>/versoes', templateShareable: false}" fixedLayout="false">
								<columns>
									<Column><Text text="{i18n>titulo.versao}" /></Column><Column hAlign="End"><Text text="{i18n>titulo.valor}" /></Column><Column><Text text="{i18n>titulo.data}" /></Column>
									<Column><Text text="{i18n>titulo.importacao}" /></Column><Column><Text text="{i18n>titulo.confirmadaPor}" /></Column>
								</columns>
								<items><ColumnListItem><cells>
									<Text text="{dados>versao}" wrapping="false" /><Text text="{dados>valor}" wrapping="false" /><Text text="{dados>data}" wrapping="false" />
									<Text text="{dados>importacao}" /><Text text="{dados>confirmada_por}" />
								</cells></ColumnListItem></items>
							</Table>
						</f:content>
					</f:Card>
					<f:Card class="ficha-principal">
						<f:header><card:Header title="{i18n>titulo.linhaDoTempo}" subtitle="{i18n>titulo.linhaDoTempo.ajuda}" /></f:header>
						<f:content>
							<Table items="{path: 'dados>/eventos', templateShareable: false}" fixedLayout="false">
								<columns><Column><Text text="{i18n>titulo.data}" /></Column><Column><Text text="{i18n>titulo.oQueAconteceu}" /></Column><Column hAlign="End"><Text text="{i18n>titulo.valor}" /></Column></columns>
								<items><ColumnListItem><cells><Text text="{dados>data}" wrapping="false" /><Text text="{dados>texto}" /><Text text="{dados>valor}" wrapping="false" /></cells></ColumnListItem></items>
							</Table>
						</f:content>
					</f:Card>
				</FlexBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
