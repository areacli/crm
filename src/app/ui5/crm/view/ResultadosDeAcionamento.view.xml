<mvc:View controllerName="crm.controller.ResultadosDeAcionamento" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" height="100%">
	<!-- Resultados de acionamento (R66, R67; modelo Configuração): a lista de cada credor na ordem dele; criar e editar no painel lateral; mover para cima
	     ou para baixo, desativar e reativar pelo menu da linha. O tipo não muda depois de criado; o resultado usado não se apaga, só se desativa. -->
	<f:FlexibleColumnLayout id="colunas" layout="OneColumn" backgroundDesign="Solid">
		<f:beginColumnPages>
			<f:DynamicPage toggleHeaderOnTitleClick="false">
				<f:title><f:DynamicPageTitle>
					<f:heading><Title text="{i18n>resultados.titulo}" level="H2" /></f:heading>
					<f:expandedContent><Text text="{i18n>resultados.subtitulo}" /></f:expandedContent>
					<f:actions><Button text="{i18n>resultados.criar}" type="Emphasized" press=".criar" enabled="{= ${dados>/credores}.length > 0 }" /></f:actions>
				</f:DynamicPageTitle></f:title>
				<f:content>
					<VBox items="{path: 'dados>/grupos', templateShareable: false}" renderType="Bare">
						<f:Card class="sapUiSmallMarginBottom">
							<f:header><card:Header title="{dados>nome}" subtitle="{i18n>resultados.ajuda}" /></f:header>
							<f:content>
								<Table items="{path: 'dados>resultados', templateShareable: false}" fixedLayout="false" noData="{i18n>resultados.vazio}">
									<columns>
										<Column><Text text="{i18n>resultados.resultado}" /></Column><Column><Text text="{i18n>resultados.tipo}" /></Column>
										<Column><Text text="{i18n>resultados.retorno}" /></Column><Column><Text text="{i18n>resultados.invalida}" /></Column>
										<Column><Text text="{i18n>resultados.admitePromessa}" /></Column><Column hAlign="End"><Text text="{i18n>resultados.acionamentos}" /></Column>
										<Column><Text text="{i18n>resultados.situacao}" /></Column><Column hAlign="End"><Text text="" /></Column>
									</columns>
									<items><ColumnListItem><cells>
										<Link text="{dados>nome}" press=".editarDaLinha" wrapping="false" />
										<Text text="{dados>tipo}" wrapping="false" /><Text text="{dados>retorno}" wrapping="false" />
										<Text text="{dados>invalida_texto}" wrapping="false" /><Text text="{dados>admite_promessa_texto}" wrapping="false" />
										<Text text="{dados>acionamentos}" wrapping="false" />
										<ObjectStatus text="{dados>situacao/texto}" state="{dados>situacao/estado}" inverted="true" />
										<Button icon="sap-icon://overflow" type="Transparent" tooltip="{parts: ['i18n>resultados.acoesDe', 'dados>nome'], formatter: '.formatarTexto'}" press=".acoes" />
									</cells></ColumnListItem></items>
								</Table>
							</f:content>
						</f:Card>
					</VBox>
				</f:content>
			</f:DynamicPage>
		</f:beginColumnPages>
	</f:FlexibleColumnLayout>
</mvc:View>
