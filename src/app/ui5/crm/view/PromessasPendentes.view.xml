<mvc:View controllerName="crm.controller.PromessasPendentes" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" height="100%">
	<!-- Promessas pendentes (10, R192, R204; modelo Lista): as que a pessoa pode aprovar; a que ela registrou espera outra pessoa. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{i18n>pendentes.promessas.titulo}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{i18n>pendentes.promessas.subtitulo}" /></f:expandedContent>
		</f:DynamicPageTitle></f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false" visible="{dados>/varios_credores}">
				<VBox><Label text="{i18n>clientes.credor}" labelFor="credor" />
					<Select id="credor" selectedKey="{filtro>/tenant}" change=".buscar" items="{path: 'dados>/credores', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox renderType="Bare">
			<Table items="{dados>/linhas}" sticky="ColumnHeaders" fixedLayout="false" noData="{i18n>pendentes.promessas.vazio}">
				<columns>
					<Column visible="{dados>/varios_credores}"><Text text="{i18n>clientes.credor}" /></Column>
					<Column><Text text="{i18n>pendentes.promessas.cliente}" /></Column><Column><Text text="{i18n>ficha.contrato}" /></Column>
					<Column><Text text="{i18n>ficha.aba.titulos}" /></Column><Column hAlign="End"><Text text="{i18n>ficha.valor}" /></Column>
					<Column><Text text="{i18n>promessa.meio}" /></Column><Column><Text text="{i18n>promessa.data}" /></Column>
					<Column hAlign="End"><Text text="{i18n>pendentes.promessas.prazo}" /></Column><Column><Text text="{i18n>pendentes.promessas.registradaPor}" /></Column>
					<Column hAlign="End"><Text text="" /></Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{dados>credor}" wrapping="false" /><Link text="{dados>cliente}" press=".abrirFicha" /><Text text="{dados>contrato}" wrapping="false" />
							<Text text="{dados>titulos}" /><Text text="{dados>valor}" wrapping="false" /><Text text="{dados>meio}" wrapping="false" /><Text text="{dados>data}" wrapping="false" />
							<Text text="{dados>prazo}" wrapping="false" /><Text text="{dados>registrada_por}" wrapping="false" />
							<HBox justifyContent="End" renderType="Bare">
								<Button text="{i18n>pendentes.aprovar}" press=".aprovar" class="sapUiTinyMarginEnd" />
								<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>lista.acoes}" press=".acoes" />
							</HBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
			<core:Fragment fragmentName="crm.fragment.Paginacao" type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
