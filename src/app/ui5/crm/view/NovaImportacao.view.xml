<mvc:View controllerName="crm.controller.NovaImportacao" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified" height="100%">
	<!-- Envio de arquivo (R10, R44, R56; modelo Entrada): credor, arquivo e, na carteira, o modo; ao lado, as colunas da planilha. Enviar abre a página da
	     importação, onde a conferência corre ao vivo. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{dados>/titulo}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{i18n>importacao.nova.subtitulo}" /></f:expandedContent>
			<f:actions><Button text="{i18n>importacao.modelo}" icon="sap-icon://download" press=".baixarModelo" /></f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<MessageStrip text="{i18n>importacao.nova.demonstracao}" type="Warning" showIcon="true" visible="{dados>/demonstracao}" class="sapUiSmallMarginBottom" />
				<FlexBox wrap="Wrap" alignItems="Start" renderType="Bare" class="ficha">
					<f:Card class="ficha-lateral">
						<f:header><card:Header title="{i18n>importacoes.arquivo}" /></f:header>
						<f:content>
							<VBox renderType="Bare" class="sapUiSmallMargin" width="100%">
								<MessageStrip text="{ui>/erro}" type="Error" showIcon="true" visible="{= !!${ui>/erro} }" class="sapUiSmallMarginBottom" />
								<Label text="{i18n>clientes.credor}" labelFor="credor" required="true" visible="{= ${dados>/credores}.length > 1 }" />
								<Select id="credor" width="100%" selectedKey="{ui>/credor}" visible="{= ${dados>/credores}.length > 1 }" items="{path: 'dados>/credores', templateShareable: false}">
									<core:Item key="{dados>id}" text="{dados>nome}" /></Select>
								<Text text="{dados>/credores/0/nome}" visible="{= ${dados>/credores}.length === 1 }" class="sapUiTinyMarginBottom" />
								<Label text="{i18n>importacao.nova.arquivo}" labelFor="arquivo" required="true" class="sapUiSmallMarginTop" />
								<u:FileUploader id="arquivo" width="100%" fileType="csv" mimeType="text/csv" change=".escolherArquivo" buttonText="{i18n>importacao.nova.escolher}"
									placeholder="{i18n>importacao.nova.nenhum}" />
								<Text text="{parts: ['i18n>importacao.nova.limites', 'dados>/obrigatorias'], formatter: '.formatarTexto'}" class="nota" />
								<Label text="{i18n>importacoes.modo}" visible="{dados>/com_modo}" class="sapUiSmallMarginTop" />
								<RadioButtonGroup visible="{dados>/com_modo}" selectedIndex="{ui>/modo}">
									<RadioButton text="{i18n>importacao.nova.incremental}" /><RadioButton text="{i18n>importacao.nova.completa}" />
								</RadioButtonGroup>
								<Button text="{i18n>importacao.nova.enviar}" type="Emphasized" press=".enviar" enabled="{= !!${ui>/temArquivo} }" busy="{ui>/enviando}" class="sapUiSmallMarginTop" />
							</VBox>
						</f:content>
					</f:Card>
					<f:Card class="ficha-principal">
						<f:header><card:Header title="{i18n>importacao.nova.colunas}" subtitle="{dados>/ajuda_das_colunas}" /></f:header>
						<f:content>
							<Table items="{path: 'dados>/colunas', templateShareable: false}" fixedLayout="false">
								<columns><Column><Text text="{i18n>importacao.nova.coluna}" /></Column><Column><Text text="{i18n>importacao.nova.obrigatoria}" /></Column>
									<Column><Text text="{i18n>importacao.nova.formato}" /></Column><Column><Text text="{i18n>importacao.nova.exemplo}" /></Column></columns>
								<items><ColumnListItem><cells><Text text="{dados>nome}" class="codigo" wrapping="false" /><Text text="{dados>obrigatoria}" /><Text text="{dados>formato}" /><Text text="{dados>exemplo}" /></cells></ColumnListItem></items>
							</Table>
						</f:content>
					</f:Card>
				</FlexBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
