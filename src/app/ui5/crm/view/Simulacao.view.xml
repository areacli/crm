<mvc:View controllerName="crm.controller.Simulacao" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" height="100%">
	<!-- Simular acordo (11, R211 a R218; fluxo rico, aba própria): títulos e termos à esquerda, o resultado ao lado, refeito a cada mudança;
	     "Criar proposta" grava e abre o acordo numa aba. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{i18n>simulacao.titulo}" level="H2" /></f:heading>
			<f:expandedContent><HBox renderType="Bare"><Link text="{form>/cliente}" press=".abrirFicha" class="sapUiTinyMarginEnd" /><Text text="· {form>/credor}" /></HBox></f:expandedContent>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<FlexBox wrap="Wrap" alignItems="Start" renderType="Bare" class="ficha simulacao">
				<VBox renderType="Bare" class="simulacao-formulario">
					<MessageStrip text="{ui>/erroDaProposta}" type="Error" showIcon="true" visible="{= !!${ui>/erroDaProposta} }" class="sapUiSmallMarginBottom" />
					<f:Card class="sapUiSmallMarginBottom">
						<f:header><card:Header title="{i18n>simulacao.titulos}" subtitle="{i18n>simulacao.titulos.ajuda}" /></f:header>
						<f:content>
							<VBox renderType="Bare" width="100%">
								<Table items="{form>/titulos}" fixedLayout="false" noData="{i18n>simulacao.semTitulos}">
									<columns><Column width="3rem"><Text text="" /></Column><Column><Text text="{i18n>ficha.titulo}" /></Column><Column><Text text="{i18n>ficha.contrato}" /></Column>
										<Column><Text text="{i18n>ficha.vencimento}" /></Column><Column hAlign="End"><Text text="{i18n>ficha.saldo}" /></Column><Column><Text text="{i18n>ficha.situacao}" /></Column></columns>
									<items>
										<ColumnListItem>
											<cells>
												<CheckBox selected="{form>escolhido}" enabled="{= !${form>bloqueado} }" select=".simularDepois" ariaLabelledBy="rotuloDosTitulos" />
												<VBox renderType="Bare"><Text text="{form>numero}" /><Text text="{form>detalhe}" visible="{= !!${form>detalhe} }" class="nota" /></VBox>
												<Text text="{form>contrato}" wrapping="false" /><Text text="{form>vencimento}" wrapping="false" /><Text text="{form>saldo}" wrapping="false" />
												<ObjectStatus text="{form>selo/texto}" state="{form>selo/estado}" inverted="true" />
											</cells>
										</ColumnListItem>
									</items>
								</Table>
								<core:InvisibleText id="rotuloDosTitulos" text="{i18n>simulacao.incluirTitulo}" />
								<CheckBox text="{i18n>simulacao.substituir}" selected="{valores>/replace}" visible="{form>/pode_substituir}" select=".simularDepois" class="sapUiSmallMarginBegin" />
								<Text text="{i18n>simulacao.substituir.ajuda}" visible="{form>/pode_substituir}" class="nota sapUiSmallMarginBeginEnd sapUiSmallMarginBottom" />
							</VBox>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="{i18n>simulacao.termos}" subtitle="{i18n>simulacao.termos.ajuda}" /></f:header>
						<f:content>
							<VBox renderType="Bare" width="100%" class="sapUiSmallMargin">
								<Label text="{i18n>acordos.forma}" />
								<RadioButtonGroup columns="2" selectedIndex="{= ${valores>/mode} === 'cash' ? 1 : 0 }" select=".mudarForma">
									<RadioButton text="{i18n>simulacao.parcelado}" /><RadioButton text="{i18n>simulacao.aVista}" />
								</RadioButtonGroup>
								<FlexBox wrap="Wrap" renderType="Bare" class="filtros" items="{path: 'form>/componentes', templateShareable: false}">
									<VBox renderType="Bare"><Label text="{form>nome}" /><Input value="{form>valor}" width="10rem" inputMode="Decimal" change=".simularDepois"
										valueState="{= ${ui>/campo} === 'discounts_' + ${form>id} ? 'Error' : 'None' }" valueStateText="{ui>/problema}" /></VBox>
								</FlexBox>
								<FlexBox wrap="Wrap" renderType="Bare" class="filtros sapUiSmallMarginTop">
									<VBox renderType="Bare"><Label text="{i18n>simulacao.entrada}" labelFor="entrada" /><Input id="entrada" value="{valores>/down_payment}" width="10rem" inputMode="Decimal" change=".simularDepois"
										valueState="{= ${ui>/campo} === 'down_payment' ? 'Error' : 'None' }" valueStateText="{ui>/problema}" /></VBox>
									<VBox renderType="Bare"><Label text="{i18n>simulacao.vencimentoDaEntrada}" labelFor="vencimentoDaEntrada" /><DatePicker id="vencimentoDaEntrada" value="{valores>/down_payment_on}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" width="10rem" change=".simularDepois"
										valueState="{= ${ui>/campo} === 'down_payment_on' ? 'Error' : 'None' }" valueStateText="{ui>/problema}" /></VBox>
									<VBox renderType="Bare"><Label text="{i18n>ficha.acordos.parcelas}" labelFor="parcelas" /><StepInput id="parcelas" value="{valores>/installments}" min="1" max="120" width="8rem" change=".simularDepois" /></VBox>
									<VBox renderType="Bare"><Label text="{i18n>simulacao.dia}" labelFor="dia" /><StepInput id="dia" value="{valores>/day}" min="1" max="28" width="8rem" change=".simularDepois" /></VBox>
								</FlexBox>
								<Text text="{i18n>simulacao.entrada.ajuda}" class="nota" />
								<VBox renderType="Bare" visible="{= !!${form>/credito} }" class="sapUiSmallMarginTop">
									<Label text="{i18n>simulacao.credito}" labelFor="credito" /><Input id="credito" value="{valores>/credit}" width="10rem" inputMode="Decimal" change=".simularDepois"
										valueState="{= ${ui>/campo} === 'credit' ? 'Error' : 'None' }" valueStateText="{ui>/problema}" />
									<Text text="{form>/credito}" class="nota" />
								</VBox>
								<MessageStrip text="{ui>/problema}" type="Error" showIcon="true" visible="{= ${ui>/campo} === 'mode' || ${ui>/campo} === 'bill_ids' }" class="sapUiSmallMarginTop" />
								<HBox justifyContent="End" class="sapUiSmallMarginTop" renderType="Bare">
									<Button text="{i18n>simulacao.simular}" press=".simular" class="sapUiTinyMarginEnd" />
									<Button id="criarProposta" text="{i18n>simulacao.criarProposta}" type="Emphasized" press=".criarProposta" />
								</HBox>
							</VBox>
						</f:content>
					</f:Card>
				</VBox>
				<VBox renderType="Bare" class="simulacao-resultado">
					<MessageStrip text="{i18n>simulacao.vazio}" type="Information" visible="{= !${resultado>/base} &amp;&amp; !${resultado>/problema} }" />
					<MessageStrip text="{resultado>/problema}" type="Warning" showIcon="true" visible="{= !${resultado>/base} &amp;&amp; !!${resultado>/problema} }" />
					<VBox items="{path: 'resultado>/avisos', templateShareable: false}" renderType="Bare">
						<MessageStrip text="{resultado>texto}" type="{= ${resultado>estado} === 'Error' ? 'Error' : ${resultado>estado} === 'Warning' ? 'Warning' : 'Information' }" showIcon="true" class="sapUiTinyMarginBottom" />
					</VBox>
					<f:Card class="sapUiSmallMarginBottom" visible="{= !!${resultado>/base} }">
						<f:header><card:Header title="{i18n>simulacao.baseEDescontos}" subtitle="{resultado>/desconto}" /></f:header>
						<f:content>
							<Table fixedLayout="false" columns="{path: 'resultado>/base/colunas', templateShareable: false}" items="{path: 'resultado>/base/linhas', templateShareable: false}">
								<columns><Column hAlign="{= ${resultado>numero} ? 'End' : 'Begin' }"><Text text="{resultado>texto}" wrapping="false" /></Column></columns>
								<items><ColumnListItem cells="{path: 'resultado>celulas', templateShareable: false}"><cells><Text text="{resultado>}" wrapping="false" /></cells></ColumnListItem></items>
							</Table>
						</f:content>
					</f:Card>
					<f:Card visible="{= !!${resultado>/base} }">
						<f:header><card:Header title="{i18n>acordo.entradaEParcelas}" /></f:header>
						<f:content>
							<VBox renderType="Bare" width="100%">
								<VBox class="pares" width="100%" renderType="Bare" items="{path: 'resultado>/valores', templateShareable: false}">
									<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{resultado>rotulo}" /><Text text="{resultado>valor}" textAlign="End" /></HBox>
								</VBox>
								<Table fixedLayout="false" items="{resultado>/parcelas}">
									<columns><Column><Text text="{i18n>acordo.tituloDeAcordo}" /></Column><Column><Text text="{i18n>ficha.vencimento}" /></Column><Column hAlign="End"><Text text="{i18n>ficha.valor}" /></Column>
										<Column hAlign="End"><Text text="{i18n>acordo.juros}" /></Column><Column hAlign="End"><Text text="{i18n>acordo.amortizacao}" /></Column><Column hAlign="End"><Text text="{i18n>acordo.faltaAmortizar}" /></Column></columns>
									<items><ColumnListItem><cells><Text text="{resultado>titulo}" /><Text text="{resultado>vencimento}" /><Text text="{resultado>valor}" wrapping="false" />
										<Text text="{resultado>juros}" wrapping="false" /><Text text="{resultado>amortizacao}" wrapping="false" /><Text text="{resultado>falta}" wrapping="false" /></cells></ColumnListItem></items>
								</Table>
							</VBox>
						</f:content>
					</f:Card>
				</VBox>
			</FlexBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
