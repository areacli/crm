<mvc:View controllerName="crm.controller.Usuario" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" height="100%">
	<!-- Ficha do usuário (R36 a R42; modelo Ficha): o histórico de acessos e alterações; na lateral, o acesso no credor. As ações não valem para a
	     própria conta. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><HBox alignItems="Center" renderType="Bare"><Title text="{dados>/nome}" level="H2" class="sapUiSmallMarginEnd" />
				<ObjectStatus text="{dados>/situacao/texto}" state="{dados>/situacao/estado}" inverted="true" /></HBox></f:heading>
			<f:expandedContent><Text text="{dados>/subtitulo}" /></f:expandedContent>
			<f:actions>
				<Button text="{i18n>usuarios.editarPerfil}" type="Emphasized" visible="{= !${dados>/proprio} }" press=".editarPerfil" />
				<Button text="{i18n>usuarios.desativar}" visible="{= !${dados>/proprio} &amp;&amp; ${dados>/ativo} }" press=".desativar" />
				<Button text="{i18n>usuarios.reativar}" visible="{= !${dados>/proprio} &amp;&amp; !${dados>/ativo} }" press=".reativar" />
				<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>usuarios.maisAcoes}" visible="{dados>/pode_editar_dados}" press=".maisAcoes" />
			</f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<FlexBox wrap="Wrap" alignItems="Start" renderType="Bare" class="ficha">
				<f:Card class="ficha-principal">
					<f:header><card:Header title="{i18n>usuario.historico}" /></f:header>
					<f:content>
						<Table items="{path: 'dados>/historico', templateShareable: false}" fixedLayout="false" noData="{i18n>usuario.semHistorico}">
							<columns><Column><Text text="{i18n>estornos.quando}" /></Column><Column><Text text="{i18n>titulo.oQueAconteceu}" /></Column><Column><Text text="{i18n>usuario.porQuem}" /></Column>
								<Column><Text text="{i18n>usuario.endereco}" /></Column></columns>
							<items><ColumnListItem><cells><Text text="{dados>quando}" wrapping="false" /><Text text="{dados>texto}" /><Text text="{dados>quem}" /><Text text="{dados>endereco}" /></cells></ColumnListItem></items>
						</Table>
					</f:content>
				</f:Card>
				<f:Card class="ficha-lateral">
					<f:header><card:Header title="{parts: ['i18n>usuario.acessoEm', 'dados>/credor'], formatter: '.formatarTexto'}" /></f:header>
					<f:content>
						<VBox class="pares" width="100%" renderType="Bare">
							<VBox items="{path: 'dados>/acesso', templateShareable: false}" renderType="Bare">
								<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{dados>rotulo}" /><Text text="{dados>valor}" textAlign="End" /></HBox>
							</VBox>
							<Text text="{dados>/nota_do_acesso}" visible="{= !!${dados>/nota_do_acesso} }" class="nota" />
						</VBox>
					</f:content>
				</f:Card>
			</FlexBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
