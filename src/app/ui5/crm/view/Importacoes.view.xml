<mvc:View controllerName="crm.controller.Importacoes" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" height="100%">
	<!-- Importações (R10, R56; modelo Lista): as cargas de carteira, pagamentos e estornos, com a situação ao vivo; importar abre a tela do envio numa aba. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false" fitContent="true">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{i18n>importacoes.titulo}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{i18n>importacoes.subtitulo}" /></f:expandedContent>
			<f:actions>
				<Button text="{i18n>importacoes.carteira}" type="Emphasized" visible="{= ${dados>/pode_importar}.indexOf('portfolio') >= 0 }" press=".importar" app:tipo="portfolio" />
				<Button text="{i18n>importacoes.pagamentos}" visible="{= ${dados>/pode_importar}.indexOf('payments') >= 0 }" press=".importar" app:tipo="payments" />
				<Button text="{i18n>importacoes.estornos}" visible="{= ${dados>/pode_importar}.indexOf('reversals') >= 0 }" press=".importar" app:tipo="reversals" />
			</f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<Table items="{dados>/linhas}" sticky="ColumnHeaders" fixedLayout="false" noData="{i18n>importacoes.vazio}">
					<columns>
						<Column><Text text="{i18n>importacoes.recebida}" /></Column><Column><Text text="{i18n>clientes.credor}" /></Column><Column><Text text="{i18n>importacoes.tipo}" /></Column>
						<Column><Text text="{i18n>importacoes.arquivo}" /></Column><Column><Text text="{i18n>importacoes.modo}" /></Column><Column><Text text="{i18n>importacoes.enviadaPor}" /></Column>
						<Column><Text text="{i18n>importacoes.situacao}" /></Column><Column hAlign="End"><Text text="" /></Column>
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<Link text="{dados>recebida}" press=".abrir" wrapping="false" /><Text text="{dados>credor}" wrapping="false" /><Text text="{dados>tipo}" wrapping="false" />
								<Text text="{dados>arquivo}" /><Text text="{dados>modo}" wrapping="false" /><Text text="{dados>enviada_por}" wrapping="false" />
								<HBox alignItems="Center" renderType="Bare"><ObjectStatus text="{dados>situacao/texto}" state="{dados>situacao/estado}" inverted="true" class="sapUiTinyMarginEnd" />
									<Text text="{dados>percentual}%" visible="{dados>trabalhando}" /></HBox>
								<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>lista.acoes}" press=".acoes" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<core:Fragment fragmentName="crm.fragment.Paginacao" type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
