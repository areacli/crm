<mvc:View controllerName="crm.controller.Indices" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" height="100%">
	<!-- Índices do Banco Central (08, R145 a R147, R157, R158; modelo Configuração): a situação da busca com "Buscar índices agora" (permissão 14 em algum
	     credor) e, por credor, os meses com as quatro séries; o detalhe do mês abre abaixo da tabela ao tocar na linha. Editar índice no painel lateral;
	     desfazer a correção em modal pequeno, com o motivo. -->
	<f:FlexibleColumnLayout id="colunas" layout="OneColumn" backgroundDesign="Solid">
		<f:beginColumnPages>
			<f:DynamicPage toggleHeaderOnTitleClick="false">
				<f:title><f:DynamicPageTitle>
					<f:heading><Title text="{i18n>indices.titulo}" level="H2" /></f:heading>
					<f:expandedContent><Text text="{i18n>indices.subtitulo}" /></f:expandedContent>
				</f:DynamicPageTitle></f:title>
				<f:content>
					<VBox renderType="Bare">
						<f:Card class="sapUiSmallMarginBottom">
							<f:header><card:Header title="{i18n>indices.situacao}">
								<card:toolbar><HBox alignItems="Center" renderType="Bare" visible="{dados>/pode_buscar}">
									<ObjectStatus text="{i18n>indices.buscando}" state="Information" inverted="true" visible="{dados>/buscando}" />
									<Button text="{i18n>indices.buscarAgora}" press=".buscarAgora" visible="{= !${dados>/buscando} }" />
								</HBox></card:toolbar>
							</card:Header></f:header>
							<f:content>
								<VBox renderType="Bare" class="sapUiSmallMargin" width="100%">
									<Text text="{dados>/ultima_busca}" />
									<MessageStrip text="{dados>/falha}" type="Error" showIcon="true" visible="{= !!${dados>/falha} }" class="sapUiSmallMarginTop" />
									<Table items="{dados>/buscas}" fixedLayout="false" visible="{= ${dados>/buscas}.length > 0 }" class="sapUiSmallMarginTop">
										<headerToolbar><OverflowToolbar style="Clear"><Title text="{i18n>indices.ultimasBuscas}" level="H3" /></OverflowToolbar></headerToolbar>
										<columns>
											<Column><Text text="{i18n>indices.quando}" /></Column><Column><Text text="{i18n>indices.resultado}" /></Column>
											<Column hAlign="End"><Text text="{i18n>indices.mesesGravados}" /></Column>
										</columns>
										<items><ColumnListItem><cells>
											<Text text="{dados>quando}" wrapping="false" /><Text text="{dados>resultado}" maxLines="2" tooltip="{dados>resultado}" /><Text text="{dados>meses}" wrapping="false" />
										</cells></ColumnListItem></items>
									</Table>
								</VBox>
							</f:content>
						</f:Card>

						<Text text="{i18n>indices.vazio}" visible="{dados>/vazio}" class="nota sapUiSmallMarginBottom" />

						<VBox items="{path: 'dados>/credores', templateShareable: false}" renderType="Bare">
							<f:Card class="sapUiSmallMarginBottom">
								<f:header><card:Header title="{dados>nome}">
									<card:toolbar><Button text="{i18n>indices.editar}" press=".editarIndice" visible="{dados>pode_corrigir}" /></card:toolbar>
								</card:Header></f:header>
								<f:content>
									<VBox renderType="Bare" width="100%">
										<Table items="{path: 'dados>meses', templateShareable: false}" fixedLayout="false" visible="{= !${dados>/vazio} }" itemPress=".mostrarDetalhe">
											<columns>
												<Column><Text text="{i18n>indices.mes}" /></Column>
												<Column hAlign="End"><Text text="{dados>/series/0/nome}" /></Column><Column hAlign="End"><Text text="{dados>/series/1/nome}" /></Column>
												<Column hAlign="End"><Text text="{dados>/series/2/nome}" /></Column><Column hAlign="End"><Text text="{dados>/series/3/nome}" /></Column>
											</columns>
											<items>
												<ColumnListItem type="Active" highlight="{= ${dados>mes} === ${ui>/detalhe/mes} &amp;&amp; ${dados>credor_id} === ${ui>/detalhe/credor_id} ? 'Information' : 'None' }">
													<cells>
														<Text text="{dados>mes}" wrapping="false" />
														<HBox justifyContent="End" alignItems="Center" renderType="Bare"><ObjectStatus text="{i18n>indices.corrigido}" state="Warning" inverted="true" visible="{dados>valores/0/corrigido}" class="sapUiTinyMarginEnd" /><Text text="{dados>valores/0/texto}" wrapping="false" /></HBox>
														<HBox justifyContent="End" alignItems="Center" renderType="Bare"><ObjectStatus text="{i18n>indices.corrigido}" state="Warning" inverted="true" visible="{dados>valores/1/corrigido}" class="sapUiTinyMarginEnd" /><Text text="{dados>valores/1/texto}" wrapping="false" /></HBox>
														<HBox justifyContent="End" alignItems="Center" renderType="Bare"><ObjectStatus text="{i18n>indices.corrigido}" state="Warning" inverted="true" visible="{dados>valores/2/corrigido}" class="sapUiTinyMarginEnd" /><Text text="{dados>valores/2/texto}" wrapping="false" /></HBox>
														<HBox justifyContent="End" alignItems="Center" renderType="Bare"><ObjectStatus text="{i18n>indices.corrigido}" state="Warning" inverted="true" visible="{dados>valores/3/corrigido}" class="sapUiTinyMarginEnd" /><Text text="{dados>valores/3/texto}" wrapping="false" /></HBox>
													</cells>
												</ColumnListItem>
											</items>
										</Table>
										<!-- O detalhe do mês escolhido: a origem de cada valor e, na correção, quem, quando e por quê, com "Desfazer". -->
										<Panel headerText="{parts: ['i18n>indices.detalhe', 'ui>/detalhe/mes'], formatter: '.formatarTexto'}" class="detalhe-da-linha"
											visible="{= ${ui>/detalhe/credor_id} === ${dados>id} }">
											<VBox items="{path: 'ui>/detalhe/itens', templateShareable: false}" renderType="Bare">
												<HBox alignItems="Center" renderType="Bare">
													<Text text="{ui>texto}" class="sapUiTinyMarginEnd" />
													<Link text="{i18n>indices.desfazer}" press=".desfazer" visible="{= !!${ui>correcao_id} }"
														tooltip="{parts: ['i18n>indices.desfazer.rotulo', 'ui>serie', 'ui>/detalhe/mes'], formatter: '.formatarTexto'}" />
												</HBox>
											</VBox>
										</Panel>
									</VBox>
								</f:content>
							</f:Card>
						</VBox>

						<OverflowToolbar style="Clear" visible="{= ${dados>/paginas} > 1 }">
							<Button text="{i18n>indices.maisNovos}" icon="sap-icon://navigation-left-arrow" enabled="{= ${dados>/pagina} > 1 }" press=".mesesMaisNovos" />
							<ToolbarSpacer />
							<Text text="{parts: ['i18n>indices.pagina', 'dados>/pagina', 'dados>/paginas'], formatter: '.formatarTexto'}" />
							<ToolbarSpacer />
							<Button text="{i18n>indices.anteriores}" icon="sap-icon://navigation-right-arrow" iconFirst="false" enabled="{= ${dados>/pagina} &lt; ${dados>/paginas} }" press=".mesesAnteriores" />
						</OverflowToolbar>
					</VBox>
				</f:content>
			</f:DynamicPage>
		</f:beginColumnPages>
	</f:FlexibleColumnLayout>
</mvc:View>
