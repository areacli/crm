<mvc:View controllerName="crm.controller.Acordos" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" height="100%">
	<!-- Lista de acordos (11, R243; modelo Lista): filtros, os casos que pedem o gestor e as propostas e acordos; o número abre o acordo numa aba. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false" fitContent="true">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{i18n>acordos.titulo}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{i18n>acordos.subtitulo}" /></f:expandedContent>
			<f:actions><Button text="{i18n>acordos.arquivo}" visible="{dados>/pode_ver_arquivo}" press=".abrirArquivo" /></f:actions>
		</f:DynamicPageTitle></f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<FlexBox wrap="Wrap" alignItems="End" class="filtros">
					<VBox><Label text="{i18n>ficha.situacao}" labelFor="situacao" />
						<Select id="situacao" selectedKey="{filtro>/state}" change=".buscar" items="{path: 'dados>/filtros/situacoes', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
					<VBox><Label text="{i18n>acionamentos.de}" labelFor="de" /><DatePicker id="de" value="{filtro>/from}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" change=".buscar" width="9rem" /></VBox>
					<VBox><Label text="{i18n>acionamentos.ate}" labelFor="ate" /><DatePicker id="ate" value="{filtro>/to}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" change=".buscar" width="9rem" /></VBox>
					<VBox><Label text="{i18n>acordos.quemMontou}" labelFor="quem" />
						<Select id="quem" selectedKey="{filtro>/user}" change=".buscar" items="{path: 'dados>/filtros/operadores', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
					<VBox visible="{dados>/com_origem}"><Label text="{i18n>ficha.contatos.origem}" labelFor="origem" />
						<Select id="origem" selectedKey="{filtro>/origin}" change=".buscar" items="{path: 'dados>/filtros/origens', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
					<VBox visible="{dados>/varios_credores}"><Label text="{i18n>clientes.credor}" labelFor="credor" />
						<Select id="credor" selectedKey="{filtro>/tenant}" change=".buscar" items="{path: 'dados>/filtros/credores', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox renderType="Bare">
				<Panel headerText="{i18n>acordos.casos}" visible="{= ${dados>/casos}.length > 0 }" class="sapUiSmallMarginBottom">
					<Table items="{dados>/casos}" fixedLayout="false">
						<columns><Column><Text text="{i18n>acordos.caso}" /></Column><Column><Text text="{i18n>ficha.acordo}" /></Column><Column><Text text="{i18n>clientes.coluna.cliente}" /></Column>
							<Column><Text text="{i18n>clientes.credor}" /></Column><Column><Text text="{i18n>acordos.detalhe}" /></Column></columns>
						<items><ColumnListItem><cells>
							<Text text="{dados>caso}" /><Link text="{dados>acordo}" press=".abrirAcordo" enabled="{= !!${dados>acordo_id} }" /><Link text="{dados>cliente}" press=".abrirFicha" />
							<Text text="{dados>credor}" /><Link text="{dados>detalhe}" press=".abrirEndereco" enabled="{= !!${dados>endereco} }" />
						</cells></ColumnListItem></items>
					</Table>
				</Panel>
				<Table items="{dados>/linhas}" sticky="ColumnHeaders" fixedLayout="false" noData="{i18n>acordos.vazio}">
					<columns>
						<Column><Text text="{i18n>ficha.numero}" /></Column><Column><Text text="{i18n>clientes.coluna.cliente}" /></Column>
						<Column visible="{dados>/varios_credores}"><Text text="{i18n>clientes.credor}" /></Column>
						<Column><Text text="{i18n>ficha.situacao}" /></Column><Column><Text text="{i18n>acordos.forma}" /></Column>
						<Column hAlign="End"><Text text="{i18n>ficha.valor}" /></Column><Column hAlign="End"><Text text="{i18n>acordos.desconto}" /></Column>
						<Column hAlign="End"><Text text="{i18n>ficha.acordos.entrada}" /></Column><Column hAlign="End"><Text text="{i18n>ficha.acordos.parcelas}" /></Column>
						<Column><Text text="{i18n>acordos.montou}" /></Column><Column visible="{dados>/com_origem}"><Text text="{i18n>ficha.contatos.origem}" /></Column>
						<Column><Text text="{i18n>acordos.aprovou}" /></Column><Column><Text text="{i18n>acordos.valeAte}" /></Column>
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<Link text="{dados>numero}" press=".abrirAcordo" /><Link text="{dados>cliente}" press=".abrirFicha" /><Text text="{dados>credor}" wrapping="false" />
								<HBox items="{path: 'dados>selos', templateShareable: false}" renderType="Bare"><ObjectStatus text="{dados>texto}" state="{dados>estado}" inverted="true" class="sapUiTinyMarginEnd" /></HBox>
								<Text text="{dados>forma}" wrapping="false" /><Text text="{dados>valor}" wrapping="false" /><Text text="{dados>desconto}" wrapping="false" />
								<Text text="{dados>entrada}" wrapping="false" /><Text text="{dados>parcelas}" /><Text text="{dados>montou}" wrapping="false" />
								<Text text="{dados>origem}" wrapping="false" /><Text text="{dados>aprovou}" wrapping="false" /><Text text="{dados>vale_ate}" wrapping="false" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<core:Fragment fragmentName="crm.fragment.Paginacao" type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
