<mvc:View controllerName="crm.controller.DadosDoCredor" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form" height="100%">
	<!-- Dados do credor (06, R106, R106a; modelo Configuração): o cadastro de cada credor, separado, com o prazo de guarda dos dados (07). -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{i18n>credor.titulo}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{i18n>credor.subtitulo}" /></f:expandedContent>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox items="{path: 'dados>/credores', templateShareable: false}" renderType="Bare">
				<f:Card class="sapUiSmallMarginBottom">
					<f:header><card:Header title="{dados>nome}" subtitle="{dados>ultima}" /></f:header>
					<f:content>
						<VBox renderType="Bare" width="100%">
							<form:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="3" columnsXL="3" labelSpanL="12" labelSpanM="12">
								<Label text="{i18n>credor.cnpj}" /><Input value="{dados>cadastro/cnpj}" maxLength="18" />
								<Label text="{i18n>operacoes.razaoSocial}" required="true" /><Input value="{dados>cadastro/legal_name}" maxLength="300" />
								<Label text="{i18n>credor.nomeFantasia}" /><Input value="{dados>cadastro/trade_name}" maxLength="300" />
								<core:Title text="{i18n>credor.endereco}" />
								<Label text="{i18n>credor.logradouro}" /><Input value="{dados>cadastro/street}" maxLength="200" />
								<Label text="{i18n>credor.numero}" /><Input value="{dados>cadastro/number}" maxLength="20" />
								<Label text="{i18n>credor.complemento}" /><Input value="{dados>cadastro/complement}" maxLength="100" />
								<Label text="{i18n>credor.bairro}" /><Input value="{dados>cadastro/district}" maxLength="100" />
								<Label text="{i18n>credor.cidade}" /><Input value="{dados>cadastro/city}" maxLength="100" />
								<Label text="{i18n>credor.uf}" /><Select selectedKey="{dados>cadastro/state}" forceSelection="false" items="{path: 'dados>/ufs', templateShareable: false}"><core:Item key="{dados>}" text="{dados>}" /></Select>
								<Label text="{i18n>credor.cep}" /><Input value="{dados>cadastro/zip}" maxLength="9" />
								<core:Title text="{i18n>credor.contato}" />
								<Label text="{i18n>operacao.email}" /><Input value="{dados>cadastro/email}" type="Email" maxLength="254" />
								<Label text="{i18n>credor.telefone}" /><Input value="{dados>cadastro/phone}" type="Tel" maxLength="60" />
							</form:SimpleForm>
							<Text text="{i18n>credor.telefone.ajuda}" class="nota sapUiSmallMarginBegin" />
							<HBox justifyContent="End" class="sapUiSmallMargin" renderType="Bare"><Button text="{i18n>credor.salvar}" type="Emphasized" press=".salvarCadastro" /></HBox>
							<form:SimpleForm editable="true" layout="ColumnLayout" title="{i18n>credor.guarda}">
								<Label text="{i18n>credor.anos}" required="true" /><StepInput value="{dados>anos_de_guarda}" min="1" max="50" width="10rem" />
							</form:SimpleForm>
							<Text text="{i18n>credor.anos.ajuda}" class="nota sapUiSmallMarginBegin" />
							<HBox justifyContent="End" class="sapUiSmallMargin" renderType="Bare"><Button text="{i18n>credor.salvarGuarda}" press=".salvarGuarda" /></HBox>
						</VBox>
					</f:content>
				</f:Card>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
