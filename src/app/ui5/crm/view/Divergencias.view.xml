<mvc:View controllerName="crm.controller.Divergencias" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" height="100%">
	<!-- Divergências de valor (05, R99; modelo Lista): as abertas por padrão; o título abre a divergência numa aba. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false" fitContent="true">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{i18n>divergencias.titulo}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{i18n>divergencias.subtitulo}" /></f:expandedContent>
		</f:DynamicPageTitle></f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<FlexBox wrap="Wrap" alignItems="End" class="filtros">
					<VBox><Label text="{i18n>ficha.situacao}" labelFor="situacao" />
						<Select id="situacao" selectedKey="{filtro>/status}" change=".buscar">
							<core:Item key="open" text="{i18n>divergencias.abertas}" /><core:Item key="handled" text="{i18n>divergencias.tratadas}" /><core:Item key="all" text="{i18n>filtro.todas}" />
						</Select></VBox>
					<VBox visible="{dados>/varios_credores}"><Label text="{i18n>clientes.credor}" labelFor="credor" />
						<Select id="credor" selectedKey="{filtro>/tenant}" change=".buscar" items="{path: 'dados>/credores', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox renderType="Bare">
				<Table items="{dados>/linhas}" sticky="ColumnHeaders" fixedLayout="false" noData="{dados>/vazio}">
					<columns>
						<Column><Text text="{i18n>ficha.titulo}" /></Column><Column><Text text="{i18n>clientes.coluna.cliente}" /></Column>
						<Column visible="{dados>/varios_credores}"><Text text="{i18n>clientes.credor}" /></Column><Column><Text text="{i18n>ficha.data}" /></Column>
						<Column hAlign="End"><Text text="{i18n>divergencias.anterior}" /></Column><Column hAlign="End"><Text text="{i18n>divergencias.informado}" /></Column>
						<Column hAlign="End"><Text text="{i18n>ficha.pago}" /></Column><Column hAlign="End"><Text text="{i18n>divergencias.saldoAntes}" /></Column>
						<Column hAlign="End"><Text text="{i18n>divergencias.saldoDepois}" /></Column><Column><Text text="{i18n>divergencias.efeito}" /></Column>
						<Column><Text text="{i18n>ficha.situacao}" /></Column><Column hAlign="End"><Text text="" /></Column>
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<Link text="{dados>titulo}" press=".abrir" /><Link text="{dados>cliente}" press=".abrirFicha" enabled="{= !!${dados>cliente_id} }" /><Text text="{dados>credor}" wrapping="false" />
								<Text text="{dados>data}" wrapping="false" /><Text text="{dados>anterior}" wrapping="false" /><Text text="{dados>informado}" wrapping="false" />
								<Text text="{dados>pago}" wrapping="false" /><Text text="{dados>saldo_antes}" wrapping="false" /><Text text="{dados>saldo_depois}" wrapping="false" />
								<Text text="{dados>efeito}" wrapping="false" /><ObjectStatus text="{dados>selo/texto}" state="{dados>selo/estado}" inverted="true" />
								<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>lista.acoes}" press=".acoes" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<core:Fragment fragmentName="crm.fragment.Paginacao" type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
