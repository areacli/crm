<mvc:View controllerName="crm.controller.Segmentos" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" height="100%">
	<!-- Segmentos (13, R252, R273, R295; modelo Lista): os segmentos de cada credor num cartão, com as condições no texto curto e a leitura por extenso
	     no botão de informação; abrir, editar, duplicar, desativar, reativar e excluir (só o sem uso) pelo menu da linha. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{i18n>segmentos.titulo}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{i18n>segmentos.subtitulo}" /></f:expandedContent>
			<f:actions><Button text="{i18n>segmentos.verGlossario}" press=".abrirGlossario" /></f:actions>
		</f:DynamicPageTitle></f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<FlexBox wrap="Wrap" alignItems="End" renderType="Bare" class="filtros">
					<VBox class="sapUiSmallMarginEnd"><Label text="{i18n>segmentos.nome}" labelFor="busca" />
						<SearchField id="busca" value="{filtro>/busca}" liveChange=".buscarAoDigitar" search=".buscar" width="18rem" /></VBox>
					<VBox class="sapUiSmallMarginEnd"><Label text="{i18n>segmentos.seleciona}" labelFor="seleciona" />
						<Select id="seleciona" selectedKey="{filtro>/seleciona}" change=".buscar" width="12rem" items="{path: 'dados>/filtros/seleciona', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
					<VBox class="sapUiSmallMarginEnd"><Label text="{i18n>segmentos.uso}" labelFor="uso" />
						<Select id="uso" selectedKey="{filtro>/uso}" change=".buscar" width="12rem" items="{path: 'dados>/filtros/uso', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
					<VBox><Label text="{i18n>segmentos.situacao}" labelFor="situacao" />
						<Select id="situacao" selectedKey="{filtro>/situacao}" change=".buscar" width="12rem" items="{path: 'dados>/filtros/situacao', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox items="{path: 'dados>/credores', templateShareable: false}" renderType="Bare">
				<f:Card class="sapUiSmallMarginBottom">
					<f:header><card:Header title="{dados>nome}">
						<card:toolbar><Button text="{i18n>segmentos.criar}" type="Emphasized" press=".criar" visible="{dados>pode_mudar}" /></card:toolbar>
					</card:Header></f:header>
					<f:content>
						<Table items="{path: 'dados>segmentos', templateShareable: false}" fixedLayout="false" noData="{i18n>segmentos.vazio}">
							<columns>
								<Column><Text text="{i18n>segmentos.nome}" /></Column><Column><Text text="{i18n>segmentos.seleciona}" /></Column>
								<Column><Text text="{i18n>segmentos.condicoes}" /></Column><Column><Text text="{i18n>segmentos.ondeEUsado}" /></Column>
								<Column><Text text="{i18n>segmentos.situacao}" /></Column><Column><Text text="{i18n>segmentos.alteradoEm}" /></Column>
								<Column hAlign="End"><Text text="" /></Column>
							</columns>
							<items><ColumnListItem><cells>
								<Link text="{dados>nome}" press=".abrirDaLinha" wrapping="false" />
								<Text text="{dados>seleciona}" wrapping="false" />
								<HBox alignItems="Center" renderType="Bare">
									<Text text="{dados>condicoes}" class="codigo" />
									<Button icon="sap-icon://hint" type="Transparent" press=".mostrarLeitura"
										tooltip="{parts: ['i18n>segmentos.leitura', 'dados>nome'], formatter: '.formatarTexto'}" />
								</HBox>
								<Text text="{dados>uso}" />
								<ObjectStatus text="{dados>situacao/texto}" state="{dados>situacao/estado}" inverted="true" />
								<Text text="{dados>alterado_em}" wrapping="false" />
								<Button icon="sap-icon://overflow" type="Transparent" tooltip="{parts: ['i18n>segmentos.acoesDe', 'dados>nome'], formatter: '.formatarTexto'}" press=".acoes" />
							</cells></ColumnListItem></items>
						</Table>
					</f:content>
				</f:Card>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
