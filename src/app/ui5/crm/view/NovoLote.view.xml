<mvc:View controllerName="crm.controller.NovoLote" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified" height="100%">
	<!-- Distribuir em lote (14, R316; modelo Entrada): a operação, de onde vem o lote (o filtro da lista de clientes, um segmento ou uma planilha), a
	     exposição e o período. Conferir abre a página do lote, que avisa quando a conferência termina. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{i18n>lote.novo.titulo}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{i18n>lote.novo.subtitulo}" /></f:expandedContent>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<MessageStrip text="{i18n>lote.novo.semOperacao}" type="Information" showIcon="true" visible="{= ${dados>/credenciadas}.length === 0 }" />
				<f:Card class="cartao-formulario" visible="{= ${dados>/credenciadas}.length > 0 }">
					<f:header><card:Header title="{i18n>lote.novo.lote}" /></f:header>
					<f:content>
						<VBox renderType="Bare" class="sapUiSmallMargin" width="100%">
							<MessageStrip text="{ui>/erro}" type="Error" showIcon="true" visible="{= !!${ui>/erro} }" class="sapUiSmallMarginBottom" />
							<Label text="{i18n>distribuicao.operacao}" labelFor="operacao" required="true" />
							<Select id="operacao" width="100%" selectedKey="{ui>/operacao}" items="{path: 'dados>/credenciadas', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
							<Label text="{i18n>lote.novo.origem}" class="sapUiSmallMarginTop" />
							<RadioButtonGroup selectedIndex="{ui>/origem}" select=".mudarOrigem">
								<RadioButton text="{i18n>lote.novo.doFiltro}" visible="{ui>/comSelecao}" />
								<RadioButton text="{i18n>lote.novo.segmento}" />
								<RadioButton text="{i18n>lote.novo.planilha}" />
							</RadioButtonGroup>
							<Label text="{i18n>lote.novo.segmento}" labelFor="segmento" visible="{= ${ui>/tipo} === 'segment' }" class="sapUiSmallMarginTop" />
							<Select id="segmento" width="100%" forceSelection="false" selectedKey="{ui>/segmento}" visible="{= ${ui>/tipo} === 'segment' }" items="{path: 'dados>/segmentos', templateShareable: false}">
								<core:Item key="{dados>id}" text="{dados>nome}" /></Select>
							<Label text="{i18n>lote.novo.arquivo}" labelFor="arquivo" visible="{= ${ui>/tipo} === 'file' }" class="sapUiSmallMarginTop" />
							<u:FileUploader id="arquivo" width="100%" fileType="csv" change=".escolherArquivo" visible="{= ${ui>/tipo} === 'file' }" buttonText="{i18n>importacao.nova.escolher}"
								placeholder="{i18n>importacao.nova.nenhum}" />
							<Label text="{i18n>distribuicao.exposicao}" labelFor="exposicao" class="sapUiSmallMarginTop" />
							<Select id="exposicao" width="100%" selectedKey="{ui>/exposicao}" items="{path: 'dados>/exposicoes', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
							<Label text="{i18n>distribuicao.inicio}" labelFor="inicio" class="sapUiSmallMarginTop" />
							<DatePicker id="inicio" value="{ui>/inicio}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" />
							<Label text="{i18n>distribuicao.fim}" labelFor="fim" class="sapUiSmallMarginTop" />
							<DatePicker id="fim" value="{ui>/fim}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" />
							<Button text="{i18n>lote.novo.conferir}" type="Emphasized" press=".conferir" busy="{ui>/enviando}" class="sapUiSmallMarginTop" />
						</VBox>
					</f:content>
				</f:Card>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
