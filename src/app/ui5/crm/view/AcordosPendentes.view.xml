<mvc:View controllerName="crm.controller.AcordosPendentes" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" height="100%">
	<!-- Acordos pendentes (11, R216, R243; modelo Lista): as propostas que a pessoa pode aprovar; nunca as que ela montou. -->
	<f:DynamicPage toggleHeaderOnTitleClick="false" fitContent="true">
		<f:title><f:DynamicPageTitle>
			<f:heading><Title text="{i18n>pendentes.acordos.titulo}" level="H2" /></f:heading>
			<f:expandedContent><Text text="{i18n>pendentes.acordos.subtitulo}" /></f:expandedContent>
		</f:DynamicPageTitle></f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false" visible="{dados>/varios_credores}">
				<VBox><Label text="{i18n>clientes.credor}" labelFor="credor" />
					<Select id="credor" selectedKey="{filtro>/tenant}" change=".buscar" items="{path: 'dados>/credores', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select></VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<Table items="{dados>/linhas}" sticky="ColumnHeaders" fixedLayout="false" noData="{i18n>pendentes.acordos.vazio}">
				<columns>
					<Column visible="{dados>/varios_credores}"><Text text="{i18n>clientes.credor}" /></Column>
					<Column><Text text="{i18n>ficha.numero}" /></Column><Column><Text text="{i18n>clientes.coluna.cliente}" /></Column>
					<Column hAlign="End"><Text text="{i18n>pendentes.acordos.valor}" /></Column><Column hAlign="End"><Text text="{i18n>acordos.desconto}" /></Column>
					<Column><Text text="{i18n>pendentes.acordos.porComponente}" /></Column><Column hAlign="End"><Text text="{i18n>ficha.acordos.parcelas}" /></Column>
					<Column><Text text="{i18n>acordos.montou}" /></Column><Column><Text text="{i18n>acordos.valeAte}" /></Column><Column hAlign="End"><Text text="" /></Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{dados>credor}" wrapping="false" /><Link text="{dados>numero}" press=".abrirAcordo" /><Link text="{dados>cliente}" press=".abrirFicha" />
							<Text text="{dados>valor}" wrapping="false" /><Text text="{dados>desconto}" wrapping="false" /><Text text="{dados>desconto_por_componente}" />
							<Text text="{dados>parcelas}" /><Text text="{dados>montou}" wrapping="false" /><Text text="{dados>vale_ate}" wrapping="false" />
							<HBox justifyContent="End" renderType="Bare">
								<Button text="{i18n>pendentes.aprovar}" press=".aprovar" class="sapUiTinyMarginEnd" />
								<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>lista.acoes}" press=".acoes" />
							</HBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>
