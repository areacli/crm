<mvc:View controllerName="crm.controller.GruposDeFilas" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" height="100%">
	<!-- Grupos das filas (15, R353, R358; modelo Configuração): os usuários de um grupo recebem, pelo "Próximo", das filas ligadas a ele; o nome de um
	     usuário abre a estratégia dele. Criar e editar no painel lateral. -->
	<f:FlexibleColumnLayout id="colunas" layout="OneColumn" backgroundDesign="Solid">
		<f:beginColumnPages>
			<f:DynamicPage toggleHeaderOnTitleClick="false">
				<f:title><f:DynamicPageTitle>
					<f:heading><Title text="{i18n>filas.grupos.titulo}" level="H2" /></f:heading>
					<f:expandedContent><Text text="{i18n>filas.grupos.subtitulo}" /></f:expandedContent>
					<f:actions><Button text="{i18n>filas.grupos.criar}" type="Emphasized" press=".criar" /></f:actions>
				</f:DynamicPageTitle></f:title>
				<f:content>
					<VBox renderType="Bare">
						<core:Fragment fragmentName="crm.fragment.Credores" type="XML" />
						<Table items="{path: 'dados>/grupos', templateShareable: false}" fixedLayout="false" noData="{i18n>filas.grupos.vazio}">
							<columns>
								<Column><Text text="{i18n>filas.grupos.grupo}" /></Column><Column><Text text="{i18n>filas.grupos.usuarios}" /></Column>
								<Column><Text text="{i18n>filas.grupos.filas}" /></Column><Column hAlign="End"><Text text="" /></Column>
							</columns>
							<items><ColumnListItem><cells>
								<Text text="{dados>nome}" />
								<HBox wrap="Wrap" items="{path: 'dados>usuarios', templateShareable: false}" renderType="Bare">
									<Link text="{dados>nome}" press=".estrategia" tooltip="{parts: ['i18n>filas.estrategia.titulo', 'dados>nome'], formatter: '.formatarTexto'}" class="sapUiTinyMarginEnd" />
								</HBox>
								<Text text="{dados>filas}" />
								<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>lista.acoes}" press=".acoes" />
							</cells></ColumnListItem></items>
						</Table>
						<Text text="{i18n>filas.grupos.nota}" class="nota sapUiSmallMarginTop" />
					</VBox>
				</f:content>
			</f:DynamicPage>
		</f:beginColumnPages>
	</f:FlexibleColumnLayout>
</mvc:View>
