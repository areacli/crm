<mvc:View controllerName="crm.controller.Operacoes" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" height="100%">
	<!-- Operações credenciadas (14, R306, R319, R325; modelo Configuração): a lista, credenciar no painel lateral e as políticas das operações de cada credor
	     em grade, uma lista de escolha por política, com "Salvar políticas" no cabeçalho do cartão. -->
	<f:FlexibleColumnLayout id="colunas" layout="OneColumn" backgroundDesign="Solid">
		<f:beginColumnPages>
			<f:DynamicPage toggleHeaderOnTitleClick="false">
				<f:title><f:DynamicPageTitle>
					<f:heading><Title text="{i18n>operacoes.titulo}" level="H2" /></f:heading>
					<f:expandedContent><Text text="{i18n>operacoes.subtitulo}" /></f:expandedContent>
					<f:actions><Button text="{i18n>operacoes.credenciar}" type="Emphasized" press=".credenciar" /></f:actions>
				</f:DynamicPageTitle></f:title>
				<f:content>
					<VBox renderType="Bare">
						<Table items="{dados>/linhas}" fixedLayout="false" noData="{i18n>operacoes.vazio}">
							<columns>
								<Column><Text text="{i18n>distribuicao.operacao}" /></Column><Column><Text text="{i18n>operacoes.cnpj}" /></Column>
								<Column visible="{dados>/varios_credores}"><Text text="{i18n>clientes.credor}" /></Column><Column><Text text="{i18n>importacoes.situacao}" /></Column>
								<Column hAlign="End"><Text text="{i18n>operacoes.pessoas}" /></Column>
							</columns>
							<items><ColumnListItem><cells>
								<Link text="{dados>operacao}" press=".abrir" /><Text text="{dados>cnpj}" wrapping="false" /><Text text="{dados>credor}" />
								<ObjectStatus text="{dados>situacao/texto}" state="{dados>situacao/estado}" inverted="true" /><Text text="{dados>pessoas}" />
							</cells></ColumnListItem></items>
						</Table>
						<core:Fragment fragmentName="crm.fragment.Paginacao" type="XML" />
						<VBox items="{path: 'dados>/politicas', templateShareable: false}" renderType="Bare">
							<f:Card class="sapUiSmallMarginTop">
								<f:header><card:Header title="{parts: ['i18n>operacoes.politicas', 'dados>credor'], formatter: '.formatarTexto'}">
									<card:toolbar><Button text="{i18n>operacoes.salvarPoliticas}" type="Emphasized" press=".salvarPoliticas" /></card:toolbar>
								</card:Header></f:header>
								<f:content>
									<!-- Uma política por campo, em grade: cada escolha numa lista, sem empilhar as opções. -->
									<form:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="3" columnsXL="3" labelSpanL="12" labelSpanM="12" width="100%">
										<Label text="{i18n>operacoes.exclusividade}" />
										<Select selectedKey="{dados>exclusiva}" width="100%"><core:Item key="0" text="{i18n>operacoes.exclusiva}" /><core:Item key="1" text="{i18n>operacoes.varias}" /></Select>
										<Label text="{i18n>operacoes.exposicaoPadrao}" />
										<Select selectedKey="{dados>exposicao}" width="100%" items="{path: 'dados>/exposicoes', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										<Label text="{i18n>operacoes.diasUteis}" />
										<StepInput value="{dados>dias_uteis}" min="0" max="30" width="14rem" fieldWidth="50%" description="{i18n>operacoes.diasUteis.unidade}" tooltip="{i18n>operacoes.diasUteis.ajuda}" />
										<Label text="{i18n>operacoes.outrosAcordos}" />
										<Select selectedKey="{dados>ve_outros_acordos}" width="100%"><core:Item key="0" text="{i18n>operacoes.naoVe}" /><core:Item key="1" text="{i18n>operacoes.ve}" /></Select>
										<Label text="{i18n>operacoes.outrosAcionamentos}" />
										<Select selectedKey="{dados>outros_acionamentos}" width="100%"><core:Item key="0" text="{i18n>operacoes.veResumo}" /><core:Item key="1" text="{i18n>operacoes.naoVe}" /></Select>
										<Label text="{i18n>operacoes.vinculos}" />
										<Select selectedKey="{dados>gestor_da_vinculos}" width="100%"><core:Item key="0" text="{i18n>operacoes.soCredor}" /><core:Item key="1" text="{i18n>operacoes.gestorTambem}" /></Select>
									</form:SimpleForm>
								</f:content>
							</f:Card>
						</VBox>
					</VBox>
				</f:content>
			</f:DynamicPage>
		</f:beginColumnPages>
	</f:FlexibleColumnLayout>
</mvc:View>
