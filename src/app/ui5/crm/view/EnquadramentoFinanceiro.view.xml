<mvc:View controllerName="crm.controller.EnquadramentoFinanceiro" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" height="100%">
	<!-- Enquadramento financeiro (13, R265 a R272, R276, R292 a R294; 09, R160, R165, R180 a R182; 11, R207a, R246; modelo Configuração): os itens do credor em
	     ordem com as regras (condições, encargos, promessa e acordo no detalhe da linha); incluir e editar regras no painel lateral; mover e excluir no menu
	     da linha; parâmetros e políticas de encargos em grade, cada cartão com "Conferir mudança". Tudo isso abre a conferência do impacto numa aba. Os
	     parâmetros dos acordos gravam direto. Sem a permissão 14 no credor, os valores aparecem como texto e sem botões. -->
	<f:FlexibleColumnLayout id="colunas" layout="OneColumn" backgroundDesign="Solid">
		<f:beginColumnPages>
			<f:DynamicPage toggleHeaderOnTitleClick="false">
				<f:title><f:DynamicPageTitle>
					<f:heading><Title text="{i18n>financeiro.titulo}" level="H2" /></f:heading>
					<f:expandedContent><Text text="{i18n>financeiro.subtitulo}" /></f:expandedContent>
					<f:actions><Button text="{i18n>financeiro.incluir}" type="Emphasized" press=".incluir" visible="{dados>/pode_mudar}" /></f:actions>
				</f:DynamicPageTitle></f:title>
				<f:content>
					<VBox renderType="Bare">
						<core:Fragment fragmentName="crm.fragment.Credores" type="XML" />
						<MessageStrip text="{dados>/recalculo/texto}" type="Error" showIcon="true" visible="{= !!${dados>/recalculo/falhou} }" class="sapUiSmallMarginBottom" />
						<Text text="{dados>/recalculo/texto}" visible="{= !${dados>/recalculo/falhou} }" class="nota sapUiSmallMarginBottom" />

						<Table items="{path: 'dados>/itens', templateShareable: false}" fixedLayout="false" itemPress=".mostrarDetalhe" noData="{i18n>financeiro.vazio}">
							<columns>
								<Column hAlign="End" width="4rem"><Text text="{i18n>enquadramento.ordem}" /></Column>
								<Column><Text text="{i18n>enquadramento.segmento}" /></Column>
								<Column hAlign="End"><Text text="{i18n>financeiro.contratos}" /></Column>
								<Column hAlign="End"><Text text="{i18n>financeiro.saldo}" /></Column>
								<Column><Text text="{i18n>financeiro.regras}" /></Column>
								<Column hAlign="End" visible="{dados>/pode_mudar}"><Text text="" /></Column>
							</columns>
							<items><ColumnListItem type="Active" highlight="{= ${dados>id} === ${ui>/detalhe/id} ? 'Information' : 'None' }"><cells>
								<Text text="{dados>ordem}" />
								<HBox alignItems="Center" renderType="Bare"><Text text="{dados>nome}" wrapping="false" class="sapUiTinyMarginEnd" />
									<ObjectStatus text="{i18n>enquadramento.trilhaPadrao}" inverted="true" visible="{dados>trilha_padrao}" /></HBox>
								<Text text="{dados>contratos}" wrapping="false" />
								<Text text="{dados>saldo}" wrapping="false" />
								<Text text="{dados>regras}" wrapping="false" />
								<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>lista.acoes}" press=".acoes" />
							</cells></ColumnListItem></items>
						</Table>
						<Panel visible="{= !!${ui>/detalhe} }" headerText="{ui>/detalhe/nome}" class="detalhe-da-linha">
							<VBox renderType="Bare">
								<Text text="{ui>/detalhe/condicoes}" visible="{= !!${ui>/detalhe/condicoes} }" />
								<Text text="{ui>/detalhe/leitura}" visible="{= !!${ui>/detalhe/leitura} }" class="nota sapUiTinyMarginBottom" />
								<Text text="{ui>/detalhe/encargos}" />
								<Text text="{ui>/detalhe/promessa_e_acordo}" />
							</VBox>
						</Panel>
						<Text text="{i18n>financeiro.nota}" class="nota sapUiSmallMarginTop" />

						<!-- Parâmetros de encargos do credor: um campo por parâmetro, em grade. -->
						<f:Card class="sapUiSmallMarginTop">
							<f:header><card:Header title="{i18n>financeiro.parametros}">
								<card:toolbar><Button text="{i18n>financeiro.conferirMudanca}" type="Emphasized" press=".conferirParametros" visible="{dados>/pode_mudar}" /></card:toolbar>
							</card:Header></f:header>
							<f:content>
								<VBox renderType="Bare" width="100%">
									<Text text="{i18n>financeiro.parametros.ajuda}" class="nota sapUiSmallMarginBegin sapUiSmallMarginTop" />
									<form:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="3" columnsXL="3" labelSpanL="12" labelSpanM="12" width="100%">
										<Label text="{i18n>financeiro.multa}" />
										<Input value="{dados>/parametros/charge_fine_pct}" inputMode="Decimal" visible="{dados>/pode_mudar}" />
										<Text text="{dados>/parametros_texto/charge_fine_pct}" visible="{= !${dados>/pode_mudar} }" />
										<Label text="{i18n>financeiro.jurosFixos}" />
										<Input value="{dados>/parametros/charge_interest_pct}" inputMode="Decimal" visible="{dados>/pode_mudar}" />
										<Text text="{dados>/parametros_texto/charge_interest_pct}" visible="{= !${dados>/pode_mudar} }" />
										<Label text="{i18n>financeiro.correcao}" />
										<Select selectedKey="{dados>/parametros/charge_index}" width="100%" visible="{dados>/pode_mudar}" items="{path: 'dados>/opcoes/indices', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										<Text text="{dados>/parametros_texto/charge_index}" visible="{= !${dados>/pode_mudar} }" />
										<Label text="{i18n>financeiro.convencao}" />
										<Select selectedKey="{dados>/parametros/charge_days_convention}" width="100%" visible="{dados>/pode_mudar}" items="{path: 'dados>/opcoes/convencoes', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										<Text text="{dados>/parametros_texto/charge_days_convention}" visible="{= !${dados>/pode_mudar} }" />
										<Label text="{i18n>financeiro.baseDaMulta}" />
										<Select selectedKey="{dados>/parametros/charge_fine_base}" width="100%" visible="{dados>/pode_mudar}" items="{path: 'dados>/opcoes/bases', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										<Text text="{dados>/parametros_texto/charge_fine_base}" visible="{= !${dados>/pode_mudar} }" />
									</form:SimpleForm>
								</VBox>
							</f:content>
						</f:Card>

						<!-- As cinco políticas de encargos, em blocos lado a lado: a escolha numa lista e a ajuda da política (a página não tem efeito por opção). -->
						<f:Card class="sapUiSmallMarginTop">
							<f:header><card:Header title="{i18n>financeiro.politicas}">
								<card:toolbar><Button text="{i18n>financeiro.conferirMudanca}" type="Emphasized" press=".conferirPoliticas" visible="{dados>/pode_mudar}" /></card:toolbar>
							</card:Header></f:header>
							<f:content>
								<FlexBox wrap="Wrap" alignItems="Start" renderType="Bare" width="100%" class="sapUiSmallMargin">
									<VBox renderType="Bare" class="bloco-de-politica">
										<Label text="{dados>/politicas/missing_index_policy/titulo}" labelFor="politicaMesSemIndice" />
										<Select id="politicaMesSemIndice" selectedKey="{dados>/politicas/missing_index_policy/valor}" width="100%" visible="{dados>/pode_mudar}" items="{path: 'dados>/politicas/missing_index_policy/opcoes', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										<Text text="{dados>/politicas/missing_index_policy/texto}" visible="{= !${dados>/pode_mudar} }" />
										<Text text="{dados>/politicas/missing_index_policy/ajuda}" class="nota" />
									</VBox>
									<VBox renderType="Bare" class="bloco-de-politica">
										<Label text="{dados>/politicas/default_interest_form/titulo}" labelFor="politicaFormaDosJuros" />
										<Select id="politicaFormaDosJuros" selectedKey="{dados>/politicas/default_interest_form/valor}" width="100%" visible="{dados>/pode_mudar}" items="{path: 'dados>/politicas/default_interest_form/opcoes', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										<Text text="{dados>/politicas/default_interest_form/texto}" visible="{= !${dados>/pode_mudar} }" />
										<Text text="{dados>/politicas/default_interest_form/ajuda}" class="nota" />
									</VBox>
									<VBox renderType="Bare" class="bloco-de-politica">
										<Label text="{dados>/politicas/negative_index_policy/titulo}" labelFor="politicaIndiceNegativo" />
										<Select id="politicaIndiceNegativo" selectedKey="{dados>/politicas/negative_index_policy/valor}" width="100%" visible="{dados>/pode_mudar}" items="{path: 'dados>/politicas/negative_index_policy/opcoes', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										<Text text="{dados>/politicas/negative_index_policy/texto}" visible="{= !${dados>/pode_mudar} }" />
										<Text text="{dados>/politicas/negative_index_policy/ajuda}" class="nota" />
									</VBox>
									<VBox renderType="Bare" class="bloco-de-politica">
										<Label text="{dados>/politicas/old_legal_interest_policy/titulo}" labelFor="politicaJurosLegaisAntigos" />
										<Select id="politicaJurosLegaisAntigos" selectedKey="{dados>/politicas/old_legal_interest_policy/valor}" width="100%" visible="{dados>/pode_mudar}" items="{path: 'dados>/politicas/old_legal_interest_policy/opcoes', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										<Text text="{dados>/politicas/old_legal_interest_policy/texto}" visible="{= !${dados>/pode_mudar} }" />
										<Text text="{dados>/politicas/old_legal_interest_policy/ajuda}" class="nota" />
									</VBox>
									<VBox renderType="Bare" class="bloco-de-politica">
										<Label text="{dados>/politicas/surcharge_comparison_policy/titulo}" labelFor="politicaComparacaoDosAcrescimos" />
										<Select id="politicaComparacaoDosAcrescimos" selectedKey="{dados>/politicas/surcharge_comparison_policy/valor}" width="100%" visible="{dados>/pode_mudar}" items="{path: 'dados>/politicas/surcharge_comparison_policy/opcoes', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										<Text text="{dados>/politicas/surcharge_comparison_policy/texto}" visible="{= !${dados>/pode_mudar} }" />
										<Text text="{dados>/politicas/surcharge_comparison_policy/ajuda}" class="nota" />
									</VBox>
								</FlexBox>
							</f:content>
						</f:Card>

						<!-- Parâmetros dos acordos (só com a permissão 14): os do credor em grade e o valor próprio de cada item na tabela; gravam sem conferência. -->
						<f:Card class="sapUiSmallMarginTop" visible="{dados>/pode_mudar}">
							<f:header><card:Header title="{i18n>financeiro.acordos}">
								<card:toolbar><Button text="{i18n>financeiro.acordos.salvar}" type="Emphasized" press=".salvarAcordos" /></card:toolbar>
							</card:Header></f:header>
							<f:content>
								<VBox renderType="Bare" width="100%">
									<Text text="{i18n>financeiro.acordos.ajuda}" class="nota sapUiSmallMarginBegin sapUiSmallMarginTop" />
									<form:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="3" columnsXL="3" labelSpanL="12" labelSpanM="12" width="100%">
										<Label text="{i18n>financeiro.acordos.juros}" />
										<Input value="{dados>/acordo/installment_rate_pct}" inputMode="Decimal" />
										<Label text="{i18n>financeiro.acordos.metodo}" />
										<Select selectedKey="{dados>/acordo/installment_method}" width="100%" items="{path: 'dados>/opcoes/metodos', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										<Label text="{i18n>financeiro.acordos.convencao}" />
										<Select selectedKey="{dados>/acordo/agreement_days_convention}" width="100%" items="{path: 'dados>/opcoes/convencoes_acordo', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										<Label text="{i18n>financeiro.acordos.baseDaMulta}" />
										<Select selectedKey="{dados>/acordo/agreement_fine_base}" width="100%" items="{path: 'dados>/opcoes/bases_acordo', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
									</form:SimpleForm>
									<Title text="{i18n>financeiro.acordos.itens}" level="H3" class="sapUiSmallMarginBegin sapUiSmallMarginTop" />
									<Table items="{path: 'dados>/acordo_itens', templateShareable: false}" fixedLayout="false">
										<columns>
											<Column><Text text="{i18n>enquadramento.item}" /></Column>
											<Column><Text text="{i18n>financeiro.acordos.juros}" /></Column>
											<Column><Text text="{i18n>financeiro.acordos.metodo}" /></Column>
											<Column><Text text="{i18n>financeiro.acordos.convencao}" /></Column>
											<Column><Text text="{i18n>financeiro.acordos.baseDaMulta}" /></Column>
										</columns>
										<items><ColumnListItem><cells>
											<Text text="{dados>nome}" wrapping="false" />
											<Input value="{dados>installment_rate_pct}" inputMode="Decimal" placeholder="{i18n>financeiro.herda}" width="8rem" />
											<Select width="100%" selectedKey="{dados>installment_method}" items="{path: 'dados>/opcoes/metodos_item', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
											<Select width="100%" selectedKey="{dados>agreement_days_convention}" items="{path: 'dados>/opcoes/convencoes_item', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
											<Select width="100%" selectedKey="{dados>agreement_fine_base}" items="{path: 'dados>/opcoes/bases_item', templateShareable: false}"><core:Item key="{dados>id}" text="{dados>nome}" /></Select>
										</cells></ColumnListItem></items>
									</Table>
								</VBox>
							</f:content>
						</f:Card>
					</VBox>
				</f:content>
			</f:DynamicPage>
		</f:beginColumnPages>
	</f:FlexibleColumnLayout>
</mvc:View>
