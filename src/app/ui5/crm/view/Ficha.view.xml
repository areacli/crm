<mvc:View controllerName="crm.controller.Ficha" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" height="100%">
	<!-- Ficha do cliente (R22; modelo Ficha): um FlexibleColumnLayout para o painel lateral da regra de ação; a primeira coluna é a ficha,
	     com o cabeçalho, o cartão Contratos (filtro da ficha), as abas e a lateral de dados. -->
	<f:FlexibleColumnLayout id="colunas" layout="OneColumn" backgroundDesign="Solid">
		<f:beginColumnPages>
			<f:DynamicPage id="pagina" toggleHeaderOnTitleClick="false" fitContent="false">
				<f:title>
					<f:DynamicPageTitle>
						<f:heading>
							<HBox alignItems="Center" wrap="Wrap" renderType="Bare">
								<Title text="{dados>/nome}" level="H2" class="sapUiSmallMarginEnd" />
								<HBox alignItems="Center" wrap="Wrap" items="{path: 'dados>/indicadores', templateShareable: false}" renderType="Bare">
									<ObjectStatus text="{dados>texto}" state="{dados>estado}" inverted="true" class="sapUiTinyMarginEnd" />
								</HBox>
							</HBox>
						</f:heading>
						<f:expandedContent><Text text="{dados>/credor}" /></f:expandedContent>
						<f:actions>
							<Button id="registrar" text="{i18n>ficha.registrarAcionamento}" type="Emphasized" visible="{dados>/pode/registrar_acionamento}" press=".registrarAcionamento" />
							<Button text="{i18n>ficha.simularAcordo}" visible="{dados>/pode/simular_acordo}" press=".simularAcordo" />
							<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>ficha.maisAcoes}" press=".maisAcoes"
								visible="{= ${dados>/pode/editar_cadastro} || ${dados>/pode/transferir_credito} || ${dados>/pode/direitos_do_titular} }" />
						</f:actions>
					</f:DynamicPageTitle>
				</f:title>
				<f:content>
					<FlexBox wrap="Wrap" alignItems="Start" renderType="Bare" class="ficha">
						<VBox renderType="Bare" class="ficha-principal">
							<VBox items="{path: 'dados>/avisos', templateShareable: false}" renderType="Bare">
								<MessageStrip text="{dados>}" type="Warning" showIcon="true" class="sapUiTinyMarginBottom" />
							</VBox>
							<f:Card class="sapUiSmallMarginBottom">
								<f:header><card:Header title="{i18n>ficha.contratos}" subtitle="{= ${dados>/contratos}.length > 1 ? ${i18n>ficha.contratos.varios} : ${i18n>ficha.contratos.um} }">
									<card:toolbar><Button text="{i18n>ficha.contratos.todos}" visible="{= !!${dados>/contrato_escolhido} }" press=".verTodosOsContratos" /></card:toolbar>
								</card:Header></f:header>
								<f:content>
									<Table id="contratos" fixedLayout="false" items="{dados>/contratos}" itemPress=".escolherContrato">
										<columns>
											<Column><Text text="{i18n>ficha.contrato}" /></Column><Column hAlign="End"><Text text="{i18n>clientes.coluna.titulos}" /></Column>
											<Column><Text text="{i18n>ficha.papel}" /></Column><Column><Text text="{i18n>ficha.clientesDoContrato}" /></Column>
											<Column><Text text="{i18n>clientes.faixa}" /></Column><Column><Text text="{i18n>clientes.coluna.enquadramento}" /></Column>
											<Column visible="{= ${dados>/contratos/0/operacoes} !== null }"><Text text="{i18n>ficha.operacoes}" /></Column>
											<Column hAlign="End"><Text text="{i18n>ficha.credito}" /></Column>
										</columns>
										<items>
											<ColumnListItem type="{= ${dados>/contratos}.length > 1 ? 'Active' : 'Inactive' }" highlight="{= ${dados>id} === ${dados>/contrato_escolhido} ? 'Information' : 'None' }">
												<cells>
													<Text text="{dados>codigo}" wrapping="false" /><Text text="{dados>titulos}" /><Text text="{dados>papel}" /><Text text="{dados>clientes}" wrapping="false" />
													<Text text="{dados>faixa}" wrapping="false" /><Text text="{dados>enquadramento}" tooltip="{dados>enquadramento_porque}" wrapping="false" />
													<HBox items="{path: 'dados>operacoes', templateShareable: false}">
														<ObjectStatus text="{dados>nome}" tooltip="{dados>razao_social}" state="Information" inverted="true" class="sapUiTinyMarginEnd" />
													</HBox>
													<Text text="{dados>credito}" wrapping="false" />
												</cells>
											</ColumnListItem>
										</items>
									</Table>
								</f:content>
							</f:Card>
							<IconTabBar id="abasDaFicha" expandable="false" selectedKey="titulos" select=".escolherAba" class="sapUiNoContentPadding" stretchContentHeight="false">
								<items>
									<IconTabFilter key="titulos" text="{i18n>ficha.aba.titulos}" count="{dados>/abas/titulos}">
										<Table fixedLayout="false" items="{dados>/titulos}" noData="{i18n>ficha.titulos.vazio}" sticky="ColumnHeaders">
											<columns>
												<Column><Text text="{i18n>ficha.numero}" /></Column>
												<Column visible="{dados>/mostrar_contrato_nos_titulos}"><Text text="{i18n>ficha.contrato}" /></Column>
												<Column><Text text="{i18n>ficha.vencimento}" /></Column>
												<Column hAlign="End"><Text text="{i18n>ficha.valor}" /></Column><Column hAlign="End"><Text text="{i18n>ficha.pago}" /></Column>
												<Column hAlign="End"><Text text="{i18n>ficha.saldo}" /></Column><Column hAlign="End"><Text text="{i18n>ficha.atraso}" /></Column>
												<Column hAlign="End"><Text text="{i18n>clientes.coluna.atualizado}" /></Column><Column><Text text="{i18n>ficha.situacao}" /></Column>
												<Column hAlign="End" width="3rem"><Text text="" /></Column>
											</columns>
											<items>
												<ColumnListItem>
													<cells>
														<HBox alignItems="Center" renderType="Bare">
															<Link text="{dados>numero}" href="{dados>endereco}" class="sapUiTinyMarginEnd" />
															<HBox items="{path: 'dados>selos', templateShareable: false}" renderType="Bare">
																<ObjectStatus text="{dados>texto}" state="{dados>estado}" inverted="true" class="sapUiTinyMarginEnd" />
															</HBox>
														</HBox>
														<Text text="{dados>contrato}" /><Text text="{dados>vencimento}" /><Text text="{dados>valor}" wrapping="false" />
														<Text text="{dados>pago}" wrapping="false" /><Text text="{dados>saldo}" wrapping="false" /><Text text="{dados>atraso}" />
														<Text text="{dados>atualizado}" wrapping="false" />
														<ObjectStatus text="{dados>situacao}" state="{dados>situacao_estado}" inverted="true" />
														<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>lista.acoes}" visible="{= !!${dados>usar_credito} }" press=".acoesDoTitulo" />
													</cells>
												</ColumnListItem>
											</items>
										</Table>
									</IconTabFilter>
									<IconTabFilter key="acionamentos" text="{i18n>ficha.aba.acionamentos}" count="{dados>/abas/acionamentos}"><core:Fragment fragmentName="crm.fragment.FichaAcionamentos" type="XML" /></IconTabFilter>
									<IconTabFilter key="promessas" text="{i18n>ficha.aba.promessas}" count="{dados>/abas/promessas}"><core:Fragment fragmentName="crm.fragment.FichaPromessas" type="XML" /></IconTabFilter>
									<IconTabFilter key="pagamentos" text="{i18n>ficha.aba.pagamentos}" count="{dados>/abas/pagamentos}"><core:Fragment fragmentName="crm.fragment.FichaPagamentos" type="XML" /></IconTabFilter>
									<IconTabFilter key="contatos" text="{i18n>ficha.aba.contatos}" count="{dados>/abas/contatos}"><core:Fragment fragmentName="crm.fragment.FichaContatos" type="XML" /></IconTabFilter>
									<IconTabFilter key="historico" text="{i18n>ficha.aba.historico}"><core:Fragment fragmentName="crm.fragment.FichaHistorico" type="XML" /></IconTabFilter>
								</items>
							</IconTabBar>
						</VBox>
						<VBox renderType="Bare" class="ficha-lateral" visible="{= !${ui>/painelAberto} }">
							<f:Card class="sapUiSmallMarginBottom">
								<f:header><card:Header title="{i18n>ficha.dados}" /></f:header>
								<f:content>
									<VBox class="pares" width="100%" renderType="Bare">
										<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{i18n>ficha.documento}" /><Text text="{dados>/dados/documento}" textAlign="End" /></HBox>
										<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{i18n>ficha.telefone}" /><Text text="{dados>/dados/telefone}" textAlign="End" /></HBox>
										<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{i18n>ficha.email}" /><Text text="{dados>/dados/email}" textAlign="End" /></HBox>
										<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{i18n>clientes.faixa}" /><Text text="{dados>/dados/faixa}" textAlign="End" /></HBox>
										<Text text="{i18n>ficha.nomeMantido}" visible="{dados>/dados/nome_mantido}" class="nota" />
									</VBox>
								</f:content>
							</f:Card>
							<f:Card class="sapUiSmallMarginBottom">
								<f:header><card:Header title="{i18n>ficha.emCobranca}" /></f:header>
								<f:content>
									<VBox class="pares" width="100%" renderType="Bare">
										<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{i18n>clientes.coluna.vencido}" /><Text text="{dados>/em_cobranca/vencido}" textAlign="End" /></HBox>
										<HBox justifyContent="SpaceBetween" width="100%" class="par" visible="{= ${dados>/em_cobranca/a_vencer} !== null }"><Label text="{i18n>clientes.coluna.aVencer}" /><Text text="{dados>/em_cobranca/a_vencer}" textAlign="End" /></HBox>
										<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{i18n>ficha.titulosEmCobranca}" /><Text text="{dados>/em_cobranca/titulos}" textAlign="End" /></HBox>
										<HBox justifyContent="SpaceBetween" width="100%" class="par"><Label text="{i18n>clientes.coluna.atualizado}" /><Text text="{dados>/em_cobranca/atualizado}" textAlign="End" /></HBox>
										<Text text="{dados>/em_cobranca/nota}" visible="{= !!${dados>/em_cobranca/nota} }" class="nota" />
									</VBox>
								</f:content>
							</f:Card>
							<f:Card id="linhaDoTempo" class="sapUiSmallMarginBottom">
								<f:header><card:Header title="{i18n>ficha.linhaDoTempo}" /></f:header>
								<f:content>
									<VBox width="100%" renderType="Bare" class="linha-do-tempo">
										<core:InvisibleText id="rotuloDoTipoDaLinha" text="{i18n>linha.filtro}" />
										<SegmentedButton id="tipoDaLinha" selectedKey="todos" selectionChange=".filtrarLinhaDoTempo" ariaLabelledBy="rotuloDoTipoDaLinha" class="sapUiSmallMarginBeginEnd">
											<items>
												<SegmentedButtonItem key="todos" text="{i18n>linha.todos}" />
												<SegmentedButtonItem key="atendimento" text="{i18n>linha.atendimento}" />
												<SegmentedButtonItem key="distribuicao" text="{i18n>linha.distribuicao}" visible="{= ${linha>/tipos}.indexOf('distribuicao') >= 0 }" />
											</items>
										</SegmentedButton>
										<List items="{linha>/eventos}" noData="{linha>/vazio}" showSeparators="Inner" class="sapUiTinyMarginTop">
											<CustomListItem>
												<VBox class="evento" renderType="Bare">
													<Text text="{linha>quando}" class="nota" />
													<HBox alignItems="Center" wrap="Wrap" renderType="Bare">
														<Title text="{linha>titulo}" level="H3" titleStyle="H6" class="sapUiTinyMarginEnd" />
														<Link text="{linha>complemento}" href="{linha>endereco}" visible="{= !!${linha>endereco} }" class="sapUiTinyMarginEnd" />
														<Text text="{linha>complemento}" visible="{= !${linha>endereco} }" class="sapUiTinyMarginEnd" />
														<ObjectStatus text="{linha>origem/nome}" tooltip="{linha>origem/razao_social}" state="Information" inverted="true" visible="{= !!${linha>origem} }" class="sapUiTinyMarginEnd" />
														<HBox items="{path: 'linha>selos', templateShareable: false}" renderType="Bare">
															<ObjectStatus text="{linha>texto}" state="{linha>estado}" inverted="true" class="sapUiTinyMarginEnd" />
														</HBox>
													</HBox>
													<Text text="{linha>detalhe}" />
													<Text text="{linha>promessa}" visible="{= !!${linha>promessa} }" />
												</VBox>
											</CustomListItem>
										</List>
										<HBox justifyContent="SpaceBetween" alignItems="Center" visible="{= ${linha>/paginas} > 1 }" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
											<Button text="{i18n>lista.anterior}" enabled="{= ${linha>/pagina} > 1 }" press=".paginaDaLinha(-1)" />
											<Text text="{linha>/pagina} de {linha>/paginas}" />
											<Button text="{i18n>lista.proxima}" enabled="{= ${linha>/pagina} &lt; ${linha>/paginas} }" press=".paginaDaLinha(1)" />
										</HBox>
									</VBox>
								</f:content>
							</f:Card>
						</VBox>
					</FlexBox>
				</f:content>
			</f:DynamicPage>
		</f:beginColumnPages>
	</f:FlexibleColumnLayout>
</mvc:View>
