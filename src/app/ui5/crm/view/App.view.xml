<mvc:View controllerName="crm.controller.App" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" displayBlock="true" height="100%">
	<!-- A raiz troca entre a entrada, a definição de senha do primeiro acesso e a casca com o menu e as abas. -->
	<VBox height="100%" renderType="Bare" fitContainer="true">
		<HBox class="demonstracao" visible="{sessao>/demonstracaoAtiva}" renderType="Bare">
			<Text text="{parts: ['i18n>demonstracao', 'sessao>/demonstracao/recriacao'], formatter: '.formatarTexto'}" />
		</HBox>
		<App id="raiz" autoFocus="true" height="100%">
			<layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
		</App>
	</VBox>
</mvc:View>
