<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!-- Rodapé das listas (P22): a contagem, página anterior e próxima, e 10, 20, 50 ou 100 por página (revisão 34). -->
	<OverflowToolbar style="Clear" class="paginacao">
		<Text text="{parts: ['i18n>lista.contagem', 'dados>/pagina', 'dados>/paginas', 'dados>/total'], formatter: '.formatarTexto'}" />
		<ToolbarSpacer />
		<Label text="{i18n>lista.porPagina}" labelFor="porPagina" />
		<Select id="porPagina" selectedKey="{= String(${filtro>/per_page} || 10) }" change=".mudarPorPagina" width="5rem">
			<core:Item key="10" text="10" /><core:Item key="20" text="20" /><core:Item key="50" text="50" /><core:Item key="100" text="100" />
		</Select>
		<Button text="{i18n>lista.anterior}" icon="sap-icon://navigation-left-arrow" enabled="{= ${dados>/pagina} > 1 }" press=".paginaAnterior" />
		<Button text="{i18n>lista.proxima}" icon="sap-icon://navigation-right-arrow" iconFirst="false" enabled="{= ${dados>/pagina} &lt; ${dados>/paginas} }" press=".proximaPagina" />
	</OverflowToolbar>
</core:FragmentDefinition>
