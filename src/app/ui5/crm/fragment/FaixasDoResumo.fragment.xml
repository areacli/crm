<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<!-- Faixas de atraso por cliente e por título (R23), só quando os credores consultados têm as mesmas faixas. -->
	<f:Card visible="{= !!${dados>/faixas_por_cliente} }">
		<f:header><card:Header title="{i18n>resumo.faixasPorCliente}">
			<card:toolbar><Button icon="sap-icon://hint" type="Transparent" tooltip="{i18n>resumo.faixasPorCliente}" press=".mostrarDefinicao" app:definicao="{i18n>resumo.faixasPorCliente.ajuda}" /></card:toolbar>
		</card:Header></f:header>
		<f:content>
			<Table fixedLayout="false" items="{dados>/faixas_por_cliente}">
				<columns><Column><Text text="{i18n>clientes.coluna.faixa}" /></Column><Column hAlign="End"><Text text="{i18n>clientes.titulo}" /></Column>
					<Column hAlign="End"><Text text="{i18n>clientes.coluna.vencido}" /></Column><Column hAlign="End"><Text text="{i18n>clientes.coluna.atualizado}" /></Column><Column><Text text="" /></Column></columns>
				<items><ColumnListItem><cells><Text text="{dados>faixa}" wrapping="false" /><Text text="{dados>quantidade}" /><Text text="{dados>vencido}" wrapping="false" /><Text text="{dados>atualizado}" wrapping="false" />
					<ProgressIndicator percentValue="{dados>proporcao}" showValue="false" height="0.5rem" width="6rem" tooltip="{dados>proporcao}%" /></cells></ColumnListItem></items>
			</Table>
		</f:content>
	</f:Card>
	<f:Card visible="{= !!${dados>/faixas_por_titulo} }">
		<f:header><card:Header title="{i18n>resumo.faixasPorTitulo}">
			<card:toolbar><Button icon="sap-icon://hint" type="Transparent" tooltip="{i18n>resumo.faixasPorTitulo}" press=".mostrarDefinicao" app:definicao="{i18n>resumo.faixasPorTitulo.ajuda}" /></card:toolbar>
		</card:Header></f:header>
		<f:content>
			<Table fixedLayout="false" items="{dados>/faixas_por_titulo}">
				<columns><Column><Text text="{i18n>clientes.coluna.faixa}" /></Column><Column hAlign="End"><Text text="{i18n>ficha.aba.titulos}" /></Column>
					<Column hAlign="End"><Text text="{i18n>clientes.coluna.vencido}" /></Column><Column hAlign="End"><Text text="{i18n>clientes.coluna.atualizado}" /></Column><Column><Text text="" /></Column></columns>
				<items><ColumnListItem><cells><Text text="{dados>faixa}" wrapping="false" /><Text text="{dados>quantidade}" /><Text text="{dados>vencido}" wrapping="false" /><Text text="{dados>atualizado}" wrapping="false" />
					<ProgressIndicator percentValue="{dados>proporcao}" showValue="false" height="0.5rem" width="6rem" tooltip="{dados>proporcao}%" /></cells></ColumnListItem></items>
			</Table>
		</f:content>
	</f:Card>
</core:FragmentDefinition>
