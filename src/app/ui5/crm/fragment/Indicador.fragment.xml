<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<!-- Um indicador do resumo: rótulo, valor, detalhe e o (i) com a definição. -->
	<f:Card>
		<f:header>
			<card:NumericHeader title="{dados>rotulo}" number="{dados>valor}" details="{= ${dados>detalhe} || ' ' }" numberSize="S">
				<card:toolbar><Button icon="sap-icon://hint" type="Transparent" tooltip="{dados>rotulo}" press=".mostrarDefinicao" app:definicao="{dados>definicao}" visible="{= !!${dados>definicao} }" /></card:toolbar>
			</card:NumericHeader>
		</f:header>
	</f:Card>
</core:FragmentDefinition>
