<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<!-- Aba Contatos (06, R124): situação, origem, motivo e, para quem tem a 12, criar, editar e mudar a situação. -->
	<VBox renderType="Bare">
		<OverflowToolbar style="Clear">
			<Title text="{i18n>ficha.aba.contatos}" level="H3" titleStyle="H5" />
			<ToolbarSpacer />
			<Button text="{i18n>ficha.criarContato}" visible="{dados>/pode/editar_cadastro}" press=".criarContato" />
		</OverflowToolbar>
		<Table items="{dados>/contatos}" itemPress=".mostrarDetalhe" customData:detalhe="contato" fixedLayout="false" noData="{i18n>ficha.contatos.vazio}">
			<columns>
				<Column><Text text="{i18n>ficha.contatos.tipo}" /></Column><Column><Text text="{i18n>ficha.contatos.contato}" /></Column>
				<Column><Text text="{i18n>ficha.situacao}" /></Column><Column><Text text="{i18n>ficha.contatos.origem}" /></Column>
				<Column><Text text="{i18n>ficha.contatos.mudanca}" /></Column><Column><Text text="{i18n>ficha.credito.motivo}" /></Column>
				<Column hAlign="End"><Text text="" /></Column>
			</columns>
			<items>
				<ColumnListItem type="Active">
					<cells>
						<Text text="{dados>tipo}" />
						<HBox alignItems="Center" renderType="Bare"><Text text="{dados>valor}" class="sapUiTinyMarginEnd" />
							<ObjectStatus text="{i18n>ficha.contatos.semDdd}" state="Warning" inverted="true" visible="{dados>sem_ddd}" /></HBox>
						<ObjectStatus text="{dados>selo/texto}" state="{dados>selo/estado}" inverted="true" />
						<Text text="{dados>origem}" /><Text text="{dados>mudanca}" /><Text text="{dados>motivo}" maxLines="1" />
						<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>lista.acoes}" press=".acoesDoContato"
							visible="{= ${dados>pode/editar} || ${dados>pode/invalidar} || ${dados>pode/nao_perturbe} || ${dados>pode/validar} }" />
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<Panel visible="{= !!${ui>/detalhes/contato} }" class="detalhe-da-linha"><Text text="{ui>/detalhes/contato/detalhe}" /></Panel>
	</VBox>
</core:FragmentDefinition>
