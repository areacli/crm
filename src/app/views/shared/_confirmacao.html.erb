<%# Confirmação de ação (design system, seção 6): o botão do bloco abre um <dialog> que diz o que vai acontecer; o botão de confirmar
    envia o formulário. Locais: titulo, mensagem, acao, url, metodo (padrão :post), variante (padrão "danger"), id. O foco inicial é "Cancelar". %>
<% variante = local_assigns.fetch(:variante, "danger") %>
<% metodo = local_assigns.fetch(:metodo, :post) %>
<button type="button" command="show-modal" commandfor="<%= id %>" data-variant="<%= local_assigns.fetch(:gatilho, "danger-outline") %>" data-size="small"><%= yield %></button>
<dialog id="<%= id %>" role="alertdialog" aria-labelledby="<%= id %>-titulo" aria-describedby="<%= id %>-mensagem">
  <header>
    <h2 id="<%= id %>-titulo"><%= titulo %></h2>
  </header>
  <div>
    <p id="<%= id %>-mensagem"><%= mensagem %></p>
  </div>
  <footer>
    <button type="button" command="close" commandfor="<%= id %>" data-variant="secondary" autofocus>Cancelar</button>
    <%= button_to acao, url, method: metodo, data: { variant: variante } %>
  </footer>
</dialog>
