<%# Paginação (P22), rodapé da tabela: a contagem à esquerda (local `unit`, opcional), anterior, página atual de N e próxima. Locais: pagination, path (lambda da página para a URL),
    unit (opcional: "Mostrando a a b de N <unidade>") e fragment (opcional: o trecho que a página troca; sem ele, `#resultado`, como os filtros, `spa/lista`). %>
<% fragment = local_assigns[:fragment] || "#resultado" %>
<% link = ->(label, page, rel) { link_to label, path.call(page), rel: rel, **(fragment ? { data: { trecho: path.call(page), trecho_alvo: fragment } } : {}) } %>
<nav class="paginacao" aria-label="Paginação">
  <% if local_assigns[:unit] %><span>Mostrando <%= number_br(pagination.first_item) %> a <%= number_br(pagination.last_item) %> de <%= number_br(pagination.total) %> <%= unit %>.</span><% end %>
  <% if pagination.previous_page %><%= link.call("Anterior", pagination.previous_page, "prev") %><% else %><span aria-disabled="true">Anterior</span><% end %>
  <span>Página <%= pagination.page %> de <%= number_br(pagination.pages) %></span>
  <% if pagination.next_page %><%= link.call("Próxima", pagination.next_page, "next") %><% else %><span aria-disabled="true">Próxima</span><% end %>
</nav>
