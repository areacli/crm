<%# Refeita pelo htmx a cada evento do WebSocket (cable:retention-changed). %>
<div id="guarda" class="pagina-em-secoes" hx-get="<%= data_retention_path(request.query_parameters) %>" hx-trigger="cable:retention-changed from:body, cable:connected from:body" hx-swap="outerHTML" hx-push-url="false">
  <section class="cartao" aria-labelledby="prazo">
    <header><h2 id="prazo">Prazo de guarda vigente</h2></header>
    <div>
      <ul>
        <% @settings.each do |setting| %>
          <li>
            <strong><%= setting.tenant.name %>:</strong> <%= setting.retention_years %> <%= setting.retention_years == 1 ? "ano" : "anos" %>, contados do fim da última relação em aberto.
            <% if @can_change_period.include?(setting.tenant_id) %>
              <%= link_to "Alterar nos dados do credor", settings_tenant_registry_path(anchor: "credor-#{setting.tenant_id}") %>
            <% else %>
              <small>O prazo é definido nos dados do credor.</small>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <section class="cartao" aria-labelledby="previstos">
    <header><h2 id="previstos">Anonimização prevista nos próximos 30 dias</h2><p>Quem aparece aqui é anonimizado na data indicada, sem volta. Para conservar, retenha com o motivo.</p></header>
    <% if @forecast.total.zero? %>
      <p class="vazio">Ninguém será anonimizado nos próximos 30 dias.</p>
    <% else %>
      <div class="tabela" tabindex="0">
        <table>
          <caption class="apenas-leitor-de-tela">Clientes com anonimização prevista</caption>
          <thead><tr><% if @several_tenants %><th scope="col">Credor</th><% end %><th scope="col">Cliente</th><th scope="col">Fim da última relação</th><th scope="col">Anonimização em</th><th scope="col">Reter</th></tr></thead>
          <tbody>
            <% @forecast.records.each do |customer| %>
              <tr>
                <% if @several_tenants %><td><%= customer.tenant.name %></td><% end %>
                <th scope="row"><% if @can_view_customer.include?(customer.tenant_id) %><%= link_to customer.name, customer_path(customer.id) %><% else %><%= customer.name %><% end %></th>
                <td><%= date_br(customer.attributes["ended_on"]) %></td>
                <td><%= date_br(customer.attributes["due_on"]) %></td>
                <td>
                  <details>
                    <summary>Reter</summary>
                    <%= form_with scope: :retention, url: customer_retention_path(customer.id), method: :post, html: { "hx-boost": "false" } do |form| %>
                      <div class="campo"><%= form.label :reason, "Motivo (por exemplo, ação judicial em curso)", for: "reter-#{customer.id}" %><%= form.text_field :reason, id: "reter-#{customer.id}", required: true, maxlength: 300 %></div>
                      <div class="acoes"><button type="submit">Reter cliente</button></div>
                    <% end %>
                  </details>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/paginacao", pagination: @forecast, path: ->(page) { data_retention_path(request.query_parameters.merge(page: page)) } %>
    <% end %>
  </section>

  <section class="cartao" aria-labelledby="retidos">
    <header><h2 id="retidos">Retidos</h2><p>A tarefa diária não anonimiza quem está aqui, mesmo que tenha voltado a ter relação em aberto.</p></header>
    <% if @retained.total.zero? %>
      <p class="vazio">Nenhum cliente retido.</p>
    <% else %>
      <div class="tabela" tabindex="0">
        <table>
          <caption class="apenas-leitor-de-tela">Clientes retidos</caption>
          <thead><tr><% if @several_tenants %><th scope="col">Credor</th><% end %><th scope="col">Cliente</th><th scope="col">Motivo</th><th scope="col">Retido por</th><th scope="col">Desfazer</th></tr></thead>
          <tbody>
            <% @retained.records.each do |customer| %>
              <tr>
                <% if @several_tenants %><td><%= customer.tenant.name %></td><% end %>
                <th scope="row"><% if @can_view_customer.include?(customer.tenant_id) %><%= link_to customer.name, customer_path(customer) %><% else %><%= customer.name %><% end %></th>
                <td><%= customer.retained_reason %></td>
                <td><%= customer.retained_by&.name || "—" %> em <%= date_br(customer.retained_at.to_date) %></td>
                <td>
                  <details>
                    <summary>Desfazer</summary>
                    <%= form_with scope: :retention, url: customer_retention_path(customer), method: :delete, html: { "hx-boost": "false" } do |form| %>
                      <div class="campo"><%= form.label :reason, "Motivo", for: "desfazer-#{customer.id}" %><%= form.text_field :reason, id: "desfazer-#{customer.id}", required: true, maxlength: 300 %></div>
                      <div class="acoes"><button type="submit">Desfazer retenção</button></div>
                    <% end %>
                  </details>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/paginacao", pagination: @retained, path: ->(page) { data_retention_path(request.query_parameters.merge(retained_page: page)) } %>
    <% end %>
  </section>

  <section class="cartao" aria-labelledby="execucoes">
    <header><h2 id="execucoes">Últimas execuções da tarefa diária</h2></header>
    <% if @runs.empty? %>
      <p class="vazio">A tarefa ainda não rodou.</p>
    <% else %>
      <div class="tabela" tabindex="0">
        <table>
          <caption class="apenas-leitor-de-tela">Últimas execuções</caption>
          <thead><tr><th scope="col">Quando</th><% if @several_tenants %><th scope="col">Credor</th><% end %><th scope="col">Resultado</th><th scope="col" data-numerico>Anonimizados</th><th scope="col" data-numerico>Falhas</th></tr></thead>
          <tbody>
            <% @runs.each do |run| %>
              <tr>
                <th scope="row"><%= datetime_br(run.started_at) %></th>
                <% if @several_tenants %><td><%= run.tenant&.name %></td><% end %>
                <td><%= t("titular.run_status.#{run.status}") %><%= " — #{run.note}" if run.note.present? %><%= " (#{run.error_kind})" if run.error_kind.present? %></td>
                <td data-numerico><%= number_br(run.processed) %></td>
                <td data-numerico><%= number_br(run.failed) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>
