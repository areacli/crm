<%# Página de referência na SPA (design system, 18.5): os componentes do catálogo nos seus estados, com respostas de mentira para a espera (só em desenvolvimento e teste). %>
<div class="referencia" data-titulo="Design system">
  <%= pagina "Design system", subtitulo: "Componentes e estados da SPA em EasyUI (design system, revisão 18)" %>
  <div class="referencia-corpo">
    <section class="cartao">
      <header><h2>Botões</h2></header>
      <div class="exemplos">
        <button type="button">Salvar</button>
        <button type="button" data-variant="secondary">Cancelar</button>
        <button type="button" data-variant="danger">Excluir</button>
        <a class="botao" data-variant="danger-outline" href="#">Anonimizar</a>
        <button type="button" disabled>Salvar</button>
        <button type="button" class="carregando" disabled>Salvar</button>
        <button type="button" data-size="small" data-variant="secondary">Ver</button>
      </div>
    </section>

    <section class="cartao">
      <header><h2>Situações e avisos</h2></header>
      <div>
        <p class="exemplos"><% { success: "Pago", warning: "Divergência", danger: "Vencido", info: "Em acordo", neutral: "Retirado" }.each do |tom, texto| %><%= situacao texto, tom: tom %><% end %></p>
        <% %i[info success warning danger].each do |tom| %><%= aviso(tom: tom) { tag.p "Aviso no tom #{tom}." } %><% end %>
        <p>Definição em popover <%= informacao "valor atualizado", "Principal corrigido, multa, juros e honorários até hoje." %></p>
      </div>
    </section>

    <section class="cartao">
      <header><h2>Campos</h2></header>
      <div><form class="grupo-de-campos" action="#">
        <div class="campo"><label for="ref-texto">Texto</label><input type="text" id="ref-texto" value="Maria Silva"></div>
        <div class="campo"><label for="ref-escolha">Lista de escolha</label><select id="ref-escolha"><option>Telefone</option><option>E-mail</option><option>WhatsApp</option></select></div>
        <div class="campo"><label for="ref-data">Data</label><input type="date" id="ref-data" name="ref_data" value="2026-11-10"></div>
        <div class="campo"><label for="ref-numero">Número</label><input type="number" id="ref-numero" value="12"></div>
        <div class="campo"><label for="ref-area">Texto longo</label><textarea id="ref-area" rows="2">Observação</textarea></div>
        <div class="campo"><label><input type="checkbox" checked> Salvar este contato no cadastro</label></div>
      </form></div>
    </section>

    <section class="cartao">
      <header><h2>Edição inline (7.1)</h2></header>
      <div><p>Nome do cliente: <%= campo_inline "Maria Silva", rotulo: "Nome", url: design_system_inline_path, nome: "nome" %></p><p><small>Vazio, o servidor recusa e a mensagem aparece junto ao campo.</small></p></div>
    </section>

    <section class="cartao">
      <header><h2>Cálculo à vista (7.2)</h2></header>
      <div>
        <%= form_with url: design_system_calculo_path, **calculo_a_vista(design_system_calculo_path), class: "grupo-de-campos" do %>
          <div class="campo"><label for="ref-a">Valor A</label><input type="number" id="ref-a" name="a" value="10"></div>
          <div class="campo"><label for="ref-b">Valor B</label><input type="number" id="ref-b" name="b" value="5"></div>
          <div class="campo"><label for="ref-demora">Demora do servidor (s)</label><input type="number" id="ref-demora" name="demora" value="1"></div>
          <div class="campo"><label><input type="checkbox" name="falhar" value="1"> Falhar</label></div>
          <div class="campo"><button type="button" data-depende-do-calculo>Usar o resultado</button></div>
        <% end %>
        <%= resultado_do_calculo do %><dl class="kpis"><%= kpi "Soma", "15,00" %></dl><% end %>
      </div>
    </section>

    <section class="cartao">
      <header><h2>Janela, diálogo e espera (7.2)</h2></header>
      <div class="exemplos">
        <%= link_to "Abrir janela", design_system_janela_path, class: "botao", data: { variant: "secondary" } %>
        <%= abrir_painel "Abrir diálogo", design_system_dialogo_path, variante: "secondary" %>
        <%= link_to "Ver resposta em 4 s", design_system_lento_path(segundos: 4), class: "botao", data: { variant: "secondary" } %>
        <%= link_to "Ver falha", design_system_lento_path(falhar: 1), class: "botao", data: { variant: "secondary" } %>
      </div>
    </section>

    <section class="cartao">
      <header><h2>Grade, selos e menu da linha</h2></header>
      <div class="referencia-grade">
        <%= grade linhas: [
              { cliente: { texto: "Maria Silva", href: "#", selos: [ { texto: "Em acordo", tom: "info" } ] }, valor: "R$ 1.814,12", situacao: [ { texto: "Vencido", tom: "danger" } ], acoes: [ { texto: "Abrir diálogo", href: design_system_dialogo_path, dialogo: true } ] },
              { cliente: { texto: %q(<b data-invadido>Nome com marcação</b>) }, valor: "R$ 0,00", situacao: [ { texto: "Pago", tom: "success" } ], acoes: [] }
            ], colunas: [ { campo: "cliente", titulo: "Cliente", largura: 260, tipo: "rico" }, { campo: "valor", titulo: "Valor", largura: 110, tipo: "numero" },
                          { campo: "situacao", titulo: "Situação", largura: 110, tipo: "selos" }, { campo: "acoes", titulo: "", largura: 44, tipo: "acoes" } ] %>
      </div>
    </section>

    <section class="cartao">
      <header><h2>Abas da página e campo em linha</h2></header>
      <div>
        <%= abas_da_pagina "Exemplo de abas", [ [ "Títulos", "#", 4, true ], [ "Acionamentos", "#", 3, false ], [ "Histórico", "#", nil, false ] ] %>
        <%= campo_em_linha "Dias para quebrar", "ref-dias", tamanho: "numero", ajuda: "Contados do vencimento." do %><input type="number" id="ref-dias" value="30"><% end %>
      </div>
    </section>
  </div>
</div>
