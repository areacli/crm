<% content_for :title, "Sistemas" %>
<%= pagina "Sistemas", subtitulo: "De onde vêm contratos, títulos e pagamentos de cada credor. Toda importação entra por um sistema, e o batimento vale só dentro dele." do %>
  <%= abrir_painel "Criar sistema", new_source_system_path %>
<% end %>
<%= render "settings/modelo" %>

<form class="filtros" role="search" action="<%= source_systems_path %>" method="get">
  <div class="campo">
    <label for="q" class="apenas-leitor-de-tela">Buscar por nome</label>
    <input type="search" id="q" name="busca" value="<%= params[:busca] %>" autocomplete="off" placeholder="Nome do sistema">
  </div>
  <% if @several_tenants %>
    <div class="campo">
      <label for="tenant">Credor</label>
      <select id="tenant" name="credor">
        <option value="">Todos</option>
        <%= options_for_select(@tenants, params[:credor]) %>
      </select>
    </div>
  <% end %>
  <div class="campo">
    <label for="per_page" class="apenas-leitor-de-tela">Por página</label>
    <select id="per_page" name="por_pagina"><%= options_for_select(Pagination::PER_PAGE_OPTIONS, @pagination.per_page) %></select>
  </div>
  <button type="submit" data-variant="secondary">Buscar</button>
</form>

<%= render "source_systems/result" %>
