<% content_for :title, "Simular acordo · #{@customer.name}" %>
<%# Simulação do acordo (11, R211 a R216): títulos, forma, descontos, entrada e parcelas à esquerda, e o resultado à direita, refeito à vista a cada mudança
    (design system, 7.2); "Criar proposta" grava (R215) e só vale com o cálculo da tela pronto. Na SPA (decisão 0028), aba própria. %>
<% form = @form || {} %>
<% segment_hint = "O limite do seu perfil em cada componente aparece junto do campo: acima dele, a proposta nasce pendente de aprovação." %>
<%= pagina "Simular acordo", subtitulo: "#{@customer.name} · #{@customer.tenant.name}" %>
<% if @create_problem %><%= aviso(tom: :danger) { tag.p @create_problem } %><% end %>

<% recalcular = calculo_a_vista(customer_agreement_simulations_path(@customer)) %>
<div class="simulacao" data-titulo="Simular acordo · <%= @customer.name %>" data-refazer-no-erro>
<%= form_with scope: :agreement, url: customer_agreements_path(@customer), method: :post, class: "simulacao-formulario", html: recalcular do |f| %>
  <section class="cartao" aria-labelledby="titulos-do-acordo">
    <header><h2 id="titulos-do-acordo">Títulos do acordo</h2><%= informacao "títulos do acordo", "De 1 a 100 títulos do cliente em cobrança, vencidos ou a vencer. O acordo parte do valor atualizado de cada um, por componente.", "definicao-titulos-do-acordo" %></header>
    <div>
      <% if @bills.empty? %>
        <p class="vazio">Este cliente não tem título em cobrança.</p>
      <% else %>
        <div class="tabela" tabindex="0">
          <table data-detalhes>
            <caption class="apenas-leitor-de-tela">Títulos em cobrança do cliente</caption>
            <thead><tr><th scope="col"><%= alternar_todos_os_detalhes %>Escolher</th><th scope="col">Título</th><th scope="col">Contrato</th><th scope="col">Vencimento</th><th scope="col" data-numerico>Saldo</th><th scope="col">Situação</th></tr></thead>
            <tbody>
              <% @bills.each do |bill| %>
                <% holder = @held[bill.id] %>
                <% why = @ineligible&.dig(bill.id) %>
                <% blocked = (holder && !holder.proposal?) || why.present? %>
                <% detail = why.present? || holder || !bill.kind_common? %>
                <% detail_id = "detalhe-simulacao-#{bill.id}" %>
                <tr>
                  <td>
                    <% if detail %><%= alternar_detalhe(detail_id, "título #{bill.number}") %><% end %>
                    <%= check_box_tag "agreement[bill_ids][]", bill.id, Array(form[:bill_ids]).map(&:to_s).include?(bill.id.to_s), id: "titulo-#{bill.id}", disabled: blocked, "aria-label": "Incluir o título #{bill.number}" %>
                  </td>
                  <th scope="row"><label for="titulo-<%= bill.id %>"><%= bill.number %></label></th>
                  <td><%= bill.contract.label %></td>
                  <td><%= date_br(bill.due_date) %></td>
                  <td data-numerico><%= money(bill.balance_cents) %></td>
                  <td>
                    <% if why %>
                      <%= situacao "Não entra", tom: :warning %>
                    <% elsif holder %>
                      <%= situacao holder.proposal? ? "Em proposta" : "Em acordo", tom: :warning %>
                    <% elsif bill.due_date < Date.current %><%= situacao "Vencido", tom: :danger %>
                    <% else %><%= situacao "A vencer", tom: :info %><% end %>
                  </td>
                </tr>
                <% if detail %>
                  <%= detalhe_da_linha(detail_id, 6) do %>
                    <% unless bill.kind_common? %><p><%= bill.kind_break? ? "Título da quebra." : (bill.kind_reversal? ? "Título de estorno." : safe_join([ "Título de acordo ", link_to(bill.agreement.number, agreement_path(bill.agreement)), "." ])) %></p><% end %>
                    <% if why %><p><%= t("agreements.eligibility.#{why}", number: bill.number) %></p>
                    <% elsif holder %><p><%= holder.proposal? ? "Em proposta" : "Em acordo" %> <%= link_to holder.number, agreement_path(holder) %>.</p><% end %>
                  <% end %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if @held.values.any?(&:proposal?) %>
          <div class="campo">
            <label><%= check_box_tag "agreement[replace]", "1", form[:replace].to_s == "1" %> Substituir a proposta vigente sobre os títulos escolhidos</label>
            <small>A proposta anterior é cancelada com o motivo "substituída por" este número, e os títulos dela ficam livres (R218).</small>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="cartao" aria-labelledby="termos-do-acordo">
    <header><h2 id="termos-do-acordo">Descontos, entrada e parcelas</h2><%= informacao "termos do acordo", segment_hint, "definicao-termos-do-acordo" %></header>
    <div>
      <h3 class="subtitulo-do-formulario">Descontos por componente</h3>
      <div class="grupo-de-campos descontos">
        <% shown = Agreements::Caps::COMPONENTS.reverse.reject { |component| Agreements::INHERITED.include?(component) && @bills.none? { |bill| bill.kind_agreement? || bill.kind_break? } } %>
        <% shown.each do |component| %>
          <div class="campo">
            <%= label_tag "desconto-#{component}", "Desconto em #{component_name(component).downcase} (%)" %>
            <%= valor_com_deslizante "agreement[discounts][#{component}]", form.dig(:discounts, component), id: "desconto-#{component}", maximo: 10_000, descrito_por: "ajuda-desconto-#{component}", unidade: "percentual" %>
            <small id="ajuda-desconto-<%= component %>"><%= ajuda_do_desconto(@quote&.limits, component) %></small>
            <% if @field == "discounts_#{component}" %><small data-erro><%= @problem %></small><% end %>
          </div>
        <% end %>
      </div>
      <h3 class="subtitulo-do-formulario">Entrada e parcelas</h3>
      <% limits = @quote&.limits %>
      <%# Zero parcelas é parcela única: sem entrada e sem dia das parcelas (revisão 12). %>
      <% so_parcelado = { mostrar_se_campo: "agreement[installments]", mostrar_se_valor: "!0" } %>
      <div class="grupo-de-campos">
        <%= tag.div class: "campo campo-largo", data: so_parcelado do %>
          <%= label_tag "entrada-valor", "Valor da entrada" %>
          <%= valor_com_deslizante "agreement[down_payment]", form[:down_payment], id: "entrada-valor", minimo: limits&.down_min, maximo: limits&.down_max, descrito_por: "ajuda-entrada", auto: [ "agreement[down_payment_auto]", form[:down_payment_auto] ] %>
          <small id="ajuda-entrada"><%= ajuda_da_entrada(limits) %></small>
          <% if @field == "down_payment" %><small data-erro><%= @problem %></small><% end %>
        <% end %>
        <div class="campo">
          <%= label_tag "entrada-vencimento", "Vencimento da #{nome_da_primeira(@quote ? @quote.installments.size : form[:installments]).downcase}", id: "rotulo-vencimento" %>
          <%= date_field_tag "agreement[down_payment_on]", form[:down_payment_on], id: "entrada-vencimento" %>
          <small>Do dia útil seguinte até o prazo do item do enquadramento.</small>
          <% if @field == "down_payment_on" %><small data-erro><%= @problem %></small><% end %>
        </div>
        <div class="campo">
          <%= label_tag "parcelas", "Parcelas" %>
          <%= select_tag "agreement[installments]", options_for_select(opcoes_de_parcelas(limits, form[:installments]), form[:installments].to_i), id: "parcelas" %>
          <small id="ajuda-parcelas"><%= ajuda_das_parcelas(limits) %></small>
        </div>
        <%= tag.div class: "campo", data: so_parcelado do %>
          <%= label_tag "dia", "Dia de vencimento das parcelas" %>
          <%= number_field_tag "agreement[day]", form[:day], id: "dia", min: 1, max: 28 %>
          <small>De 1 a 28; a 1ª parcela vence no mês seguinte à entrada.</small>
        <% end %>
      </div>
      <% offers = Agreements::CreditUse.available_by_contract(@customer.tenant.setting, @bills) %>
      <% if offers.any? %>
        <div class="grupo-de-campos">
          <div class="campo campo-largo" data-some-sem-maximo>
            <%= label_tag "credito", "Crédito do contrato a usar" %>
            <%= valor_com_deslizante "agreement[credit]", form[:credit], id: "credito", minimo: 0, maximo: limits&.credit_max, descrito_por: "ajuda-credito" %>
            <small id="ajuda-credito">
              Disponível: <%= safe_join(offers.map { |contract, cents| "#{contract.label}, #{money(cents)}" }, "; ") %>.
              Entra como <%= Agreements::Policies.value(@customer.tenant.setting, "credit_entry") == "rebate" ? "abatimento do valor do acordo" : "pagamento da entrada" %>.
            </small>
            <% if @field == "credit" %><small data-erro><%= @problem %></small><% end %>
          </div>
        </div>
      <% end %>
      <% if @field == "mode" || @field == "bill_ids" %><%= aviso(tom: :danger) { tag.p @problem } %><% end %>
      <div class="acoes" data-rodape>
        <%# Na SPA, a simulação se refaz sozinha; "Criar proposta" espera o cálculo da tela (design system, 7.2). %>
        <%= tag.button "Criar proposta", type: "submit", data: { depende_do_calculo: true } %>
      </div>
    </div>
  </section>
<% end %>

<aside class="simulacao-resultado" aria-label="Resultado da simulação"><%= resultado_do_calculo { render "customers/agreement_simulations/result" } %></aside>
</div>
