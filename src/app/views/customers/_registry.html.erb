<%# Contatos do cliente (06, R124): até três válidos no topo; "ver todos" traz todos, com situação, origem, motivo e data, e as ações de edição
    para quem tem a permissão 12 no credor. Funciona sem JavaScript. Locais: customer, top, listed, can_edit, history, contacts_by_id. %>
<section class="cartao" id="contatos" aria-labelledby="contatos-titulo">
  <header>
    <div><h2 id="contatos-titulo">Contatos</h2><p>Os contatos válidos de <%= customer.name %>, com o que já se sabe de cada um.</p></div>
  </header>
  <div>
    <% if top.empty? %>
      <p class="vazio">Nenhum contato válido cadastrado.</p>
    <% else %>
      <ul class="contatos">
        <% top.each do |contact| %>
          <li><strong><%= contact_kind(contact.kind) %>:</strong> <%= contact.value %><% if contact.no_area_code? %> <small>(sem DDD)</small><% end %></li>
        <% end %>
      </ul>
    <% end %>

    <% if listed.any? %>
      <details id="todos-os-contatos">
        <summary>Ver todos (<%= number_br(listed.size) %>)<%= " e editar" if can_edit %></summary>
        <div class="tabela">
          <table>
            <caption class="apenas-leitor-de-tela">Todos os contatos do cliente</caption>
            <thead>
              <tr>
                <th scope="col">Tipo</th><th scope="col">Contato</th><th scope="col">Situação</th><th scope="col">Origem</th>
                <th scope="col">Última mudança</th><th scope="col">Motivo</th>
              </tr>
            </thead>
            <tbody>
              <% listed.each do |contact| %>
                <tr id="contato-<%= contact.id %>">
                  <td><%= contact_kind(contact.kind) %></td>
                  <th scope="row"><%= contact.value %><% if contact.no_area_code? %><small>sem DDD</small><% end %></th>
                  <td><%= contact_status(contact) %><% if contact.kept_by_tenant? %><small>mantido pelo credor</small><% end %></td>
                  <td><%= contact_origin(contact.origin) %><% if contact.seen_in_import_at %><small>veio na carga de <%= date_br(contact.seen_in_import_at.to_date) %></small><% end %></td>
                  <td><%= date_br(contact.updated_at.to_date) %><small><%= contact.updated_by&.name || "carga" %></small></td>
                  <td><%= contact.reason.presence || "—" %><% if contact.do_not_disturb_on %><small>pedido em <%= date_br(contact.do_not_disturb_on) %></small><% end %></td>
                </tr>
                  <% if can_edit %>
                <tr id="editar-contato-<%= contact.id %>">
                  <td colspan="6">
                      <details>
                        <summary>Editar<span class="apenas-leitor-de-tela"> o contato <%= contact.value %></span></summary>
                        <div class="duas-colunas">
                        <% unless contact.status_invalid? %>
                          <%= form_with scope: :contact, url: customer_contact_path(customer, contact), method: :patch, namespace: "corrigir-#{contact.id}", html: { "hx-boost": "false" } do |form| %>
                            <%= render "customers/contact_fields", form: form, kind: contact.kind, contact: contact %>
                            <div class="acoes"><button type="submit" data-size="small">Corrigir contato</button></div>
                          <% end %>
                          <%= form_with scope: :status, url: customer_contact_status_path(customer, contact), method: :patch, namespace: "invalidar-#{contact.id}", html: { "hx-boost": "false" } do |form| %>
                            <%= form.hidden_field :status, value: "invalid" %>
                            <div class="campo"><%= form.label :reason, "Motivo" %><%= form.text_field :reason, required: true, maxlength: 300 %></div>
                            <div class="acoes"><button type="submit" data-variant="danger-outline" data-size="small">Marcar como inválido</button></div>
                          <% end %>
                        <% end %>
                        <% if contact.status_valid? %>
                          <%= form_with scope: :status, url: customer_contact_status_path(customer, contact), method: :patch, namespace: "perturbe-#{contact.id}", html: { "hx-boost": "false" } do |form| %>
                            <%= form.hidden_field :status, value: "do_not_disturb" %>
                            <div class="campo"><%= form.label :requested_on, "Data do pedido do cliente" %><%= form.date_field :requested_on, value: Date.current.iso8601, max: Date.current.iso8601, required: true %></div>
                            <div class="acoes"><button type="submit" data-variant="secondary" data-size="small">Marcar não perturbe</button></div>
                          <% end %>
                        <% else %>
                          <%= form_with scope: :status, url: customer_contact_status_path(customer, contact), method: :patch, namespace: "validar-#{contact.id}", html: { "hx-boost": "false" } do |form| %>
                            <%= form.hidden_field :status, value: "valid" %>
                            <div class="campo"><%= form.label :reason, "Motivo" %><%= form.text_field :reason, required: true, maxlength: 300 %></div>
                            <div class="acoes"><button type="submit" data-variant="secondary" data-size="small">Voltar a válido</button></div>
                          <% end %>
                        <% end %>
                        </div>
                      </details>
                  </td>
                </tr>
                  <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </details>
    <% end %>

    <% if can_edit %>
      <details id="criar-contato">
        <summary>Criar contato</summary>
        <%= form_with scope: :contact, url: customer_contacts_path(customer), namespace: "novo", html: { "hx-boost": "false" } do |form| %>
          <div class="campo">
            <%= form.label :kind, "Tipo" %>
            <%= form.select :kind, CustomerContact.kinds.keys.map { |kind| [ contact_kind(kind), kind ] }, {}, required: true %>
            <small>Telefone e e-mail usam o campo abaixo; para endereço, preencha os campos do endereço.</small>
          </div>
          <div class="campo"><%= form.label :value, "Telefone ou e-mail" %><%= form.text_field :value, maxlength: 254, autocomplete: "off" %></div>
          <fieldset>
            <legend>Endereço</legend>
            <div class="grupo-de-campos">
              <div class="campo"><%= form.label :street, "Logradouro" %><%= form.text_field :street, maxlength: 200 %></div>
              <div class="campo"><%= form.label :number, "Número" %><%= form.text_field :number, maxlength: 20 %></div>
              <div class="campo"><%= form.label :complement, "Complemento" %><%= form.text_field :complement, maxlength: 100 %></div>
              <div class="campo"><%= form.label :district, "Bairro" %><%= form.text_field :district, maxlength: 100 %></div>
              <div class="campo"><%= form.label :city, "Cidade" %><%= form.text_field :city, maxlength: 100 %></div>
              <div class="campo"><%= form.label :state, "UF" %><%= form.select :state, Registry::Normalizer::UFS, include_blank: true %></div>
              <div class="campo"><%= form.label :zip, "CEP" %><%= form.text_field :zip, maxlength: 9, inputmode: "numeric" %></div>
            </div>
          </fieldset>
          <div class="acoes"><button type="submit">Criar contato</button></div>
        <% end %>
      </details>
    <% end %>

    <% if history.any? %>
      <details id="historico-do-cadastro">
        <summary>Histórico do cadastro (<%= number_br(history.size) %>)</summary>
        <ul class="contatos">
          <% history.each do |change| %>
            <li>
              <%= registry_change_text(change, contacts_by_id) %>
              <small><%= datetime_br(change.occurred_at) %> · <%= change.user&.name || "sistema" %> · <%= change.origin.present? ? contact_origin(change.origin) : "carga" %></small>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </div>
</section>
