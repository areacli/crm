<%# Aba Títulos da ficha: os títulos do cliente (o cartão Contratos fica acima das abas, revisão 28). Ações por linha no menu ⋯ (usar crédito abre o painel). Sem detalhe na linha
    (padrões de interface, revisão 27): os selos dizem o que prende o título, e o número leva à página dele, com os componentes, a origem e a memória de cálculo. %>
<%# A coluna "Contrato" só aparece quando informa algo: mais de um contrato e nenhum escolhido (padrões de interface, revisão 21). %>
<% show_contract = @all_contracts.size > 1 && !@contract %>
<section class="cartao" aria-labelledby="titulos">
  <header><h2 id="titulos">Títulos</h2></header>
  <% if @bills.empty? %>
    <p class="vazio">Este cliente não tem títulos.</p>
  <% else %>
    <div class="tabela" tabindex="0">
      <table>
        <caption class="apenas-leitor-de-tela">Títulos do cliente</caption>
        <thead>
          <tr>
            <th scope="col">Número</th><% if show_contract %><th scope="col">Contrato</th><% end %><th scope="col">Vencimento</th>
            <th scope="col" data-numerico>Valor</th><th scope="col" data-numerico>Pago</th><th scope="col" data-numerico>Saldo</th>
            <th scope="col" data-numerico>Atraso (dias)</th><th scope="col" data-numerico>Atualizado</th><th scope="col">Situação</th><th scope="col"><span class="apenas-leitor-de-tela">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <% @bills.each do |bill| %>
            <% valuation = bill.active? ? @valuations[bill.id] : nil %>
            <% can_use = @can_use_credit && Agreements::CreditOnBill.usable?(bill) && @credit_totals.fetch(bill.contract_id, 0).positive? %>
            <% held = @held_bills[bill.id] %>
            <% held_agreement = (@held_by_agreement&.dig(bill.id) unless bill.renegotiated?) %>
            <% discrepancy = @open_discrepancies.include?(bill.id) %>
            <tr>
              <th scope="row">
                <%= link_to bill.number, bill_path(bill) %>
                <% if held %><%= situacao "Em promessa", tom: :info %><% end %>
                <% if held_agreement %><%= situacao held_agreement.proposal? ? "Em proposta" : "Em acordo", tom: :info %><% end %>
                <% if discrepancy %><%= situacao "Divergência", tom: :warning %><% end %>
              </th>
              <% if show_contract %><td><%= bill.contract.code.presence || "—" %></td><% end %>
              <td><%= date_br(bill.due_date) %></td>
              <td data-numerico><%= money(bill.amount_cents) %></td>
              <td data-numerico><%= money(bill.paid_cents) %></td>
              <td data-numerico><%= money(bill.balance_cents) %></td>
              <td data-numerico><%= bill.active? && bill.due_date < @today ? number_br(bill.days_overdue(@today)) : "—" %></td>
              <td data-numerico><%= valuation ? money(valuation.total_cents) : "—" %></td>
              <td>
                <% if bill.withdrawn? %><%= situacao "Retirado", tom: :neutral %>
                <% elsif bill.renegotiated? %><%= situacao "Renegociado", tom: :neutral %>
                <% elsif bill.scheduled? %><%= situacao "Aguardando efetivação", tom: :info %>
                <% elsif bill.canceled? %><%= situacao "Cancelado", tom: :neutral %>
                <% elsif bill.paid? %><%= situacao "Pago", tom: :success %>
                <% elsif bill.due_date < @today %><%= situacao "Vencido", tom: :danger %>
                <% else %><%= situacao "A vencer", tom: :info %><% end %>
              </td>
              <td data-acoes>
                <% if can_use %>
                  <%= menu_de_linha("titulo-#{bill.id}", "Ações do título #{bill.number}") do %>
                    <%= abrir_painel "Usar crédito (disponível #{money(@credit_totals[bill.contract_id])})", new_customer_credit_use_path(@customer, bill_id: bill.id) %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

