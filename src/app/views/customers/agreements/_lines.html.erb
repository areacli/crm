<%# Propostas e acordos do cliente no cabeçalho da ficha (11, R241, P17): uma proposta ou acordo por linha (padrões de interface, revisão 25; antes, as propostas iam juntas
    numa frase), com os títulos e a validade no detalhe. Refeita a cada evento do WebSocket. Locais: customer, agreements. %>
<div id="acordos" hx-get="<%= customer_agreements_path(customer) %>" hx-trigger="cable:agreements-changed from:body, cable:connected from:body" hx-swap="outerHTML" hx-target="this">
  <% if agreements.any? %>
    <div class="tabela" tabindex="0">
      <table data-detalhes>
        <caption class="apenas-leitor-de-tela">Propostas e acordos em andamento do cliente</caption>
        <thead>
          <tr>
            <th scope="col"><%= alternar_todos_os_detalhes %>Acordo</th><th scope="col">Situação</th><th scope="col" data-numerico>Valor</th>
            <th scope="col" data-numerico>Entrada</th><th scope="col">Data da entrada</th><th scope="col" data-numerico>Parcelas</th>
          </tr>
        </thead>
        <tbody>
          <% agreements.each do |agreement| %>
            <% detail_id = "detalhe-acordo-#{agreement.id}" %>
            <tr>
              <th scope="row"><%= alternar_detalhe(detail_id, "acordo #{agreement.number}") %><%= link_to agreement.number, agreement_path(agreement) %></th>
              <td><%= agreement_state(agreement) %></td>
              <td data-numerico><%= money(agreement.value_cents) %></td>
              <td data-numerico><%= money(agreement.down_payment_cents) %></td>
              <td><%= date_br(agreement.down_payment_due) %></td>
              <td data-numerico><%= agreement.installments_count.positive? ? agreement.installments_count : "—" %></td>
            </tr>
            <%= detalhe_da_linha(detail_id, 6) do %>
              <p>Títulos <%= agreement_bill_numbers(agreement) %>.<% if agreement.proposal? %> Proposta <%= t("agreements.states.#{agreement.state}").downcase %>, vale até <%= date_br(agreement.valid_until) %>.<% end %></p>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="vazio">Nenhuma proposta ou acordo em andamento.</p>
  <% end %>
</div>
