<%# Histórico dos acordos do cliente (11, R241): montagem, aprovação, aceite, cancelamento. Locais: customer, events. %>
<section class="cartao" aria-labelledby="historico-de-acordos">
  <header><div><h2 id="historico-de-acordos">Histórico dos acordos</h2><p>Propostas e acordos do cliente, do mais recente ao mais antigo.</p></div></header>
  <div class="tabela">
    <table>
      <caption class="apenas-leitor-de-tela">Eventos dos acordos do cliente</caption>
      <thead><tr><th scope="col">Quando</th><th scope="col">Acordo</th><th scope="col">O que aconteceu</th><th scope="col">Quem</th></tr></thead>
      <tbody>
        <% events.each do |event| %>
          <tr>
            <td><%= datetime_br(event.occurred_at) %></td>
            <th scope="row"><%= link_to event.agreement.number, agreement_path(event.agreement) %></th>
            <td><%= t("agreements.events.#{event.kind}") %><%= " — #{event.data['reason']}" if event.data["reason"].present? %></td>
            <td><%= event.user&.name || "Sistema" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
