<%# Formulário de registro de acionamento (R69 a R73). Locais: form (Contacts::Form), customer, notice. O resultado e o contrato pedem ao servidor os
    campos que dependem deles (retorno, aviso do responsável financeiro), sem recarregar a página. %>
<% path = customer_contact_attempts_path(customer) %>
<% fields_path = new_customer_contact_attempt_path(customer) %>
<% dependents = { "hx-get": fields_path, "hx-trigger": "change", "hx-swap": "none",
                  "hx-include": "[name='contact_attempt[result_id]'], [name='contact_attempt[contract_id]'], [name='contact_attempt[return_at]']" } %>
<div id="form-acionamento">
  <% if local_assigns[:notice] %><%= aviso(tom: :success) { tag.p notice } %><% end %>
  <% if form.error %><%= aviso(tom: :danger) { tag.p form.error } %><% end %>
  <%= form_with scope: :contact_attempt, url: path, html: { "hx-post": path, "hx-target": "#form-acionamento", "hx-swap": "outerHTML", "aria-labelledby": "registrar-acionamento" } do |f| %>
    <h3 id="registrar-acionamento">Registrar acionamento</h3>
    <div class="grupo-de-campos">
      <div class="campo">
        <%= f.label :channel, "Canal" %>
        <%= f.select :channel, ContactAttempt::CHANNELS.map { |channel| [ t("contacts.channels.#{channel}"), channel ] }, { selected: form.value(:channel), prompt: "Escolha o canal" }, required: true %>
      </div>
      <div class="campo">
        <%= f.label :result_id, "Resultado" %>
        <%= f.select :result_id, form.results.map { |result| [ result.name, result.id ] }, { selected: form.value(:result_id), prompt: "Escolha o resultado" }, { required: true, **dependents } %>
      </div>
      <div class="campo">
        <%= f.label :contract_id, "Contrato (opcional)" %>
        <%= f.select :contract_id, form.contracts.map { |contract| [ contract.label, contract.id ] }, { selected: form.value(:contract_id), include_blank: "Sem contrato" }, dependents %>
      </div>
    </div>
    <%= render "customers/contact_attempts/contract_notice", form: form, oob: false %>
    <div class="grupo-de-campos">
      <div class="campo">
        <%= f.label :contact_used, "Contato usado (opcional)" %>
        <%= f.text_field :contact_used, value: form.value(:contact_used), maxlength: 300, list: "contatos-do-cliente", autocomplete: "off", "aria-describedby": "ajuda-contato" %>
        <datalist id="contatos-do-cliente"><% form.suggested_contacts.each do |contact| %><option value="<%= contact %>"><% end %></datalist>
        <small id="ajuda-contato">Escolha um contato da ficha ou digite outro; o digitado fica só neste acionamento.</small>
      </div>
      <div class="campo">
        <%= f.label :contacted_at, "Data e hora do contato (opcional)" %>
        <%= f.datetime_local_field :contacted_at, value: form.value(:contacted_at), "aria-describedby": "ajuda-data" %>
        <small id="ajuda-data">Vazio vale agora. Contato feito fora do sistema: até 7 dias atrás.</small>
      </div>
      <%= render "customers/contact_attempts/return_field", form: form, oob: false %>
    </div>
    <div class="campo">
      <%= f.label :text, "Texto (opcional)" %>
      <%= f.text_area :text, value: form.value(:text), maxlength: 2000, rows: 4, "aria-describedby": "ajuda-texto" %>
      <small id="ajuda-texto">Escreva só o necessário para a cobrança: o texto é dado pessoal. Aparece exatamente como digitado.</small>
    </div>
    <div class="acoes"><button type="submit">Registrar acionamento</button></div>
  <% end %>
</div>
