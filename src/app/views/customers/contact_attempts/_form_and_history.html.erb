<%# Resposta do registro pelo htmx: o formulário (vazio, com o aviso de sucesso, ou preenchido, com o motivo da recusa) e, no sucesso, o
    histórico refeito fora de banda. Locais: form, customer, history, notice. %>
<%= render "customers/contact_attempts/form", form: form, customer: customer, notice: notice %>
<% if history %>
  <%= render "customers/contact_attempts/history", customer: customer, history: history, oob: true %>
<% end %>
