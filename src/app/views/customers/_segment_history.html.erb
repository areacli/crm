<%# Histórico de segmento dos contratos do cliente (08, R159). Locais: contracts, history. %>
<% if history.values.flatten.any? %>
  <section class="cartao" id="historico-de-segmento" aria-labelledby="historico-de-segmento-titulo">
    <header><div><h2 id="historico-de-segmento-titulo">Histórico de segmento</h2><p>As mudanças de segmento de cada contrato, da mais recente para a mais antiga.</p></div></header>
    <div class="tabela" tabindex="0">
      <table>
        <caption class="apenas-leitor-de-tela">Mudanças de segmento dos contratos do cliente</caption>
        <thead><tr><th scope="col">Contrato</th><th scope="col">Segmento</th><th scope="col">Desde</th></tr></thead>
        <tbody>
          <% contracts.each do |contract| %>
            <% history.fetch(contract.id, []).each do |entry| %>
              <tr><th scope="row"><%= contract.label %></th><td><%= entry.segment&.name || t("segments.none") %></td><td><%= date_br(entry.since) %></td></tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
