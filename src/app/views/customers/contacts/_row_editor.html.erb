<%# Edição na própria linha (telefone e e-mail): a linha do contato é trocada por um campo e os botões Salvar e Cancelar; nenhum formulário fica aberto na tabela.
    Locais: customer, contact, error. O destino do htmx é a linha (`contato-<id>`); Cancelar volta a linha como era. %>
<tr id="contato-<%= contact.id %>">
  <td colspan="7">
    <%= form_with scope: :contact, url: customer_contact_path(customer, contact), method: :patch, class: "em-linha", html: { "hx-patch": customer_contact_path(customer, contact), "hx-target": "#contato-#{contact.id}", "hx-swap": "outerHTML", "hx-push-url": "false" } do |form| %>
      <div class="campo">
        <%= form.label :value, contact.email? ? "E-mail" : "Telefone", for: "linha-#{contact.id}-valor" %>
        <%= form.text_field :value, id: "linha-#{contact.id}-valor", value: contact.value, required: true, maxlength: (contact.email? ? 254 : 60), type: (contact.email? ? "email" : "tel"), autocomplete: "off", autofocus: true, "aria-invalid": (error ? "true" : nil) %>
        <% if error %><p class="erro" role="alert"><%= error %></p><% end %>
      </div>
      <div class="acoes">
        <button type="submit" data-size="small">Salvar</button>
        <button type="button" data-variant="secondary" data-size="small" hx-get="<%= edit_customer_contact_path(customer, contact, cancelar: 1) %>" hx-target="#contato-<%= contact.id %>" hx-swap="outerHTML" hx-push-url="false">Cancelar</button>
      </div>
    <% end %>
  </td>
</tr>
