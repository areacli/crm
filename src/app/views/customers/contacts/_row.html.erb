<%# Linha do contato na aba Contatos (um `tbody` por contato: a linha e o detalhe, padrões de interface, revisão 25; o htmx troca os dois juntos). As ações ficam no menu ⋯ da linha: corrigir (na própria linha, ou no painel para endereço) e mudar a situação (modal pequeno).
    Locais: customer, contact, can_edit. %>
<% detail_id = "detalhe-contato-#{contact.id}" %>
<% notes = [ ("Mantido pelo credor." if contact.kept_by_tenant?), ("Veio na carga de #{date_br(contact.seen_in_import_at.to_date)}." if contact.seen_in_import_at),
             "Última mudança em #{date_br(contact.updated_at.to_date)} por #{contact.updated_by&.name || "carga"}.", ("Pedido de não perturbe em #{date_br(contact.do_not_disturb_on)}." if contact.do_not_disturb_on) ].compact %>
<tbody id="contato-<%= contact.id %>">
<tr>
  <td><%= alternar_detalhe(detail_id, "contato #{contact.value}") %><%= contact_kind(contact.kind) %></td>
  <th scope="row"><%= contact.value %><% if contact.no_area_code? %><%= situacao "Sem DDD", tom: :warning %><% end %></th>
  <td><%= contact_status(contact) %></td>
  <td><%= contact_origin(contact.origin) %></td>
  <td><%= date_br(contact.updated_at.to_date) %></td>
  <td><%= contact.reason.present? ? cortado(contact.reason) : "—" %></td>
  <td data-acoes>
    <% if can_edit %>
      <%= menu_de_linha("contato-menu-#{contact.id}", "Ações do contato #{contact.value}") do %>
        <% unless contact.status_invalid? %>
          <% if contact.address? %>
            <%= abrir_painel "Editar", edit_customer_contact_path(customer, contact) %>
          <% else %>
            <a href="<%= edit_customer_contact_path(customer, contact) %>" class="botao" hx-get="<%= edit_customer_contact_path(customer, contact) %>" hx-target="#contato-<%= contact.id %>" hx-swap="outerHTML" hx-push-url="false">Editar</a>
          <% end %>
          <%= abrir_painel "Marcar como inválido", edit_customer_contact_status_path(customer, contact, status: "invalid"), variante: "danger-outline" %>
        <% end %>
        <% if contact.status_valid? %>
          <%= abrir_painel "Marcar como não perturbe", edit_customer_contact_status_path(customer, contact, status: "do_not_disturb") %>
        <% else %>
          <%= abrir_painel "Marcar como válido", edit_customer_contact_status_path(customer, contact, status: "valid") %>
        <% end %>
      <% end %>
    <% end %>
  </td>
</tr>
<%= detalhe_da_linha(detail_id, 7) do %>
  <p><%= safe_join(notes, " ") %></p>
  <% if contact.reason.present? %><p>Motivo: <%= contact.reason %></p><% end %>
<% end %>
</tbody>
