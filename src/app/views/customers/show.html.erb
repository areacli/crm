<% content_for :title, @customer.name %>
<% content_for :cable_channels, customer_contact_cable_channels(@customer) %>
<header class="cabecalho-da-pagina">
  <div>
    <h1><%= @customer.name %></h1>
    <p><%= @customer.tenant.name %> · <%= link_to "Voltar para os clientes", customers_path %></p>
  </div>
</header>

<%
  active = @bills.select(&:active?)
  overdue = active.select { |bill| bill.due_date < @today }
  upcoming = active - overdue
  worst = overdue.map { |bill| bill.days_overdue(@today) }.max
%>
<section class="cartao" aria-labelledby="dados">
  <header>
    <h2 id="dados">Dados do cliente</h2>
    <% if @can_handle_rights %>
      <div class="acoes">
        <button type="button" command="show-modal" commandfor="exportar-dados" data-variant="secondary" data-size="small">Exportar dados</button>
        <% unless @customer.anonymized? %><button type="button" command="show-modal" commandfor="anonimizar-cliente" data-variant="danger-outline" data-size="small">Anonimizar</button><% end %>
      </div>
    <% end %>
  </header>
  <div>
    <% if @customer.anonymized? %><%= aviso(tom: :info) { tag.p "Cliente anonimizado em #{date_br(@customer.anonymized_at.to_date)}. Só restam os dados que não identificam a pessoa." } %><% end %>
    <dl class="valores">
      <div><dt>Documento</dt><dd><%= @customer.formatted_document %></dd></div>
      <div><dt>Telefone</dt><dd><%= @contacts.find { |contact| contact.phone? && contact.status_valid? }&.value || "—" %></dd></div>
      <div><dt>E-mail</dt><dd><%= @contacts.find { |contact| contact.email? && contact.status_valid? }&.value || "—" %></dd></div>
      <div><dt>Faixa de atraso</dt><dd><%= worst ? "#{@brackets.label(@brackets.index_for(worst))} dias" : "Sem atraso" %></dd></div>
    </dl>
    <% if @customer.name_kept? %><p><small>O nome foi corrigido na tela (mantido pelo credor).</small></p><% end %>
    <% if @can_edit_registry %>
      <details id="corrigir-nome">
        <summary>Corrigir nome</summary>
        <%= form_with scope: :customer, url: customer_name_path(@customer), method: :patch, html: { "hx-boost": "false" } do |form| %>
          <div class="campo"><%= form.label :name, "Nome" %><%= form.text_field :name, value: @customer.name, required: true, maxlength: 300 %><small>O documento não se edita: documento errado é outro cliente.</small></div>
          <div class="acoes"><button type="submit">Corrigir nome</button></div>
        <% end %>
      </details>
    <% end %>
  </div>
</section>

<section class="cartao" aria-labelledby="totais">
  <header><h2 id="totais">Em cobrança</h2></header>
  <div>
    <dl class="valores">
      <div><dt>Vencido</dt><dd><%= money(overdue.sum(&:balance_cents)) %></dd></div>
      <% unless @setting.upcoming_display == "detail_only" %>
        <div><dt>A vencer</dt><dd><%= money(upcoming.sum(&:balance_cents)) %></dd></div>
      <% end %>
      <div><dt>Títulos em cobrança</dt><dd><%= number_br(active.size) %></dd></div>
    </dl>
  </div>
</section>

<%= render "customers/registry", customer: @customer, top: @top_contacts, listed: @listed_contacts, can_edit: @can_edit_registry, history: @registry_history, contacts_by_id: @contacts.index_by(&:id) %>

<%= render "customers/contact_attempts", customer: @customer, history: @contact_history, form: @contact_form %>

<%= render "customers/contracts", customer: @customer, contracts: @contracts, members: @contract_members, credit_totals: @credit_totals,
   brackets: @brackets, overdue: @contract_overdue, segments: @contract_segments, history: @segment_history %>

<section class="cartao" aria-labelledby="titulos">
  <header><h2 id="titulos">Títulos</h2></header>
  <% if @bills.empty? %>
    <p class="vazio">Este cliente não tem títulos.</p>
  <% else %>
    <div class="tabela">
      <table>
        <caption class="apenas-leitor-de-tela">Títulos do cliente</caption>
        <thead>
          <tr>
            <th scope="col">Número</th><th scope="col">Contrato</th><th scope="col">Vencimento</th>
            <th scope="col" data-numerico>Valor</th><th scope="col" data-numerico>Pago</th><th scope="col" data-numerico>Saldo</th>
            <th scope="col" data-numerico>Dias de atraso</th><th scope="col">Situação</th>
          </tr>
        </thead>
        <tbody>
          <% @bills.each do |bill| %>
            <tr>
              <th scope="row">
                <%= link_to bill.number, bill_path(bill) %>
                <% if @open_discrepancies.include?(bill.id) %><small>Divergência de valor aberta. <%= link_to "Ver histórico", bill_path(bill) %></small>
                <% elsif @version_counts.fetch(bill.id, 1) > 1 %><small>O valor mudou <%= @version_counts[bill.id] - 1 %> vez(es). <%= link_to "Ver histórico", bill_path(bill) %></small><% end %>
              </th>
              <td><%= bill.contract.code.presence || "—" %></td>
              <td><%= date_br(bill.due_date) %></td>
              <td data-numerico><%= money(bill.amount_cents) %></td>
              <td data-numerico><%= money(bill.paid_cents) %></td>
              <td data-numerico><%= money(bill.balance_cents) %></td>
              <td data-numerico><%= bill.active? && bill.due_date < @today ? number_br(bill.days_overdue(@today)) : "—" %></td>
              <td>
                <% if bill.withdrawn? %><%= situacao "Retirado", tom: :neutral %>
                <% elsif bill.paid? %><%= situacao "Pago", tom: :success %>
                <% elsif bill.due_date < @today %><%= situacao "Vencido", tom: :danger %>
                <% else %><%= situacao "A vencer", tom: :info %><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

<% if @payments.any? %>
  <section class="cartao" aria-labelledby="pagos">
    <header><h2 id="pagos">Pagos</h2><p>Pagamentos aplicados aos títulos deste cliente.</p></header>
    <div class="tabela">
      <table>
        <caption class="apenas-leitor-de-tela">Pagamentos do cliente</caption>
        <thead>
          <tr>
            <th scope="col">Título</th><th scope="col">Data</th><th scope="col" data-numerico>Valor pago</th><th scope="col" data-numerico>Aplicado ao título</th>
            <th scope="col" data-numerico>Estornado</th><th scope="col">Meio</th><th scope="col">Canal</th>
          </tr>
        </thead>
        <tbody>
          <% @payments.each do |payment| %>
            <tr>
              <th scope="row"><%= payment.bill.number %></th>
              <td><%= date_br(payment.paid_on) %></td>
              <td data-numerico><%= money(payment.amount_cents) %></td>
              <td data-numerico><%= money(payment.applied_cents) %></td>
              <td data-numerico><%= payment.reversed_cents.positive? ? money(payment.reversed_cents) : "—" %></td>
              <td><%= t("payments.methods.#{payment.payment_method}") %></td>
              <td><%= payment.channel.description %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<% if @credit_entries.any? || @excess_bills.any? %>
  <section class="cartao" aria-labelledby="credito">
    <header>
      <div><h2 id="credito">Crédito por contrato</h2><p>O crédito é do contrato, e todos os clientes do contrato o veem.</p></div>
      <% if @can_transfer %><button type="button" command="show-modal" commandfor="transferir-credito" data-variant="secondary" data-size="small">Transferir crédito</button><% end %>
    </header>
    <div>
      <% @contracts.each do |contract| %>
        <% entries = @credit_entries[contract.id].to_a %>
        <% excess = @excess_bills[contract.id].to_a %>
        <% next if entries.empty? && excess.empty? %>
        <h3><%= contract.label %>: <%= money(@credit_totals.fetch(contract.id, 0) + @excess_totals.fetch(contract.id, 0)) %></h3>
        <% if excess.any? %>
          <div class="tabela">
            <table>
              <caption class="apenas-leitor-de-tela">Excedente por valor reduzido do contrato <%= contract.label %></caption>
              <thead><tr><th scope="col">Título</th><th scope="col">Motivo</th><th scope="col" data-numerico>Valor do título</th><th scope="col" data-numerico>Pago</th><th scope="col" data-numerico>Excedente</th></tr></thead>
              <tbody>
                <% excess.each do |bill| %>
                  <tr>
                    <th scope="row"><%= link_to bill.number, bill_path(bill) %></th>
                    <td>Valor do título reduzido <small>(calculado: some se o valor voltar a subir ou um estorno reduzir o pago)</small></td>
                    <td data-numerico><%= money(bill.amount_cents) %></td>
                    <td data-numerico><%= money(bill.paid_cents) %></td>
                    <td data-numerico><%= money(bill.excess_cents) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
        <% if entries.any? %>
        <div class="tabela">
          <table>
            <caption class="apenas-leitor-de-tela">Lançamentos de crédito do contrato <%= contract.label %></caption>
            <thead><tr><th scope="col">Data</th><th scope="col">Origem</th><th scope="col">Motivo</th><th scope="col" data-numerico>Valor</th></tr></thead>
            <tbody>
              <% entries.each do |entry| %>
                <tr>
                  <td><%= datetime_br(entry.occurred_at) %></td>
                  <td>
                    <% if entry.payment %>Pagamento <%= entry.payment.identifier %> de <%= date_br(entry.payment.paid_on) %>
                    <% elsif entry.related_contract %><%= entry.transfer_out? ? "Transferido para" : "Recebido de" %> <%= entry.related_contract.label %>
                    <% else %>—<% end %>
                  </td>
                  <td><%= t("payments.credit_reasons.#{entry.reason}") %><%= " — #{entry.note}" if entry.note.present? %></td>
                  <td data-numerico><%= money(entry.amount_cents) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<% if @can_transfer %>
  <dialog id="transferir-credito" aria-labelledby="transferir-credito-titulo">
    <%= form_with scope: :credit_transfer, url: customer_credit_transfers_path(@customer), html: { "hx-boost": "false" } do |form| %>
      <header>
        <div><h2 id="transferir-credito-titulo">Transferir crédito</h2><p>Entre contratos do mesmo credor. Fica registrado nos dois contratos. Só o crédito lançado se transfere; o excedente de valor reduzido é calculado e não entra.</p></div>
        <button type="button" command="close" commandfor="transferir-credito" data-variant="link" aria-label="Fechar a janela"><%= icone("x-mark") %></button>
      </header>
      <div>
        <div class="campo">
          <%= form.label :from_contract_id, "Contrato de origem" %>
          <%= form.select :from_contract_id, @contracts.select { |contract| @credit_totals.fetch(contract.id, 0).positive? }.map { |contract| [ "#{contract.label} (#{money(@credit_totals[contract.id])})", contract.id ] }, { include_blank: false } %>
        </div>
        <div class="campo">
          <%= form.label :to_code, "Código do contrato de destino" %>
          <%= form.text_field :to_code, required: true, maxlength: 100 %>
        </div>
        <div class="campo">
          <%= form.label :amount, "Valor" %>
          <%= form.text_field :amount, required: true, inputmode: "decimal", autocomplete: "off" %>
          <small>Em reais, com vírgula nos centavos, até o crédito do contrato de origem.</small>
        </div>
        <div class="campo">
          <%= form.label :reason, "Motivo" %>
          <%= form.text_field :reason, required: true, maxlength: 300 %>
        </div>
      </div>
      <footer>
        <button type="button" command="close" commandfor="transferir-credito" data-variant="secondary">Cancelar</button>
        <button type="submit">Transferir</button>
      </footer>
    <% end %>
  </dialog>
<% end %>

<% if @can_handle_rights %>
  <dialog id="exportar-dados" aria-labelledby="exportar-dados-titulo">
    <%= form_with scope: :export, url: customer_data_export_path(@customer), method: :post, html: { "hx-boost": "false" } do |form| %>
      <header>
        <div><h2 id="exportar-dados-titulo">Exportar dados</h2><p>Tudo o que este credor guarda sobre o cliente, em página para imprimir e em JSON. A exportação fica registrada, sem o conteúdo.</p></div>
        <button type="button" command="close" commandfor="exportar-dados" data-variant="link" aria-label="Fechar a janela"><%= icone("x-mark") %></button>
      </header>
      <div>
        <div class="campo"><%= form.label :reason, "Motivo" %><%= form.text_field :reason, required: true, maxlength: 300 %><small>Por exemplo, o pedido do titular e o protocolo. Não escreva dados pessoais.</small></div>
      </div>
      <footer>
        <button type="button" command="close" commandfor="exportar-dados" data-variant="secondary">Cancelar</button>
        <button type="submit">Exportar dados</button>
      </footer>
    <% end %>
  </dialog>

  <% unless @customer.anonymized? %>
    <dialog id="anonimizar-cliente" aria-labelledby="anonimizar-cliente-titulo">
      <%= form_with scope: :anonymization, url: customer_anonymization_path(@customer), method: :post, html: { "hx-boost": "false" } do |form| %>
        <header>
          <div><h2 id="anonimizar-cliente-titulo">Anonimizar cliente</h2><p>Troca, sem volta, o nome, o documento, os contatos e os textos por um identificador sem significado. Valores, datas e situações ficam.</p></div>
          <button type="button" command="close" commandfor="anonimizar-cliente" data-variant="link" aria-label="Fechar a janela"><%= icone("x-mark") %></button>
        </header>
        <div>
          <% if @open_relations&.any? %>
            <%= aviso(tom: :danger) { tag.p "Não é possível anonimizar: #{@open_relations.message}." } %>
          <% else %>
            <div class="campo"><%= form.label :reason, "Motivo" %><%= form.text_field :reason, required: true, maxlength: 300 %><small>Por exemplo, o pedido do titular e o protocolo. Não escreva dados pessoais.</small></div>
            <div class="campo"><%= form.label :document, "Documento do cliente" %><%= form.text_field :document, required: true, maxlength: 18, autocomplete: "off", inputmode: "text" %><small>Digite o documento para confirmar, com ou sem pontuação.</small></div>
          <% end %>
        </div>
        <footer>
          <button type="button" command="close" commandfor="anonimizar-cliente" data-variant="secondary">Cancelar</button>
          <% unless @open_relations&.any? %><button type="submit" data-variant="danger">Anonimizar cliente</button><% end %>
        </footer>
      <% end %>
    </dialog>
  <% end %>
<% end %>
