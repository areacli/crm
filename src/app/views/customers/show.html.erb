<% content_for :title, @customer.name %>
<% content_for :cable_channels, customer_contact_cable_channels(@customer) %>
<%
  active = @bills.select(&:active?)
  overdue = active.select { |bill| bill.due_date < @today }
  upcoming = active - overdue
  worst = overdue.map { |bill| bill.days_overdue(@today) }.max
  promises_count = @promises.size
  agreements_count = @agreements&.size.to_i
  indicators = []
  indicators << situacao("Anonimizado", tom: :neutral) if @customer.anonymized?
  indicators << (worst ? situacao("Atraso de #{@brackets.label(@brackets.index_for(worst))} dias", tom: :danger) : situacao("Sem atraso", tom: :success))
  indicators << situacao(pluralize(promises_count, "promessa em aberto", "promessas em aberto"), tom: :info) if promises_count.positive?
  indicators << situacao(pluralize(agreements_count, "proposta ou acordo", "propostas ou acordos"), tom: :info) if agreements_count.positive?
  can_more = @can_edit_registry || @can_transfer || @can_handle_rights
  tabs = [ [ "Títulos", @bills.size, "titulos" ], [ "Acionamentos", @contact_history.total, "acionamentos" ], [ "Promessas e acordos", promises_count + agreements_count, "promessas" ],
           [ "Pagamentos", @payments.size, "pagamentos" ], [ "Contatos", @listed_contacts.size, "contatos" ], [ "Histórico", nil, "historico" ] ]
%>
<%= pagina(@customer.name, subtitulo: safe_join([ @customer.tenant.name, " · ", link_to("Voltar para os clientes", customers_path) ]), indicadores: indicators, vivo: { url: request.fullpath, eventos: %w[cable:promises-changed cable:agreements-changed] }) do %>
  <% if @contact_form %><%= abrir_painel "Registrar acionamento", form_customer_contact_attempts_path(@customer) %><% end %>
  <% if @can_negotiate %><%= link_to "Simular acordo", new_customer_agreement_simulation_path(@customer), class: "botao", data: { variant: "secondary" } %><% end %>
  <% if can_more %>
    <%= menu_de_linha("mais-acoes", "Mais ações do cliente") do %>
      <% if @can_edit_registry %>
        <%= abrir_painel "Corrigir nome", edit_customer_name_path(@customer) %>
        <%= abrir_painel "Criar contato", new_customer_contact_path(@customer) %>
      <% end %>
      <% if @can_transfer %><%= abrir_painel "Transferir crédito", new_customer_credit_transfer_path(@customer) %><% end %>
      <% if @can_handle_rights %>
        <%= abrir_painel "Exportar dados", new_customer_data_export_path(@customer) %>
        <% unless @customer.anonymized? %><%= abrir_painel "Anonimizar", new_customer_anonymization_path(@customer), variante: "danger-outline" %><% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @city_unrecognized %><%= aviso(tom: :warning) { tag.p "Cidade não reconhecida: o endereço deste cliente não casa com a lista de municípios do IBGE, e os acordos dele usam só os feriados nacionais. Corrija o endereço no cadastro." } %><% end %>
<% if @customer.anonymized? %><%= aviso(tom: :info) { tag.p "Cliente anonimizado em #{date_br(@customer.anonymized_at.to_date)}. Só restam os dados que não identificam a pessoa." } %><% end %>

<div class="ficha">
  <div class="ficha-principal">
    <%= abas_da_pagina "Seções da ficha", tabs.map { |texto, contagem, chave| [ texto, customer_path(@customer, aba: chave), contagem, @tab == chave ] } %>
    <%= render "customers/tabs/#{@tab}" %>
  </div>

  <aside class="ficha-lateral" aria-label="Resumo do cliente">
    <section class="cartao" aria-labelledby="dados">
      <header><h2 id="dados">Dados do cliente</h2></header>
      <div>
        <dl class="dados">
          <dt>Documento</dt><dd><%= @customer.formatted_document %></dd>
          <dt>Telefone</dt><dd><%= @contacts.find { |contact| contact.phone? && contact.status_valid? }&.value || "—" %></dd>
          <dt>E-mail</dt><dd><%= @contacts.find { |contact| contact.email? && contact.status_valid? }&.value || "—" %></dd>
          <dt>Faixa de atraso</dt><dd><%= worst ? "#{@brackets.label(@brackets.index_for(worst))} dias" : "Sem atraso" %></dd>
        </dl>
        <% if @customer.name_kept? %><p><small>O nome foi corrigido na tela (mantido pelo credor).</small></p><% end %>
      </div>
    </section>

    <section class="cartao" aria-labelledby="totais">
      <header><h2 id="totais">Em cobrança</h2></header>
      <div>
        <% updated_total = overdue.sum { |bill| @valuations[bill.id]&.total_cents || bill.balance_cents } %>
        <dl class="dados">
          <dt>Vencido</dt><dd><%= money(overdue.sum(&:balance_cents)) %></dd>
          <% unless @setting.upcoming_display == "detail_only" %><dt>A vencer</dt><dd><%= money(upcoming.sum(&:balance_cents)) %></dd><% end %>
          <dt>Títulos em cobrança</dt><dd><%= number_br(active.size) %></dd>
          <dt>Atualizado</dt><dd><%= money(updated_total) %></dd>
        </dl>
        <% if @value_status[:calculated_on] %>
          <p><small>Valor atualizado até <%= date_br(@value_status[:calculated_on]) %> (principal corrigido, multa, juros e honorários pelas regras de <%= @customer.tenant.name %>).<%= " Os valores estão sendo recalculados." if @value_status[:running] %></small></p>
        <% elsif overdue.any? %>
          <p><small>O valor atualizado ainda não foi calculado para este credor.</small></p>
        <% end %>
      </div>
    </section>

    <section class="cartao" id="contatos-resumo" aria-labelledby="contatos-titulo">
      <header>
        <h2 id="contatos-titulo">Contatos</h2>
        <% if @listed_contacts.any? %><%= link_to "Ver todos#{' e editar' if @can_edit_registry} (#{number_br(@listed_contacts.size)})", customer_path(@customer, aba: "contatos") %><% end %>
      </header>
      <div>
        <% if @top_contacts.empty? %>
          <p class="vazio">Nenhum contato válido cadastrado.</p>
        <% else %>
          <ul class="contatos">
            <% @top_contacts.each do |contact| %>
              <li><strong><%= contact_kind(contact.kind) %>:</strong> <%= contact.value %><% if contact.no_area_code? %> <small>(sem DDD)</small><% end %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </section>
  </aside>
</div>
