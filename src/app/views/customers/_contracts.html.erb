<%# Contratos em que o cliente figura (06, R124a), acima das abas e filtro da ficha (padrões de interface, revisões 21 e 28): o código do contrato recorta a página
    inteira, a linha escolhida fica marcada e "Ver todos os contratos" desfaz o filtro; com mais de 5 contratos, os 5 primeiros (e o escolhido) e um link para todos.
    Locais: customer, contracts (todos), selected (o contrato escolhido ou nil), tab, bill_counts, members, credit_totals, brackets, tiers, since, overdue (dias de atraso
    por contrato) e operations (as operações que cobram cada contrato, 14; só para a equipe do credor: nil esconde a coluna). Com mais de um sistema além do CRM
    no credor, a coluna Sistema e o id do contrato no sistema, no detalhe (17, R422). %>
<% show_operations = !local_assigns[:operations].nil? %>
<% systems = system_names(customer.tenant_id) %>
<% columns = 7 + (show_operations ? 1 : 0) + (systems ? 1 : 0) %>
<% several = contracts.size > 1 %>
<% limit = 5 %>
<% shown = params[:contratos] == "todos" ? contracts : contracts.first(limit) %>
<% shown += [ selected ] if selected && !shown.include?(selected) %>
<% filter_path = ->(contract) { customer_path(customer, { aba: (tab unless tab == "titulos"), contrato: contract&.id, contratos: params[:contratos].presence }.compact) } %>
<section class="cartao" id="contratos" aria-labelledby="contratos-titulo">
  <header>
    <div><h2 id="contratos-titulo">Contratos</h2><p><%= several ? "Escolha um contrato para ver só o que é dele em todas as abas." : "O contrato em que este cliente figura e o papel de cada cliente nele." %></p></div>
    <% if selected %><%= link_to "Ver todos os contratos", filter_path.call(nil), class: "botao", data: { variant: "secondary", size: "small" } %><% end %>
  </header>
  <div class="tabela" tabindex="0">
    <table data-detalhes>
      <caption class="apenas-leitor-de-tela">Contratos do cliente e os clientes de cada um<%= several ? "; o código do contrato filtra a ficha" : "" %></caption>
      <thead><tr><th scope="col"><%= alternar_todos_os_detalhes %>Contrato</th><% if systems %><th scope="col">Sistema</th><% end %><th scope="col" data-numerico>Títulos</th><th scope="col">Papel deste cliente</th><th scope="col">Clientes do contrato</th><th scope="col">Faixa de atraso</th><th scope="col">Enquadramento</th><% if show_operations %><th scope="col">Operações</th><% end %><th scope="col" data-numerico>Crédito</th></tr></thead>
      <tbody>
        <% shown.each do |contract| %>
          <% rows = members.fetch(contract.id, []) %>
          <% own = rows.find { |row| row.customer_id == customer.id } %>
          <% detail_id = "detalhe-contrato-#{contract.id}" %>
          <% tier = tiers[contract.tier_id] %>
          <% current = selected == contract %>
          <tr <%= tag.attributes(data: { atual: (current ? "" : nil) }) %>>
            <th scope="row">
              <%= alternar_detalhe(detail_id, "contrato #{contract.label}") %>
              <%= several ? link_to(contract.label, filter_path.call(contract), aria: { current: (current ? "true" : nil), label: "Filtrar a ficha pelo contrato #{contract.label}" }) : contract.label %>
            </th>
            <% if systems %><td><%= systems[contract.source_system_id] %></td><% end %>
            <td data-numerico><%= number_br(bill_counts.fetch(contract.id, 0)) %></td>
            <td><%= own ? role_label(own, rows) : "—" %></td>
            <td><%= pluralize(rows.size, "cliente", "clientes") %></td>
            <td><%= overdue[contract.id] ? "#{brackets.label(brackets.index_for(overdue[contract.id]))} dias" : "Sem atraso" %></td>
            <td>
              <% if tier %>
                <%= tier.name %>
                <%= informacao "enquadramento do contrato #{contract.label}", tier.catch_all? ? "Não atende a nenhum segmento do enquadramento financeiro; fica com as regras de Demais." : "Atende ao segmento: #{tier.segment.text.long_text}", "porque-#{contract.id}" %>
              <% else %>
                <%= t("tiers.none") %>
              <% end %>
            </td>
            <% if show_operations %>
              <td>
                <% holders = operations.fetch(contract.id, []) %>
                <% if holders.empty? %>
                  Equipe do credor
                <% else %>
                  <ul class="operacoes-do-contrato" aria-label="Operações que cobram o contrato <%= contract.label %>">
                    <% holders.each do |holder| %>
                      <li><span class="situacao" data-tone="info" title="<%= holder.legal_name %>"><%= holder.name %><span class="apenas-leitor-de-tela">, <%= holder.legal_name %></span></span></li>
                    <% end %>
                  </ul>
                <% end %>
              </td>
            <% end %>
            <td data-numerico><%= money(credit_totals.fetch(contract.id, 0)) %></td>
          </tr>
          <%= detalhe_da_linha(detail_id, columns) do %>
            <% if systems && contract.external_id.present? %><p>Id no sistema <%= systems[contract.source_system_id] %>: <%= contract.external_id %>.</p><% end %>
            <p><strong>Clientes do contrato:</strong>
              <%= safe_join(rows.sort_by { |row| row.customer.name }.map { |row| safe_join([ (row.customer_id == customer.id ? row.customer.name : (policy(row.customer).show? ? link_to(row.customer.name, customer_path(row.customer)) : row.customer.name)), " (", role_label(row, rows), ")" ]) }, "; ") %>.</p>
            <% if tier && since[contract.id] %><p>No item <%= tier.name %> do enquadramento financeiro desde <%= date_br(since[contract.id]) %>.</p><% end %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if contracts.size > shown.size %>
    <p class="mais"><%= link_to "Mostrar os #{contracts.size} contratos", customer_path(customer, { aba: (tab unless tab == "titulos"), contrato: selected&.id, contratos: "todos" }.compact) %></p>
  <% end %>
</section>
