<%# Contratos em que o cliente figura (06, R124a), só para leitura: o papel dele, os clientes do contrato e o crédito. Locais: customer, contracts, members, credit_totals, brackets, overdue (dias de atraso por contrato), segments, history (08, R159). %>
<section class="cartao" id="contratos" aria-labelledby="contratos-titulo">
  <header><div><h2 id="contratos-titulo">Contratos</h2><p>Os contratos em que este cliente figura e o papel de cada cliente neles.</p></div></header>
  <div class="tabela" tabindex="0">
    <table>
      <caption class="apenas-leitor-de-tela">Contratos do cliente e os clientes de cada um</caption>
      <thead><tr><th scope="col">Contrato</th><th scope="col">Papel deste cliente</th><th scope="col">Clientes do contrato</th><th scope="col">Faixa de atraso</th><th scope="col">Segmento</th><th scope="col" data-numerico>Crédito</th></tr></thead>
      <tbody>
        <% contracts.each do |contract| %>
          <% rows = members.fetch(contract.id, []) %>
          <% own = rows.find { |row| row.customer_id == customer.id } %>
          <tr>
            <th scope="row"><%= contract.label %></th>
            <td><%= own ? role_label(own, rows) : "—" %></td>
            <td>
              <% rows.sort_by { |row| row.customer.name }.each do |row| %>
                <%= row.customer_id == customer.id ? row.customer.name : (policy(row.customer).show? ? link_to(row.customer.name, customer_path(row.customer)) : row.customer.name) %>
                <small><%= role_label(row, rows) %></small>
              <% end %>
            </td>
            <td><%= overdue[contract.id] ? "#{brackets.label(brackets.index_for(overdue[contract.id]))} dias" : "Sem atraso" %></td>
            <td><%= segments[contract.segment_id]&.name || t("segments.none") %></td>
            <td data-numerico><%= money(credit_totals.fetch(contract.id, 0)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<% if history.values.flatten.any? %>
  <section class="cartao" id="historico-de-segmento" aria-labelledby="historico-de-segmento-titulo">
    <header><div><h2 id="historico-de-segmento-titulo">Histórico de segmento</h2><p>As mudanças de segmento de cada contrato, da mais recente para a mais antiga.</p></div></header>
    <div class="tabela" tabindex="0">
      <table>
        <caption class="apenas-leitor-de-tela">Mudanças de segmento dos contratos do cliente</caption>
        <thead><tr><th scope="col">Contrato</th><th scope="col">Segmento</th><th scope="col">Desde</th></tr></thead>
        <tbody>
          <% contracts.each do |contract| %>
            <% history.fetch(contract.id, []).each do |entry| %>
              <tr><th scope="row"><%= contract.label %></th><td><%= entry.segment&.name || t("segments.none") %></td><td><%= date_br(entry.since) %></td></tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
