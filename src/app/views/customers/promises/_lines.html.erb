<%# Promessas abertas e pendentes (10, R203, P17), na aba Promessas e acordos: uma linha por promessa (o número, a situação, o valor, o meio, a data prometida e o pago; os títulos
    e quem fez no detalhe, padrões de interface, revisão 25). "Aprovar promessa" é botão direto (não pede dados); "Recusar promessa" e "Cancelar promessa" pedem motivo e abrem num modal pequeno, pelo menu ⋯
    da linha. Refeita a cada evento do WebSocket e a cada assinatura que conecta (o aviso que chega antes de a assinatura das promessas se
    confirmar se perderia). Locais: customer, promises. %>
<div id="promessas">
  <% if promises.any? %>
    <div class="tabela" tabindex="0">
      <table data-detalhes>
        <caption class="apenas-leitor-de-tela">Promessas abertas e pendentes do cliente</caption>
        <thead>
          <tr>
            <th scope="col"><%= alternar_todos_os_detalhes %>Promessa</th><th scope="col">Situação</th><th scope="col" data-numerico>Valor</th><th scope="col">Meio</th>
            <th scope="col">Até</th><th scope="col" data-numerico>Pago</th><th scope="col"><span class="apenas-leitor-de-tela">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <% promises.each do |promise| %>
            <% detail_id = "detalhe-promessa-#{promise.id}" %>
            <% policy = PaymentPromisePolicy.new(Current.user, promise) %>
            <tr>
              <th scope="row"><%= alternar_detalhe(detail_id, "promessa #{promise.label}") %><%= promise.label %></th>
              <td><%= promise_state(promise) %></td>
              <td data-numerico><%= money(promise.total_cents) %></td>
              <td><%= t("payments.methods.#{promise.payment_method}") %></td>
              <td><%= date_br(promise.promised_on) %></td>
              <td data-numerico><%= money(promise.paid_cents) %></td>
              <td data-acoes>
                <% if policy.approve? %>
                  <%= button_to "Aprovar promessa", promise_approval_path(promise), data: { variant: "secondary", size: "small" } %>
                <% end %>
                <% if policy.approve? || policy.cancel? %>
                  <%= menu_de_linha("promessa-#{promise.id}", "Mais ações da promessa #{promise.label}") do %>
                    <% if policy.approve? %><%= abrir_painel "Recusar promessa", new_promise_refusal_path(promise), variante: "danger-outline" %><% end %>
                    <% if policy.cancel? %><%= abrir_painel "Cancelar promessa", new_promise_cancellation_path(promise), variante: "danger-outline" %><% end %>
                  <% end %>
                <% end %>
              </td>
            </tr>
            <%= detalhe_da_linha(detail_id, 7) do %>
              <p>Títulos <%= promise_bill_numbers(promise) %>. Feita por <%= promise.customer.id == customer.id ? "este cliente" : promise.customer.name %><% if promise.contract.code.present? %>, contrato <%= promise.contract.label %><% end %>.</p>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="vazio">Nenhuma promessa aberta ou pendente.</p>
  <% end %>
</div>
