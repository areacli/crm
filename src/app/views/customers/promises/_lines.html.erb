<%# Promessas abertas e pendentes (10, R203, P17), na aba Promessas e acordos: uma linha por promessa, com o selo da situação, o número, os títulos, o valor, o meio, a
    data prometida e o pago. "Aprovar promessa" é botão direto (não pede dados); "Recusar promessa" e "Cancelar promessa" pedem motivo e abrem num modal pequeno, pelo menu ⋯
    da linha. Refeita a cada evento do WebSocket. Locais: customer, promises. %>
<div id="promessas" hx-get="<%= customer_promises_path(customer) %>" hx-trigger="cable:promises-changed from:body" hx-swap="outerHTML" hx-target="this">
  <% if promises.any? %>
    <ul class="promessas">
      <% promises.each do |promise| %>
        <li>
          <%= promise_state(promise) %>
          <span class="detalhe">
            <strong><%= promise.label %></strong>
            <%= promise_bill_numbers(promise) %>, <%= money(promise.total_cents) %> por <%= t("payments.methods.#{promise.payment_method}") %> até <%= date_br(promise.promised_on) %>.
            Pago <%= money(promise.paid_cents) %>.
            Feita por <%= promise.customer.id == customer.id ? "este cliente" : promise.customer.name %><% if promise.contract.code.present? %>, contrato <%= promise.contract.label %><% end %>.
          </span>
          <% policy = PaymentPromisePolicy.new(Current.user, promise) %>
          <div class="acoes">
            <% if policy.approve? %>
              <%= button_to "Aprovar promessa", promise_approval_path(promise), form: { "hx-boost": "false" }, data: { variant: "secondary", size: "small" } %>
            <% end %>
            <% if policy.approve? || policy.cancel? %>
              <%= menu_de_linha("promessa-#{promise.id}", "Mais ações da promessa #{promise.label}") do %>
                <% if policy.approve? %><%= abrir_painel "Recusar promessa", new_promise_refusal_path(promise), variante: "danger-outline" %><% end %>
                <% if policy.cancel? %><%= abrir_painel "Cancelar promessa", new_promise_cancellation_path(promise), variante: "danger-outline" %><% end %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="vazio">Nenhuma promessa aberta ou pendente.</p>
  <% end %>
</div>
