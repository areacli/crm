<%# Resultado do lote, refeito quando o WebSocket avisa que a conferência ou a confirmação terminou: só este trecho (`data-spa-vivo`). Local: batch. %>
<% running = batch.checking? || (batch.checked? && batch.summary["confirming"]) %>
<div id="lote" data-spa-vivo="<%= distribution_batch_path(batch) %>">
  <% summary = batch.summary %>
  <% if running %>
    <p class="carregando" role="status"><%= batch.checking? ? "Conferindo o lote…" : "Confirmando o lote…" %></p>
  <% elsif batch.discarded? %>
    <p class="vazio">Lote descartado. Nenhuma distribuição foi criada.</p>
  <% elsif batch.failed? %>
    <%= aviso(tom: :danger) { tag.p(summary["error"].presence || t("distribution_batches.failed")) } %>
  <% else %>
    <section class="cartao" aria-labelledby="resumo-lote">
      <header><h2 id="resumo-lote"><%= batch.confirmed? ? "Lote confirmado" : "O que vai" %></h2></header>
      <div>
        <p><strong>Vão <%= number_br(summary["contracts"].to_i) %> contratos</strong><% if batch.target == "customer" %> (<%= number_br(summary["targets"].to_i) %> clientes)<% end %>, <%= money(summary["balance_cents"].to_i) %> em cobrança.
          <% if summary["extra_contracts"].to_i.positive? %>A distribuição por cliente leva <%= number_br(summary["extra_contracts"]) %> contratos em que o cliente é só responsável financeiro.<% end %></p>
        <% if summary["refused_contracts"].to_i.positive? %>
          <p><%= number_br(summary["refused_contracts"]) %> contratos ficam de fora: já estão com outra operação (exclusividade).</p>
          <ul><% Array(summary["refused"]).each do |row| %><li>Contrato <%= row["contract"] %>: com a <%= row["operation"] %></li><% end %></ul>
        <% end %>
        <% if summary["missing_count"].to_i.positive? %>
          <p><%= number_br(summary["missing_count"]) %> linhas da planilha não foram encontradas: <%= Array(summary["missing"]).join(", ") %>.</p>
        <% end %>
        <% if summary["ambiguous_count"].to_i.positive? %>
          <%# 17, R421: o código existe em mais de um sistema do credor, e a planilha não disse qual. %>
          <p><%= number_br(summary["ambiguous_count"]) %> linhas da planilha ficam de fora porque o código é de mais de um contrato: <%= Array(summary["ambiguous"]).join(", ") %>. Envie de novo com a coluna <code>sistema</code>.</p>
        <% end %>
        <% if batch.confirmed? %>
          <p><%= number_br(summary["created"].to_i) %> distribuições criadas<%= ", #{summary['refused_at_confirm']} recusadas na confirmação" if summary["refused_at_confirm"].to_i.positive? %>.</p>
        <% elsif batch.checked? %>
          <div class="acoes" data-rodape>
            <%= button_to "Confirmar o lote", confirm_distribution_batch_path(batch), data: { variant: "primary" } %>
            <%= button_to "Descartar", discard_distribution_batch_path(batch), method: :delete, data: { variant: "secondary" } %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
