<% content_for :title, "Lote de distribuição" %>
<% content_for :cable_channels, @cable %>
<% descricao = "#{t("distribution_batches.kinds.#{@batch.kind}")}#{" #{@batch.segment.name}" if @batch.segment} · #{t("distributions.exposures.#{@batch.exposure}")} · #{date_br(@batch.starts_on)} a #{@batch.ends_on ? date_br(@batch.ends_on) : 'sem fim'} · #{@batch.tenant.name}" %>
<%= pagina "Lote de distribuição à #{@batch.operation.short_name}", subtitulo: descricao %>
<%= render "distribution_batches/result", batch: @batch %>
