<%# locals: (checkout:, instrument:, card: nil, outcome: nil) %>
<section class="cartao" aria-labelledby="forma-boleto">
  <header>
    <h2 id="forma-boleto"><%= t("payments.checkout.page.boleto") %></h2>
    <p><%= t("payments.checkout.page.boleto_hint", date: date_br(instrument.due_on)) %></p>
  </header>
  <div>
    <% if instrument.due_on < Date.current %>
      <%= aviso(tom: :warning) { tag.p t("payments.checkout.page.boleto_overdue", due: date_br(instrument.due_on), until: date_br(checkout.boleto_payable_until(instrument))) } %>
    <% end %>
    <div class="campo">
      <label for="boleto-linha-digitavel"><%= t("payments.checkout.page.digitable_line") %></label>
      <input id="boleto-linha-digitavel" type="text" readonly value="<%= instrument.digitable_line %>">
      <button type="button" data-copiar="boleto-linha-digitavel" data-variant="secondary"><%= t("payments.checkout.page.copy") %></button>
    </div>
    <p><a class="botao" href="<%= checkout_boleto_path(checkout) %>"><%= t("payments.checkout.page.open_boleto") %></a></p>
  </div>
</section>
