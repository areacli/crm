<% content_for :title, t("payments.checkout.page.title") %>
<% content_for :head do %>
  <%= tag.meta name: "cable-channels", content: [ { channel: "PaymentCheckoutChannel", token: checkout.token } ].to_json %>
  <%= javascript_importmap_tags("checkout") %>
<% end %>

<%= pagina t("payments.checkout.page.title"), subtitulo: t("payments.checkout.page.greeting", name: checkout.payer_name.to_s.split.first.to_s) %>

<section aria-labelledby="resumo">
  <h2 id="resumo" class="apenas-leitor-de-tela"><%= t("payments.checkout.page.summary") %></h2>
  <dl class="kpis">
    <%= kpi t("payments.checkout.page.amount"), money(checkout.amount_cents), detalhe: checkout.description.presence %>
    <%= kpi t("payments.checkout.page.valid_until"), date_br(checkout.expires_at.to_date) %>
  </dl>
</section>

<%= render "checkouts/options", checkout: checkout, card: @card, outcome: nil %>
