<%# Trecho que o htmx refaz a cada filtro: tabela, contagem e paginação. %>
<div id="resultado" aria-live="polite">
  <% if @distributions.empty? %>
    <p class="vazio">Nenhuma distribuição. Use "Distribuir" para entregar um cliente ou um contrato a uma operação credenciada.</p>
  <% else %>
    <div class="tabela" tabindex="0" data-fixa>
      <table data-detalhes>
        <caption class="apenas-leitor-de-tela">Distribuições</caption>
        <thead>
          <tr>
            <th scope="col"><%= alternar_todos_os_detalhes %>Cliente ou contrato</th>
            <th scope="col">Operação</th>
            <% if @several_tenants %><th scope="col">Credor</th><% end %>
            <th scope="col">Exposição</th>
            <th scope="col">Período</th>
            <th scope="col">Origem</th>
            <th scope="col">Situação</th>
            <th scope="col"><span class="apenas-leitor-de-tela">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <% @distributions.each do |distribution| %>
            <% detail_id = "detalhe-distribuicao-#{distribution.id}" %>
            <tr>
              <th scope="row"><% if distribution.ended_at %><%= alternar_detalhe(detail_id, "distribuição de #{distribution.target_label}") %><% end %><%= distribution.customer ? link_to(distribution.customer.name, customer_path(distribution.customer)) : "Contrato #{distribution.contract.code}" %></th>
              <td><%= distribution.operation.short_name %></td>
              <% if @several_tenants %><td><%= distribution.tenant.name %></td><% end %>
              <td><%= t("distributions.exposures.#{distribution.exposure}") %></td>
              <td><%= date_br(distribution.starts_on) %> a <%= distribution.ends_on ? date_br(distribution.ends_on) : "sem fim" %></td>
              <td><%= t("distributions.sources.#{distribution.source}") %></td>
              <td>
                <%= situacao t("distributions.statuses.#{distribution.status_key}"), tom: { "in_force" => :success, "scheduled" => :info, "ended" => :neutral }[distribution.status_key] %>
              </td>
              <td data-acoes>
                <% unless distribution.ended_at %>
                  <%= menu_de_linha("distribuicao-#{distribution.id}", "Ações da distribuição de #{distribution.target_label}") do %>
                    <%= abrir_painel "Editar", edit_distribution_path(distribution), variante: "modal", tamanho: "small" %>
                    <%= abrir_painel "Recolher", new_distribution_recall_path(distribution), variante: "modal", tamanho: "small" %>
                  <% end %>
                <% end %>
              </td>
            </tr>
            <% if distribution.ended_at %>
              <%= detalhe_da_linha(detail_id, @several_tenants ? 8 : 7) { tag.p("Encerrada em #{datetime_br(distribution.ended_at)}: #{t("distributions.end_reasons.#{distribution.end_reason}", default: distribution.end_reason)}.") } %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/paginacao", pagination: @pagination, unit: "distribuições", path: ->(page) { distributions_path(request.query_parameters.merge("page" => page)) } %>
  <% end %>
</div>
