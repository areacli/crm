<% content_for :title, "Distribuição" %>
<%= pagina "Distribuição", subtitulo: "O que está com cada operação, desde quando e com qual exposição. Um contrato distribuído só aparece para a operação dentro da exposição." do %>
  <%= link_to "Distribuir em lote", new_distribution_batch_path, class: "botao", data: { variant: "secondary" } %>
  <%= abrir_painel "Distribuir", new_distribution_path %>
<% end %>

<form class="filtros" role="search" action="<%= distributions_path %>" method="get">
  <div class="campo">
    <label for="q" class="apenas-leitor-de-tela">Buscar por cliente, documento ou contrato</label>
    <input type="search" id="q" name="busca" value="<%= params[:busca] %>" autocomplete="off" placeholder="Cliente, documento ou contrato">
  </div>
  <div class="campo">
    <label for="operation">Operação</label>
    <select id="operation" name="operacao"><option value="">Todas</option><%= options_for_select(@operations.map { [ _1.short_name, _1.id ] }, params[:operacao]) %></select>
  </div>
  <div class="campo">
    <label for="status">Situação</label>
    <select id="status" name="situacao"><option value="">Todas</option><%= opcoes_de_filtro(%w[in_force scheduled ended].map { [ t("distributions.statuses.#{_1}"), _1 ] }, params[:situacao]) %></select>
  </div>
  <div class="campo">
    <label for="source">Origem</label>
    <select id="source" name="fonte"><option value="">Todas</option><%= opcoes_de_filtro(Distribution::SOURCES.map { [ t("distributions.sources.#{_1}"), _1 ] }, params[:fonte]) %></select>
  </div>
  <% if @several_tenants %>
    <div class="campo">
      <label for="tenant">Credor</label>
      <select id="tenant" name="credor"><option value="">Todos</option><%= options_for_select(@tenants.map { [ _1.name, _1.id ] }, params[:credor]) %></select>
    </div>
  <% end %>
  <button type="submit" data-variant="secondary">Filtrar</button>
</form>

<%= render "distributions/result" %>
