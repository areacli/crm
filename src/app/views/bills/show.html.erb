<% content_for :title, "Histórico do título #{@bill.number}" %>
<% bill = @bill %>
<% situation = if bill.withdrawn? then situacao("Retirado", tom: :neutral)
               elsif bill.paid? then situacao("Pago", tom: :success)
               elsif bill.due_date < Date.current then situacao("Vencido", tom: :danger)
               else situacao("A vencer", tom: :info) end %>
<%= pagina "Título #{bill.number}", subtitulo: safe_join([ link_to(bill.customer.name, customer_path(bill.customer)), " · ", bill.tenant.name, " · ", link_to("Voltar para a ficha", customer_path(bill.customer, aba: "titulos")) ]), indicadores: [ situation ] %>

<dl class="kpis">
  <%= kpi "Valor vigente", money(bill.amount_cents) %>
  <%= kpi "Pago", money(bill.paid_cents) %>
  <%= kpi "Saldo", money(bill.balance_cents) %>
  <% if bill.excess_cents.positive? %><%= kpi "Excedente", money(bill.excess_cents), definicao: "Crédito do contrato: o que foi pago além do valor do título." %><% end %>
  <%= kpi "Vencimento", date_br(bill.due_date), detalhe: "Contrato #{bill.contract.label}#{" · #{bill.product}" if bill.product.present?}" %>
</dl>

<div class="duas-colunas">
  <section class="cartao" aria-labelledby="versoes">
    <header><h2 id="versoes">Versões do valor</h2><%= informacao "versões", "Cada valor que o credor informou para este título. A vigente é a última.", "definicao-versoes" %></header>
    <div class="tabela" tabindex="0">
      <table>
        <caption class="apenas-leitor-de-tela">Versões do valor do título</caption>
        <thead><tr><th scope="col" data-numerico>Versão</th><th scope="col" data-numerico>Valor</th><th scope="col">Data</th><th scope="col">Importação</th><th scope="col">Confirmada por</th></tr></thead>
        <tbody>
          <% @history.versions.each_with_index do |version, index| %>
            <tr>
              <th scope="row" data-numerico><%= index + 1 %><%= " (vigente)" if index == @history.versions.size - 1 %></th>
              <td data-numerico><%= money(version.amount_cents) %></td>
              <td><%= datetime_br(version.created_at) %></td>
              <td><%= version.import ? "de #{date_br(version.import.created_at.in_time_zone.to_date)}" : "—" %></td>
              <td><%= version.user&.name || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cartao" aria-labelledby="linha-do-tempo">
    <header><h2 id="linha-do-tempo">Linha do tempo</h2><%= informacao "linha do tempo", "Versões, pagamentos aplicados, estornos e divergências, em ordem de data.", "definicao-linha-do-tempo" %></header>
    <div class="tabela" tabindex="0">
      <table>
        <caption class="apenas-leitor-de-tela">Linha do tempo do título</caption>
        <thead><tr><th scope="col">Data</th><th scope="col">O que aconteceu</th><th scope="col" data-numerico>Valor</th></tr></thead>
        <tbody>
          <% @history.events.each do |event| %>
            <tr>
              <th scope="row"><%= date_br(event.date) %></th>
              <td><%= event.text %></td>
              <td data-numerico><%= event.cents ? money(event.cents) : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
