<%# A lista dos estornos à espera; o htmx a refaz a cada aviso do WebSocket. %>
<div id="resultado" aria-live="polite" hx-get="<%= reversal_waits_path %>" hx-trigger="cable:agreements-changed from:body, cable:connected from:body" hx-swap="outerHTML" hx-push-url="false">
  <% if @waits.empty? %>
    <p class="vazio">Nenhum estorno à espera do gestor.</p>
  <% else %>
    <section class="cartao" aria-labelledby="esperando">
      <header><h2 id="esperando">À espera de decisão</h2><%= informacao "estornos à espera", "O estorno que o CRM não resolve sozinho fica aqui, sem efeito: o título continua pago, o acordo não pode quitar e o crédito que o pagamento gerou fica bloqueado.", "definicao-estornos" %></header>
      <div class="tabela" tabindex="0">
        <table>
          <caption class="apenas-leitor-de-tela">Estornos à espera do gestor</caption>
          <thead><tr><th scope="col">Pagamento</th><th scope="col" data-numerico>Valor</th><th scope="col">Credor</th><th scope="col">Motivo</th><th scope="col" data-numerico>Espera há</th><th scope="col">Acordo</th><th scope="col">Cliente</th><th scope="col">Contrato</th><th scope="col"><span class="apenas-leitor-de-tela">Ações</span></th></tr></thead>
          <tbody>
            <% @waits.each do |wait| %>
              <tr>
                <th scope="row"><%= wait.payment.identifier %><small>estorno de <%= date_br(wait.reversed_on) %>, processado em <%= date_br(wait.processed_on) %></small></th>
                <td data-numerico><%= money(wait.amount_cents) %></td>
                <td><%= wait.tenant.name %></td>
                <td><%= t("reversal_waits.reasons.#{wait.reason}") %></td>
                <td data-numerico><%= wait.waiting_days %> dia(s)</td>
                <td><%= wait.agreement ? agreement_link(wait.agreement) : "—" %></td>
                <td><%= wait.agreement ? link_to(wait.agreement.customer.name, customer_path(wait.agreement.customer, aba: "promessas")) : "—" %></td>
                <td><%= wait.contract.label %></td>
                <td data-acoes><%= abrir_painel "Decidir", edit_reversal_wait_path(wait), variante: "secondary", tamanho: "small", "aria-label": "Decidir o estorno do pagamento #{wait.payment.identifier}" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
  <% if @decided.any? %>
    <section class="cartao" aria-labelledby="decididos">
      <header><h2 id="decididos">Decididos há pouco</h2></header>
      <div class="tabela" tabindex="0">
        <table>
          <caption class="apenas-leitor-de-tela">Estornos decididos</caption>
          <thead><tr><th scope="col">Quando</th><th scope="col">Acordo</th><th scope="col" data-numerico>Valor</th><th scope="col">Decisão</th><th scope="col">Quem</th><th scope="col">Motivo</th></tr></thead>
          <tbody>
            <% @decided.each do |wait| %>
              <tr>
                <td><%= datetime_br(wait.decided_at) %></td>
                <td><%= wait.agreement ? agreement_link(wait.agreement) : "—" %></td>
                <td data-numerico><%= money(wait.amount_cents) %></td>
                <td><%= t("reversal_waits.choices.#{wait.decision}") %></td>
                <td><%= wait.decided_by&.name || "—" %></td>
                <td><%= wait.note %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
