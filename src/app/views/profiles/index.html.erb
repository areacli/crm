<% content_for :title, "Perfis" %>
<%= pagina "Perfis", subtitulo: "Conjuntos de permissões de cada credor" do %>
  <%= abrir_painel "Novo perfil", new_profile_path %>
<% end %>

<% if @several_tenants %>
  <form class="filtros" role="search" action="<%= profiles_path %>" method="get">
    <div class="campo">
      <label for="tenant">Credor</label>
      <select id="tenant" name="tenant"><option value="">Todos</option><%= options_for_select(@tenants, params[:tenant]) %></select>
    </div>
    <button type="submit" data-variant="secondary">Filtrar</button>
  </form>
<% end %>

<% if @profiles.empty? %>
  <p class="vazio">Nenhum perfil encontrado.</p>
<% else %>
  <div class="tabela" tabindex="0" data-fixa>
    <table>
      <caption class="apenas-leitor-de-tela">Perfis dos credores</caption>
      <thead>
        <tr>
          <th scope="col">Perfil</th>
          <% if @several_tenants %><th scope="col">Credor</th><% end %>
          <th scope="col" data-numerico>Permissões</th>
          <th scope="col" data-numerico>Usuários</th>
          <th scope="col"><span class="apenas-leitor-de-tela">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <% @profiles.each do |profile| %>
          <% users = @users_by_profile.fetch(profile.id, 0) %>
          <tr>
            <th scope="row"><%= abrir_painel profile.name, edit_profile_path(profile), variante: "link" %></th>
            <% if @several_tenants %><td><%= profile.tenant.name %></td><% end %>
            <td data-numerico><%= profile.permissions.size %> de <%= Permission::ALL.size %></td>
            <td data-numerico><%= users %></td>
            <td data-acoes>
              <%= menu_de_linha("perfil-#{profile.id}", "Ações do perfil #{profile.name}") do %>
                <%= abrir_painel "Editar", edit_profile_path(profile) %>
                <%= confirmar_no_painel "Apagar", titulo: "Apagar o perfil #{profile.name}?", acao: "Apagar o perfil", url: profile_path(profile), metodo: :delete,
                                        mensagem: users.positive? ? "O perfil está em uso por #{users} #{'usuário'.pluralize(users)} e não pode ser apagado." : "O perfil deixa de existir." %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/paginacao", pagination: @pagination, unit: "perfis", path: ->(page) { profiles_path(request.query_parameters.merge("page" => page)) } %>
<% end %>
