<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>CRM AreaCli</title>
    <%= csrf_meta_tags %>
    <%# O cliente do Action Cable (gem do Rails, módulo ES) que o serviço de tempo real importa. %>
    <meta name="actioncable-module" content="<%= asset_path("actioncable.esm.js") %>">
    <link rel="icon" href="<%= image_path("simbolo.svg") %>" type="image/svg+xml">
    <%# A configuração inicial vai como dado (não é script executável); a aplicação a lê no início. %>
    <script type="application/json" id="configuracao-da-casca"><%= raw json_escape(@configuracao.to_json) %></script>
    <script id="sap-ui-bootstrap" src="/ui5/<%= @configuracao[:openui5] %>/resources/sap-ui-core.js"
      data-sap-ui-theme="sap_horizon" data-sap-ui-language="pt-BR" data-sap-ui-async="true" data-sap-ui-compat-version="edge"
      data-sap-ui-resource-roots='<%= { crm: @configuracao[:aplicacao] }.to_json %>' data-sap-ui-on-init="module:crm/inicio"
      data-sap-ui-xx-wait-for-theme="init"></script>
  </head>
  <body class="sapUiBody" id="conteudo"></body>
</html>
