<%# Refeita pela SPA a cada evento do WebSocket (cable:indexes-changed). %>
<div id="indices" class="pagina-em-secoes">
  <section class="cartao" aria-labelledby="situacao">
    <header>
      <h2 id="situacao">Situação da busca</h2>
      <% if Current.user.permitted_anywhere?("change_financial_policies") %>
        <div class="acoes">
          <% if @running %>
            <span role="status">Busca em andamento</span>
          <% else %>
            <%= button_to "Buscar índices agora", settings_index_search_path, data: { variant: "secondary", size: "small" } %>
          <% end %>
        </div>
      <% end %>
    </header>
    <div>
      <% if @last_success %>
        <p>Última busca com sucesso: <%= datetime_br(@last_success.finished_at || @last_success.started_at) %>.</p>
      <% else %>
        <p>Ainda não houve busca com sucesso.</p>
      <% end %>
      <% if @last_failure && (@last_success.nil? || @last_failure.started_at > @last_success.started_at) %>
        <%= aviso(tom: :danger) do %>
          <p>Falha em <%= datetime_br(@last_failure.started_at) %>: <%= @last_failure.note %>
            <% if @last_success %>Há <%= (Date.current - (@last_success.finished_at || @last_success.started_at).to_date).to_i %> dias sem busca com sucesso.<% end %></p>
        <% end %>
      <% end %>
      <% if @runs.any? %>
        <div class="tabela" tabindex="0">
          <table>
            <caption class="apenas-leitor-de-tela">Últimas buscas</caption>
            <thead><tr><th scope="col">Quando</th><th scope="col">Resultado</th><th scope="col" data-numerico>Meses gravados</th></tr></thead>
            <tbody>
              <% @runs.each do |run| %>
                <tr><th scope="row"><%= datetime_br(run.started_at) %></th><td><%= run.note.present? ? cortado("#{t("indexes.run_status.#{run.status}")} — #{run.note}") : t("indexes.run_status.#{run.status}") %></td><td data-numerico><%= number_br(run.processed) %></td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </section>

  <% if @grid.empty? %>
    <p class="vazio">Nenhum índice gravado ainda. A primeira busca traz as séries desde janeiro de 2000.</p>
  <% end %>
  <% @tenants.each do |tenant| %>
    <% can_correct = @can_correct.include?(tenant.id) %>
    <section class="cartao" aria-labelledby="indices-<%= tenant.id %>">
      <header>
        <h2 id="indices-<%= tenant.id %>"><%= tenant.name %></h2>
        <% if can_correct %><div class="acoes"><%= abrir_painel "Editar índice", new_settings_index_adjustment_path(credor: tenant.id), variante: "secondary", tamanho: "small" %></div><% end %>
      </header>
      <div>
        <% unless @grid.empty? %>
          <div class="tabela" tabindex="0">
            <table data-detalhes>
              <caption class="apenas-leitor-de-tela">Índices mensais de <%= tenant.name %></caption>
              <thead><tr><th scope="col"><%= alternar_todos_os_detalhes %>Mês</th><% IndexRate::SERIES.each do |series| %><th scope="col" data-numerico><%= IndexRate.label(series) %></th><% end %></tr></thead>
              <tbody>
                <% @grid.months.each do |month| %>
                  <% cells = IndexRate::SERIES.map { |series| [ series, @grid.cell(tenant.id, series, month) ] } %>
                  <% detail_id = "detalhe-indices-#{tenant.id}-#{month.strftime("%Y-%m")}" %>
                  <tr>
                    <th scope="row"><%= alternar_detalhe(detail_id, "índices de #{months_label(month)}") %><%= months_label(month) %></th>
                    <% cells.each do |series, cell| %>
                      <td data-numerico>
                        <% if cell.adjustment %>
                          <%= situacao "Corrigido", tom: :warning %> <%= index_percent(cell.adjustment.value) %>
                        <% elsif cell.bank %>
                          <%= index_percent(cell.bank) %><%= " (parcial)" if cell.partial %>
                        <% else %>
                          sem valor
                        <% end %>
                      </td>
                    <% end %>
                  </tr>
                  <%= detalhe_da_linha(detail_id, IndexRate::SERIES.size + 1) do %>
                    <% cells.each do |series, cell| %>
                      <% if cell.adjustment %>
                        <p><strong><%= IndexRate.label(series) %>:</strong> corrigido para <%= index_percent(cell.adjustment.value) %><%= cell.bank ? " (Banco Central: #{index_percent(cell.bank)})" : " (incluído à mão)" %>
                          em <%= datetime_br(cell.adjustment.adjusted_at) %><%= " por #{cell.adjustment.user.name}" if cell.adjustment.user %>: <%= cell.adjustment.reason %>
                          <% if can_correct %><%= abrir_painel "Desfazer", new_settings_index_adjustment_path(desfazer: cell.adjustment.id), variante: "link", tamanho: "small", "aria-label": "Desfazer a correção de #{IndexRate.label(series)} em #{months_label(month)}" %><% end %></p>
                      <% elsif cell.bank %>
                        <p><strong><%= IndexRate.label(series) %>:</strong> Banco Central, buscado em <%= date_br(cell.fetched_at.to_date) %><%= ", parcial" if cell.partial %>.</p>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @grid.pages > 1 %>
            <nav class="paginacao" aria-label="Meses">
              <% if @grid.page > 1 %><%= link_to "Meses mais novos", settings_indexes_path(pagina: @grid.page - 1) %><% end %>
              <span>Página <%= @grid.page %> de <%= @grid.pages %></span>
              <% if @grid.page < @grid.pages %><%= link_to "Meses anteriores", settings_indexes_path(pagina: @grid.page + 1) %><% end %>
            </nav>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
