<%= formulario_de_painel(titulo: "Novo resultado de acionamento", url: settings_contact_results_path, enviar: "Salvar", escopo: :contact_result, erro: @result.errors.full_messages.to_sentence.presence, voltar: settings_contact_results_path) do |form| %>
  <% if @tenants.size > 1 %>
    <div class="campo">
      <%= form.label :tenant_id, "Credor" %>
      <%= form.select :tenant_id, @tenants.map { |tenant| [ tenant.name, tenant.id ] }, { selected: @result.tenant_id }, required: true %>
    </div>
  <% else %>
    <%= form.hidden_field :tenant_id, value: @tenants.first&.id %>
    <p>Credor: <strong><%= @tenants.first&.name %></strong></p>
  <% end %>
  <%= render "settings/contact_results/fields", form: form, result: @result, kind_locked: false %>
<% end %>
