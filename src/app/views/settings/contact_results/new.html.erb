<% content_for :title, "Configuração · Novo resultado" %>
<header class="cabecalho-da-pagina"><div><h1>Novo resultado de acionamento</h1><p><%= link_to "Voltar para os resultados", settings_contact_results_path %></p></div></header>
<%= render "settings/abas" %>
<section class="cartao" aria-labelledby="dados">
  <header><h2 id="dados">Dados do resultado</h2></header>
  <div>
    <% if @result.errors.any? %><%= aviso(tom: :danger) { tag.p @result.errors.full_messages.to_sentence } %><% end %>
    <%= form_with model: @result, scope: :contact_result, url: settings_contact_results_path, html: { "hx-boost": "false" } do |form| %>
      <% if @tenants.size > 1 %>
        <div class="campo">
          <%= form.label :tenant_id, "Credor" %>
          <%= form.select :tenant_id, @tenants.map { |tenant| [ tenant.name, tenant.id ] }, { selected: @result.tenant_id }, required: true %>
        </div>
      <% else %>
        <%= form.hidden_field :tenant_id, value: @tenants.first&.id %>
        <p>Credor: <strong><%= @tenants.first&.name %></strong></p>
      <% end %>
      <%= render "settings/contact_results/fields", form: form, result: @result, kind_locked: false %>
      <div class="acoes">
        <button type="submit">Salvar</button>
        <%= link_to "Cancelar", settings_contact_results_path, class: "botao", data: { variant: "secondary" } %>
      </div>
    <% end %>
  </div>
</section>
