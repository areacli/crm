<%= formulario_de_painel(titulo: "Resultado #{@result.name_was}", descricao: @result.tenant.name, url: settings_contact_result_path(@result), metodo: :patch, enviar: "Salvar", escopo: :contact_result,
                         erro: @result.errors.full_messages.to_sentence.presence, voltar: settings_contact_results_path) do |form| %>
  <%= render "settings/contact_results/fields", form: form, result: @result, kind_locked: true %>
<% end %>
