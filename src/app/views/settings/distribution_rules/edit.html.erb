<%= formulario_de_painel(titulo: "Mudar o item #{@segment.name}", url: settings_distribution_rule_path(@index, tenant_id: @tenant.id), metodo: :patch, enviar: "Conferir o impacto", escopo: :rule,
                         variante: :modal, tamanho: :small, voltar: settings_distribution_rules_path(tenant_id: @tenant.id)) do |form| %>
  <fieldset>
    <legend>Operações</legend>
    <% @accredited.each do |operation| %><label><%= check_box_tag "rule[operation_ids][]", operation.id, @item.operation_ids.include?(operation.id), id: "operacao-#{operation.id}" %> <%= operation.short_name %></label><% end %>
  </fieldset>
  <div class="campo"><%= form.label :exposure, "Exposição" %><%= form.select :exposure, Distribution::EXPOSURES.map { [ t("distributions.exposures.#{_1}"), _1 ] }, selected: @item.exposure %></div>
<% end %>
