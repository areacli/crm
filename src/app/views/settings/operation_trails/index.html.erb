<% content_for :title, "Operações · Trilha" %>
<%= pagina "Trilha das operações", subtitulo: "O que os usuários das operações abriram, buscaram, não encontraram e exportaram. Guardada por 12 meses." %>
<%= render "settings/modelo" %>
<form class="filtros" role="search" action="<%= settings_operation_trails_path %>" method="get">
  <div class="campo"><label for="operation">Operação</label><select id="operation" name="operacao"><option value="">Todas</option><%= options_for_select(@operations, params[:operacao]) %></select></div>
  <div class="campo"><label for="user">Usuário</label><select id="user" name="usuario"><option value="">Todos</option><%= options_for_select(@users, params[:usuario]) %></select></div>
  <div class="campo"><label for="kind">Tipo</label><select id="kind" name="tipo"><option value="">Todos</option><%= opcoes_de_filtro(OperationTrailEvent::KINDS.map { [ t("operation_trails.kinds.#{_1}"), _1 ] }, params[:tipo]) %></select></div>
  <div class="campo"><label for="from">De</label><input type="date" id="from" name="de" value="<%= params[:de] %>"></div>
  <div class="campo"><label for="to">Até</label><input type="date" id="to" name="ate" value="<%= params[:ate] %>"></div>
  <button type="submit" data-variant="secondary">Filtrar</button>
</form>
<% if @events.empty? %>
  <p class="vazio">Nada registrado no período.</p>
<% else %>
  <div class="tabela" tabindex="0" data-fixa>
    <table>
      <caption class="apenas-leitor-de-tela">Trilha das operações</caption>
      <thead><tr><th scope="col">Quando</th><th scope="col">Operação</th><th scope="col">Usuário</th><th scope="col">O quê</th><th scope="col">Detalhe</th></tr></thead>
      <tbody>
        <% @events.each do |event| %>
          <tr>
            <td><%= datetime_br(event.created_at) %></td>
            <td><%= event.operation.short_name %></td>
            <td><%= event.user.name %></td>
            <td><%= t("operation_trails.kinds.#{event.kind}") %></td>
            <td><%= event.customer ? link_to(event.customer.name, customer_path(event.customer)) : (event.query_text ? "“#{event.query_text}” (#{number_br(event.results.to_i)} resultados)" : "—") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/paginacao", pagination: @pagination, unit: "registros", path: ->(page) { settings_operation_trails_path(request.query_parameters.merge("pagina" => page)) } %>
<% end %>
