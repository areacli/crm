<%= formulario_de_painel(titulo: "Novo canal de recebimento", url: settings_channels_path, enviar: "Salvar", escopo: :payment_channel, erro: @channel.errors.full_messages.to_sentence.presence, voltar: settings_channels_path) do |form| %>
  <% if @tenants.size > 1 %>
    <div class="campo">
      <%= form.label :tenant_id, "Credor" %>
      <%= form.select :tenant_id, @tenants.map { |tenant| [ tenant.name, tenant.id ] }, { selected: @channel.tenant_id }, required: true %>
    </div>
  <% else %>
    <%= form.hidden_field :tenant_id, value: @tenants.first&.id %>
    <p>Credor: <strong><%= @tenants.first&.name %></strong></p>
  <% end %>
  <%= render "settings/channels/fields", form: form, channel: @channel, code_locked: false %>
<% end %>
