<% content_for :title, "Configuração · Métodos de recebimento" %>
<%= pagina "Métodos de recebimento", subtitulo: "Por onde o dinheiro entra. O código é o que a planilha de pagamentos traz; as integrações com fornecedores ficam no detalhe de cada método." do %>
  <% if policy(PaymentChannel).new? %><%= abrir_painel "Criar método de recebimento", new_settings_channel_path %><% end %>
  <% if policy(PaymentAccount).new? %><%= link_to "Criar integração", new_settings_payment_account_path, class: "botao", data: { variant: "secondary" } %><% end %>
<% end %>
<%= render "settings/modelo" %>

<form class="filtros" role="search" action="<%= settings_channels_path %>" method="get">
  <div class="campo">
    <label for="q" class="apenas-leitor-de-tela">Buscar por código ou descrição</label>
    <input type="search" id="q" name="busca" value="<%= params[:busca] %>" autocomplete="off" placeholder="Código ou descrição">
  </div>
  <% if @several_tenants %>
    <div class="campo">
      <label for="tenant">Credor</label>
      <select id="tenant" name="credor">
        <option value="">Todos</option>
        <%= options_for_select(@tenants, params[:credor]) %>
      </select>
    </div>
  <% end %>
  <div class="campo">
    <label for="per_page" class="apenas-leitor-de-tela">Por página</label>
    <select id="per_page" name="por_pagina"><%= options_for_select(Pagination::PER_PAGE_OPTIONS, @pagination.per_page) %></select>
  </div>
  <button type="submit" data-variant="secondary">Buscar</button>
</form>

<%= render "settings/channels/result" %>
