<% content_for :title, "Configuração · Método #{@channel.code_was || @channel.code}" %>
<%= pagina "Método #{@channel.code_was || @channel.code}", subtitulo: "#{@channel.tenant.name} · #{t("payments.channels.kinds.#{@channel.kind_was || @channel.kind}")}" do %>
  <%= confirmar_no_painel "Gerar novo segredo", titulo: "Gerar um novo segredo?", mensagem: "O segredo atual, se houver, deixa de valer na hora: o provedor precisa ser atualizado com o novo.",
                          acao: "Gerar novo segredo", url: settings_channel_webhook_secret_path(@channel), perigoso: false, variante: "secondary" %>
  <% unless @channel.used? %>
    <%= confirmar_no_painel "Excluir", titulo: "Excluir o método de recebimento?", mensagem: "O método #{@channel.code} deixa de existir. Isto fica registrado.", acao: "Excluir método de recebimento", url: settings_channel_path(@channel), metodo: :delete %>
  <% end %>
<% end %>
<%= render "settings/modelo" %>

<%# O formulário estreito à esquerda e o webhook à direita (modelo Entrada). Na recusa (422), a SPA troca a tela pela refeita, com a mensagem. %>
<div class="ficha" data-lateral="esquerda" data-refazer-no-erro>
  <section class="cartao" aria-labelledby="dados">
    <header><h2 id="dados">Dados do método</h2></header>
    <div>
      <%= form_with model: @channel, scope: :payment_channel, url: settings_channel_path(@channel), method: :patch, class: "campos-do-cartao" do |form| %>
        <% if @channel.errors.any? %><%= aviso(tom: :danger) { tag.p @channel.errors.full_messages.to_sentence } %><% end %>
        <%= render "settings/channels/fields", form: form, channel: @channel, code_locked: @channel.used? %>
        <div class="campo">
          <label><%= form.check_box :active, { checked: @channel.active? }, "1", "0" %> Método ativo</label>
          <small>Desativado, não recebe pagamentos novos por planilha; os estornos dos pagamentos dele continuam aceitos.</small>
        </div>
        <div class="acoes" data-rodape><button type="submit">Salvar o método</button></div>
      <% end %>
    </div>
  </section>

  <section class="cartao" aria-labelledby="webhook">
    <header><h2 id="webhook">Webhook de pagamento</h2><%= informacao "webhook", "O provedor envia cada pagamento para o endereço abaixo, com o cabeçalho X-Signature (HMAC SHA-256 do corpo com o segredo do canal). O mesmo evento enviado de novo não é processado outra vez.", "definicao-webhook" %></header>
    <div>
      <dl class="dados">
        <dt>Endereço</dt><dd><code><%= payments_webhook_url(@channel) %></code></dd>
        <dt>Formato</dt><dd><code><%= @channel.webhook_adapter %></code></dd>
        <dt>Segredo</dt><dd><%= @channel.webhook_enabled? ? "Definido (não é mostrado de novo)" : "Ainda não gerado" %></dd>
      </dl>
      <% if @secret %>
        <%= aviso(tom: :warning) do %>
          <p><strong>Copie o segredo agora:</strong> ele só aparece desta vez. <code><%= @secret %></code></p>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
