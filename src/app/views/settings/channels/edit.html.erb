<% content_for :title, "Configuração · Canal #{@channel.code_was || @channel.code}" %>
<%= pagina "Canal #{@channel.code_was || @channel.code}", subtitulo: safe_join([ @channel.tenant.name, " · ", link_to("Voltar para os canais", settings_channels_path) ]) do %>
  <%= confirmar_no_painel (@channel.webhook_enabled? ? "Trocar o segredo" : "Gerar o segredo"), titulo: "Gerar um novo segredo?", mensagem: "O segredo atual, se houver, deixa de valer na hora: o provedor precisa ser atualizado com o novo.",
                          acao: "Gerar segredo", url: settings_channel_webhook_secret_path(@channel), perigoso: false, variante: "secondary" %>
  <% unless @channel.used? %>
    <%= confirmar_no_painel "Apagar", titulo: "Apagar o canal?", mensagem: "O canal #{@channel.code} deixa de existir. Isto fica registrado.", acao: "Apagar canal", url: settings_channel_path(@channel), metodo: :delete %>
  <% end %>
<% end %>
<%= render "settings/abas" %>

<div class="duas-colunas">
  <section class="cartao" aria-labelledby="dados">
    <header><h2 id="dados">Dados do canal</h2></header>
    <div>
      <% if @channel.errors.any? %><%= aviso(tom: :danger) { tag.p @channel.errors.full_messages.to_sentence } %><% end %>
      <%= form_with model: @channel, scope: :payment_channel, url: settings_channel_path(@channel), method: :patch, html: { "hx-boost": "false" } do |form| %>
        <%= render "settings/channels/fields", form: form, channel: @channel, code_locked: @channel.used? %>
        <div class="campo">
          <label><%= form.check_box :active, { checked: @channel.active? }, "1", "0" %> Canal ativo</label>
          <small>Desativado, não recebe pagamentos novos por planilha; os estornos dos pagamentos dele continuam aceitos.</small>
        </div>
        <div class="acoes" data-rodape>
          <%= link_to "Cancelar", settings_channels_path, class: "botao", data: { variant: "secondary" } %>
          <button type="submit">Salvar</button>
        </div>
      <% end %>
    </div>
  </section>

  <section class="cartao" aria-labelledby="webhook">
    <header><h2 id="webhook">Webhook de pagamento</h2><%= informacao "webhook", "O provedor envia cada pagamento para o endereço abaixo, com o cabeçalho X-Signature (HMAC SHA-256 do corpo com o segredo do canal). O mesmo evento enviado de novo não é processado outra vez.", "definicao-webhook" %></header>
    <div>
      <dl class="dados">
        <dt>Endereço</dt><dd><code><%= payments_webhook_url(@channel) %></code></dd>
        <dt>Formato</dt><dd><code><%= @channel.webhook_adapter %></code></dd>
        <dt>Segredo</dt><dd><%= @channel.webhook_enabled? ? "Definido (não é mostrado de novo)" : "Ainda não gerado" %></dd>
      </dl>
      <% if @secret %>
        <%= aviso(tom: :warning) do %>
          <p><strong>Copie o segredo agora:</strong> ele só aparece desta vez. <code><%= @secret %></code></p>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
