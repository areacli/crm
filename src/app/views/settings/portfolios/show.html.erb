<% content_for :title, "Configuração · Carteira" %>
<%= pagina "Carteira", subtitulo: "Faixas de atraso e políticas da carteira, por credor." %>
<%= render "settings/modelo" %>

<%# Modelo Configuração (design system, 9): um cartão por credor; as faixas numa tabela curta de campos, com as salvas ao lado, e cada política na sua linha.
    Na recusa (422), a SPA troca a lista pela que o servidor refez, com as faixas digitadas e a mensagem (`data-refazer-no-erro`). %>
<div class="pagina-em-secoes" data-refazer-no-erro>
<% several_tenants = Current.user.tenant_ids_with("view_portfolio").size > 1 %>
<% @settings.each do |setting| %>
  <% tenant = setting.tenant %>
  <% error = @error if @error && @error[:tenant_id] == tenant.id %>
  <section class="cartao" aria-labelledby="credor-<%= tenant.id %>">
    <header><h2 id="credor-<%= tenant.id %>"><%= tenant.name %></h2></header>
    <div class="campos-do-cartao">
      <% if error %><%= aviso(tom: :danger) { tag.p error[:message] } %><% end %>

      <%= form_with url: settings_portfolio_path, method: :patch do |form| %>
        <%= hidden_field_tag :credor, tenant.id, id: nil %>
        <%= hidden_field_tag :section, "brackets", id: nil %>
        <%# Lista editável (padrões de interface, T6; 01, revisão 8): uma linha em branco, "Criar faixa" e "Excluir" na hora, sem salvar, de 1 a 10 faixas, e a prévia
            acompanhando o que se digita (`spa/faixas`). A validação da R18 é a do salvar. %>
        <fieldset data-faixas data-maximo="<%= Portfolio::AgingBrackets::MAXIMUM %>">
          <legend>Faixas de atraso (dias)</legend>
          <% rows = error && @rows ? @rows : setting.aging_brackets.map { |bracket| [ bracket["from"], bracket["to"] ] } %>
          <% rows += [ [ nil, nil ] ] if rows.size < Portfolio::AgingBrackets::MAXIMUM %>
          <div class="faixas-edicao">
            <div>
              <table class="campos-em-tabela">
                <caption class="apenas-leitor-de-tela">Faixas de atraso de <%= tenant.name %></caption>
                <thead><tr><th scope="col">De</th><th scope="col">Até</th><th scope="col"><span class="apenas-leitor-de-tela">Ações</span></th></tr></thead>
                <tbody>
                  <% rows.each_with_index do |(from, to), index| %>
                    <%= render "settings/portfolios/bracket_row", from: from, to: to, number: index + 1 %>
                  <% end %>
                </tbody>
              </table>
              <template data-modelo-da-faixa><%= render "settings/portfolios/bracket_row", from: nil, to: nil, number: 0 %></template>
              <p><button type="button" data-variant="secondary" data-criar-faixa<%= " disabled" if rows.size >= Portfolio::AgingBrackets::MAXIMUM %>>Criar faixa</button></p>
            </div>
            <div>
              <h3 class="subtitulo-do-cartao">Como vão ficar</h3>
              <ol class="previa" aria-label="Prévia das faixas de atraso de <%= tenant.name %>" aria-live="polite" data-previa-das-faixas>
                <% Portfolio::AgingBrackets.preview(rows).each do |label| %><li><%= label %> dias</li><% end %>
              </ol>
              <p><small>A primeira começa em 1 dia, sem buraco nem sobreposição, e a última não tem fim. De 1 a <%= Portfolio::AgingBrackets::MAXIMUM %> faixas; linha em branco não é usada.</small></p>
              <% if several_tenants %>
                <p><small>Estas faixas valem no resumo deste credor, na lista de clientes e na ficha. No resumo de todos os credores valem as faixas padrão do sistema.</small></p>
              <% end %>
            </div>
          </div>
        </fieldset>
        <div class="acoes" data-rodape><button type="submit">Salvar faixas</button></div>
      <% end %>

      <%# Divergência de valor (05, R104): cartão de política com o efeito e o exemplo de cada opção. Sem a permissão 14, texto sem campo (P20). %>
      <% can_change_policy = Current.user.permitted?("change_financial_policies", tenant) %>
      <% policy_body = capture do %>
        <%= politica("Divergência de valor", "pol-1-#{tenant.id}", ajuda: "O que fazer quando uma carga traz outro valor para um título que já tem pagamento. Vale para as cargas seguintes; as divergências já registradas não mudam.") do %>
          <% TenantSetting.defined_enums.fetch("discrepancy_policy").each_key do |value| %>
            <% if can_change_policy %>
              <label>
                <%= radio_button_tag :discrepancy_policy, value, setting.discrepancy_policy == value, id: "discrepancy-#{tenant.id}-#{value}" %>
                <strong><%= t("discrepancies.policies.#{value}") %></strong>
                <small><%= t("discrepancies.policy_help.#{value}") %></small>
              </label>
            <% else %>
              <p>
                <strong><%= t("discrepancies.policies.#{value}") %></strong>
                <% if setting.discrepancy_policy == value %><%= situacao "Escolha atual", tom: :info %><% end %>
                <br><small><%= t("discrepancies.policy_help.#{value}") %></small>
              </p>
            <% end %>
          <% end %>
          <% unless can_change_policy %><p><small>Só quem altera políticas financeiras muda esta política.</small></p><% end %>
        <% end %>
      <% end %>
      <% if can_change_policy %>
        <%= form_with url: settings_portfolio_path, method: :patch do |form| %>
          <%= hidden_field_tag :credor, tenant.id, id: nil %>
          <%= hidden_field_tag :section, "discrepancy", id: nil %>
          <%= policy_body %>
          <div class="acoes" data-rodape><button type="submit">Salvar política de divergência</button></div>
        <% end %>
      <% else %>
        <%= policy_body %>
      <% end %>

      <%# Correção na tela ou carga: qual vale (06, R117): cartão de política com o efeito e o exemplo de cada opção. %>
      <% last_correction = Change.where(subject_type: "settings", subject_id: tenant.id, field: "correction_policy").includes(:user).order(occurred_at: :desc, id: :desc).first %>
      <%= form_with url: settings_portfolio_path, method: :patch do |form| %>
        <%= hidden_field_tag :credor, tenant.id, id: nil %>
        <%= hidden_field_tag :section, "correction", id: nil %>
        <%= politica("Correção na tela ou carga: qual vale", "pol-2-#{tenant.id}", ajuda: "Quando a pessoa corrige o nome ou um contato de um cliente na tela e a carga seguinte traz outro valor. Vale para as cargas seguintes; a carga nunca apaga um contato.") do %>
          <% TenantSetting.defined_enums.fetch("correction_policy").each_key do |value| %>
            <label>
              <%= radio_button_tag :correction_policy, value, setting.correction_policy == value, id: "correction-#{tenant.id}-#{value}" %>
              <strong><%= t("registry.correction_policies.#{value}") %></strong>
              <small><%= t("registry.correction_policy_help.#{value}") %></small>
            </label>
          <% end %>
          <% if last_correction %><p><small>Alterada por <%= last_correction.user&.name || "sistema" %> em <%= datetime_br(last_correction.occurred_at) %>.</small></p><% end %>
        <% end %>
        <div class="acoes" data-rodape><button type="submit">Salvar política de correção</button></div>
      <% end %>

      <%= form_with url: settings_portfolio_path, method: :patch do |form| %>
        <%= hidden_field_tag :credor, tenant.id, id: nil %>
        <%= hidden_field_tag :section, "upcoming", id: nil %>
        <%= politica("Títulos a vencer", "pol-3-#{tenant.id}") do %>
          <% { "separate" => "Mostrar à parte do vencido", "summed" => "Somar ao vencido, mostrando o vencido em separado", "detail_only" => "Só na ficha do cliente, fora dos totais" }.each do |value, label| %>
            <label><%= radio_button_tag :upcoming_display, value, setting.upcoming_display == value, id: "upcoming-#{tenant.id}-#{value}" %> <%= label %></label>
          <% end %>
        <% end %>
        <div class="acoes" data-rodape><button type="submit">Salvar a exibição dos títulos a vencer</button></div>
      <% end %>
    </div>
  </section>
<% end %>
</div>
