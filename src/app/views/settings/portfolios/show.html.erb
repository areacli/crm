<% content_for :title, "Configuração · Carteira" %>
<header class="cabecalho-da-pagina"><h1>Carteira</h1></header>
<%= render "settings/abas" %>

<% @settings.each do |setting| %>
  <% tenant = setting.tenant %>
  <% error = @error if @error && @error[:tenant_id] == tenant.id %>
  <section class="cartao" aria-labelledby="credor-<%= tenant.id %>">
    <header><h2 id="credor-<%= tenant.id %>"><%= tenant.name %></h2></header>
    <div>
      <% if error %><%= aviso(tom: :danger) { tag.p error[:message] } %><% end %>

      <%= form_with url: settings_portfolio_path, method: :patch, html: { "hx-boost": "false" } do |form| %>
        <%= hidden_field_tag :tenant_id, tenant.id %>
        <%= hidden_field_tag :section, "brackets" %>
        <fieldset>
          <legend>Faixas de atraso (dias)</legend>
          <p><small>A primeira começa em 1 dia, sem buraco nem sobreposição, e a última não tem fim. Deixe a linha em branco para não usar.</small></p>
          <% rows = setting.aging_brackets.map { |bracket| [ bracket["from"], bracket["to"] ] } + [ [ nil, nil ], [ nil, nil ] ] %>
          <% rows.each_with_index do |(from, to), index| %>
            <div class="acoes">
              <div class="campo"><label for="from-<%= tenant.id %>-<%= index %>">Faixa <%= index + 1 %>: de</label><input type="number" min="1" id="from-<%= tenant.id %>-<%= index %>" name="brackets[][from]" value="<%= from %>"></div>
              <div class="campo"><label for="to-<%= tenant.id %>-<%= index %>">até</label><input type="number" min="1" id="to-<%= tenant.id %>-<%= index %>" name="brackets[][to]" value="<%= to %>"></div>
            </div>
          <% end %>
        </fieldset>
        <div class="acoes"><button type="submit">Salvar faixas</button></div>
      <% end %>

      <%# Divergência de valor (05, R104): cartão de política com o efeito e o exemplo de cada opção. Sem a permissão 14, texto sem campo (P20). %>
      <% can_change_policy = Current.user.permitted?("change_financial_policies", tenant) %>
      <% policy_body = capture do %>
        <fieldset>
          <legend>Divergência de valor</legend>
          <p><small>O que fazer quando uma carga traz outro valor para um título que já tem pagamento. Vale para as cargas seguintes; as divergências já registradas não mudam.</small></p>
          <% TenantSetting.defined_enums.fetch("discrepancy_policy").each_key do |value| %>
            <% if can_change_policy %>
              <label>
                <%= radio_button_tag :discrepancy_policy, value, setting.discrepancy_policy == value, id: "discrepancy-#{tenant.id}-#{value}" %>
                <strong><%= t("discrepancies.policies.#{value}") %></strong>
                <small><%= t("discrepancies.policy_help.#{value}") %></small>
              </label>
            <% else %>
              <p>
                <strong><%= t("discrepancies.policies.#{value}") %></strong>
                <% if setting.discrepancy_policy == value %><%= situacao "Escolha atual", tom: :info %><% end %>
                <br><small><%= t("discrepancies.policy_help.#{value}") %></small>
              </p>
            <% end %>
          <% end %>
          <% unless can_change_policy %><p><small>Só quem altera políticas financeiras muda esta política.</small></p><% end %>
        </fieldset>
      <% end %>
      <% if can_change_policy %>
        <%= form_with url: settings_portfolio_path, method: :patch, html: { "hx-boost": "false" } do |form| %>
          <%= hidden_field_tag :tenant_id, tenant.id %>
          <%= hidden_field_tag :section, "discrepancy" %>
          <%= policy_body %>
          <div class="acoes"><button type="submit">Salvar política de divergência</button></div>
        <% end %>
      <% else %>
        <%= policy_body %>
      <% end %>

      <%# Correção na tela ou carga: qual vale (06, R117): cartão de política com o efeito e o exemplo de cada opção. %>
      <% last_correction = Change.where(subject_type: "settings", subject_id: tenant.id, field: "correction_policy").includes(:user).order(occurred_at: :desc, id: :desc).first %>
      <%= form_with url: settings_portfolio_path, method: :patch, html: { "hx-boost": "false" } do |form| %>
        <%= hidden_field_tag :tenant_id, tenant.id %>
        <%= hidden_field_tag :section, "correction" %>
        <fieldset>
          <legend>Correção na tela ou carga: qual vale</legend>
          <p><small>Quando a pessoa corrige o nome ou um contato de um cliente na tela e a carga seguinte traz outro valor. Vale para as cargas seguintes; a carga nunca apaga um contato.</small></p>
          <% TenantSetting.defined_enums.fetch("correction_policy").each_key do |value| %>
            <label>
              <%= radio_button_tag :correction_policy, value, setting.correction_policy == value, id: "correction-#{tenant.id}-#{value}" %>
              <strong><%= t("registry.correction_policies.#{value}") %></strong>
              <small><%= t("registry.correction_policy_help.#{value}") %></small>
            </label>
          <% end %>
          <% if last_correction %><p><small>Alterada por <%= last_correction.user&.name || "sistema" %> em <%= datetime_br(last_correction.occurred_at) %>.</small></p><% end %>
        </fieldset>
        <div class="acoes"><button type="submit">Salvar política de correção</button></div>
      <% end %>

      <%= form_with url: settings_portfolio_path, method: :patch, html: { "hx-boost": "false" } do |form| %>
        <%= hidden_field_tag :tenant_id, tenant.id %>
        <%= hidden_field_tag :section, "upcoming" %>
        <fieldset>
          <legend>Títulos a vencer</legend>
          <% { "separate" => "Mostrar à parte do vencido", "summed" => "Somar ao vencido, mostrando o vencido em separado", "detail_only" => "Só na ficha do cliente, fora dos totais" }.each do |value, label| %>
            <label><%= radio_button_tag :upcoming_display, value, setting.upcoming_display == value %> <%= label %></label>
          <% end %>
        </fieldset>
        <div class="acoes"><button type="submit">Salvar</button></div>
      <% end %>
    </div>
  </section>
<% end %>
