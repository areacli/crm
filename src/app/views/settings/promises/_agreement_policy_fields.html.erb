<%# Campos das políticas dos acordos (escolha ou valor), cada um com a ajuda e "Ver histórico". Locais: tenant, policies, history, keys. %>
<% keys.each do |key| %>
  <% entry = Agreements::Policies.entry(key) %>
  <% changes = history.select { |change| change.field == key }.first(10) %>
  <fieldset>
    <legend><%= t("agreements.policies.#{key}.title") %></legend>
    <p><small><%= t("agreements.policies.#{key}.help") %></small></p>
    <% if entry.kind == :choice %>
      <% entry.options.each do |option| %>
        <label><%= radio_button_tag "policies[#{key}]", option, policies[key] == option, id: "pol-#{tenant.id}-#{key}-#{option}" %> <%= t("agreements.policies.#{key}.options.#{option}") %></label>
      <% end %>
    <% else %>
      <% value = policies[key] %>
      <div class="grupo-de-campos">
        <div class="campo">
          <%= label_tag "pol-#{tenant.id}-#{key}-kind", "Em" %>
          <%= select_tag "policies[#{key}][kind]", options_for_select(entry.options.map { |option| [ t("agreements.policies.#{key}.options.#{option}"), option ] }, value["kind"]), id: "pol-#{tenant.id}-#{key}-kind" %>
        </div>
        <div class="campo">
          <%= label_tag "pol-#{tenant.id}-#{key}-value", "Valor (reais ou percentual)" %>
          <%= text_field_tag "policies[#{key}][value]", policy_amount_field(value), id: "pol-#{tenant.id}-#{key}-value", inputmode: "decimal", autocomplete: "off" %>
        </div>
      </div>
    <% end %>
    <% if changes.any? %>
      <details>
        <summary>Ver histórico</summary>
        <ul>
          <% changes.each do |change| %><li><%= datetime_br(change.occurred_at) %>, <%= change.user&.name || "—" %>: de <%= change.before.presence || "—" %> para <%= change.after.presence || "—" %>.</li><% end %>
        </ul>
      </details>
    <% end %>
  </fieldset>
<% end %>
