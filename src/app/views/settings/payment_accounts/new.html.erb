<%# Integração nova (16, revisão 1, R373b) e troca de fornecedor (R373c). Do quadro do meio vêm credor, meio e ambiente; a integração que se troca fixa os três.
    Sem eles (um endereço antigo), a página pede a escolha. %>
<% modality = @account.modality.present? ? t("payments.accounts.modalities.#{@account.modality}") : nil %>
<% titulo = @replaced ? t("payments.methods.replace.title", modality: modality) : [ "Nova integração", modality ].compact.join(": ") %>
<% fixed = @replaced || (@account.modality.present? && @account.tenant_id.present? && @tenants.exists?(@account.tenant_id)) %>
<% subtitulo = fixed ? safe_join([ Tenant.find(@account.tenant_id).name, t("payments.accounts.environments.#{@account.environment}"), (@replaced && "hoje pela integração #{@replaced.nickname} (#{provider_name(@replaced.provider)})") ].compact, " · ") : "Um fornecedor de boleto, Pix ou cartão de crédito ligado a um método de recebimento do credor." %>
<% content_for :title, "Configuração · #{titulo}" %>
<%= pagina titulo, subtitulo: subtitulo %>
<%= render "settings/modelo" %>

<%# Um formulário só (aba própria): a escolha do fornecedor (e, sem o quadro, do credor, do meio e do ambiente) pede ao servidor os blocos que dependem dela
    (`data-spa-dependentes`), que entram no lugar dos atuais sem tirar o que já foi escolhido. Na recusa (422), a SPA troca a tela pela que o servidor refez. %>
<div class="ficha" data-lateral="esquerda" data-refazer-no-erro>
  <section class="cartao" aria-labelledby="integracao-nova">
    <header><h2 id="integracao-nova"><%= @replaced ? "Integração nova" : "Integração" %></h2></header>
    <%= form_with url: settings_payment_accounts_path, scope: :payment_account, multipart: true, class: "campos-do-cartao" do |form| %>
      <% if @account.errors.any? %><%= aviso(tom: :danger) { tag.p @account.errors.full_messages.to_sentence } %><% end %>
      <% if @replaced %>
        <%= hidden_field_tag "payment_account[replaces_id]", @replaced.id, id: nil %>
        <%= aviso(tom: :warning) { tag.p replacement_warning(@replaced) } %>
      <% end %>
      <div class="campos-do-cartao" data-spa-dependentes="<%= new_settings_payment_account_path %>">
        <% if fixed %>
          <%= hidden_field_tag "payment_account[tenant_id]", @account.tenant_id, id: nil %>
          <%= hidden_field_tag "payment_account[modality]", @account.modality, id: nil %>
          <%= hidden_field_tag "payment_account[environment]", @account.environment, id: nil %>
        <% else %>
          <div class="campo">
            <%= form.label :tenant_id, "Credor" %>
            <%= form.select :tenant_id, @tenants.map { |tenant| [ tenant.name, tenant.id ] }, { selected: @account.tenant_id || @tenants.first&.id } %>
          </div>
          <div class="campo">
            <%= form.label :modality, "Meio de pagamento" %>
            <%= form.select :modality, Payments::Providers::MODALITIES.map { |item| [ t("payments.accounts.modalities.#{item}"), item ] }, { include_blank: "Escolha o meio", selected: @account.modality } %>
          </div>
          <div class="campo">
            <%= form.label :environment, "Ambiente" %>
            <%= form.select :environment, PaymentAccount.environments.keys.map { |environment| [ t("payments.accounts.environments.#{environment}"), environment ] }, { selected: @account.environment } %>
          </div>
        <% end %>
        <%= render "settings/payment_accounts/providers" %>
      </div>
      <%= render "settings/payment_accounts/choice_fields", form: form %>
      <footer class="acoes" data-rodape><button type="submit">Salvar a integração</button></footer>
    <% end %>
  </section>

  <% if @replaced %>
    <section class="cartao" aria-labelledby="integracao-de-hoje">
      <header><h2 id="integracao-de-hoje">A integração de hoje</h2></header>
      <div>
        <dl class="dados">
          <dt>Fornecedor</dt><dd><%= provider_name(@replaced.provider) %></dd>
          <dt>Apelido</dt><dd><%= @replaced.nickname %></dd>
          <dt>Método de recebimento</dt><dd><%= "#{@replaced.channel.code} · #{@replaced.channel.description}" %></dd>
          <dt>Instrumentos vigentes</dt><dd><%= number_with_delimiter(@replaced.instruments.where(open: true).count) %></dd>
          <dt>Depois da troca</dt><dd>Desativada, com a troca no histórico. O que ela emitiu continua sendo cancelado e conferido por ela.</dd>
        </dl>
      </div>
    </section>
  <% else %>
    <section class="cartao" aria-labelledby="como-funciona">
      <header><h2 id="como-funciona">Como a integração funciona</h2></header>
      <div>
        <ol class="passos">
          <li><strong>Fornecedor.</strong> A lista traz só quem emite o meio. Cada fornecedor pede coisas diferentes, e os campos mudam com a escolha.</li>
          <li><strong>Ambiente.</strong> Comece em homologação; a produção é outra integração, criada na linha de Produção do quadro do meio.</li>
          <li><strong>Segredos.</strong> Chaves e certificado são cifrados ao salvar e não voltam para a tela; para trocar, preencha de novo.</li>
          <li><strong>Teste.</strong> Depois de salvar, "Testar conexão" confere as credenciais com o fornecedor.</li>
          <li><strong>Aviso de pagamento.</strong> O segredo do webhook é gerado depois, na integração salva.</li>
        </ol>
      </div>
    </section>
  <% end %>
</div>
