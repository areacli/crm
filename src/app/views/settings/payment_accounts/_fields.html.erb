<%# Campos do manifesto do fornecedor, nos grupos Acesso e Cobrança (16, revisão 1, R373b; 12, revisão 8, R259). Locais: form, account.
    Segredo e arquivo entram em branco e nunca voltam (R261). O fornecedor de conexão por autorização não tem credencial: o grupo Acesso diz como conectar.
    O grupo Acesso sempre aparece, porque abre com a conta da integração (16, revisão 2; 12, R260), comum a todo fornecedor. %>
<% manifest = account.manifest %>
<% visible = account.fields.reject(&:generated) %>
<% authorization = Payments::Connection.authorization?(account) %>
<% Payments::Providers::Manifest::GROUPS.each do |group| %>
  <% group_fields = visible.select { |field| field.group == group } %>
  <% next if group_fields.empty? && group != "access" %>
  <fieldset class="grupo-da-integracao">
    <legend><%= t("payments.methods.groups.#{group}") %></legend>
    <p class="ajuda-do-grupo"><%= t("payments.methods.group_help.#{group}") %></p>
    <% if group == "access" %>
      <div class="campo">
        <%= label_tag "campo-account-code", t("payments.methods.account_code.label") %>
        <%= text_field_tag "payment_account[account_code]", account.account_code, id: "campo-account-code", required: true, maxlength: 100, "aria-describedby": "campo-account-code-ajuda" %>
        <small id="campo-account-code-ajuda"><%= t("payments.methods.account_code.help") %></small>
      </div>
    <% end %>
    <% if group == "access" && authorization %>
      <% provider = manifest.label %>
      <% if account.new_record? && local_assigns[:replaced] %>
        <%= aviso(tom: :info) { tag.p t("payments.methods.replace.authorization", provider: provider, modality: t("payments.accounts.modalities.#{account.modality}").downcase, nickname: local_assigns[:replaced].nickname) } %>
      <% elsif account.new_record? %>
        <p><%= t("payments.connection.connect_help", provider: provider) %></p>
      <% else %>
        <p><%= connection_state(account) %></p>
      <% end %>
    <% end %>
<% group_fields.each do |field| %>
  <% id = "campo-#{field.name}" %>
  <% label = manifest.label_of(field) %>
  <% help = manifest.help_of(field) %>
  <div class="campo">
    <% if field.type == "text" %>
      <%= label_tag id, label %>
      <%= text_field_tag "payment_account[config][#{field.name}]", account.config.fetch(field.name) { field.default if account.new_record? }, id: id, required: field.required, maxlength: field.maxlength, "aria-describedby": ("#{id}-ajuda" if help.present?) %>
    <% elsif field.type == "number" %>
      <%= label_tag id, label %>
      <%= number_field_tag "payment_account[config][#{field.name}]", account.config.fetch(field.name) { field.default if account.new_record? }, id: id, required: field.required, min: field.min, max: field.max, step: "any", "aria-describedby": ("#{id}-ajuda" if help.present?) %>
    <% elsif field.type == "select" %>
      <%= label_tag id, label %>
      <%= select_tag "payment_account[config][#{field.name}]", options_for_select(field.options.map { |option| [ manifest.option_label_of(field, option), option ] }, account.config[field.name] || field.default), id: id, required: field.required, "aria-describedby": ("#{id}-ajuda" if help.present?) %>
    <% elsif field.type == "secret" %>
      <%= label_tag id, label %>
      <%= password_field_tag "payment_account[secrets][#{field.name}]", nil, id: id, required: field.required && !account.secret_set?(field.name), autocomplete: "off", "aria-describedby": "#{id}-ajuda" %>
      <small id="<%= id %>-ajuda"><%= account.secret_set?(field.name) ? "Definido (não é mostrado). Deixe em branco para manter; preencha para trocar." : "Será cifrado e não voltará para a tela." %> <%= help %></small>
    <% elsif field.type == "file" %>
      <%= label_tag id, label %>
      <%= file_field_tag "payment_account[files][#{field.name}]", id: id, required: field.required && !account.file_info(field.name), "aria-describedby": "#{id}-ajuda" %>
      <small id="<%= id %>-ajuda"><%= help %> Aceita só o arquivo com a chave privada e dentro da validade.</small>
      <% info = account.file_info(field.name) %>
      <% if info %>
        <dl class="valores">
          <div><dt>Titular</dt><dd><%= info["subject"] %></dd></div>
          <div><dt>Vence em</dt><dd><%= date_br(Date.iso8601(info["not_after"])) %></dd></div>
          <div><dt>Impressão digital (SHA-256)</dt><dd><code><%= info["sha256"] %></code></dd></div>
        </dl>
      <% end %>
    <% end %>
    <% if field.type.in?(%w[text number select]) && help.present? %><small id="<%= id %>-ajuda"><%= help %></small><% end %>
  </div>
<% end %>
  </fieldset>
<% end %>
