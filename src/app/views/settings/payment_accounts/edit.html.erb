<% content_for :title, "Configuração · Integração #{@account.nickname_was || @account.nickname}" %>
<%= pagina "Integração #{@account.nickname_was || @account.nickname}", subtitulo: safe_join([ @account.tenant.name, " · ", t("payments.accounts.modalities.#{@account.modality}"), " em ", provider_name(@account.provider), " · ", t("payments.accounts.environments.#{@account.environment}") ]),
           indicadores: [ (@account.active? ? situacao("Ativa", tom: :success) : situacao("Desativada", tom: :neutral)) ] do %>
  <% if @account.provider_available? %><%= button_to "Testar conexão", settings_payment_account_connection_test_path(@account), method: :post, data: { variant: "secondary" } %><% end %>
  <% if @account.active? && @account.replacement.nil? && (Payments::Providers.for_modality(@account.modality) - [ @account.provider ]).any? %>
    <%= link_to "Trocar fornecedor", new_settings_payment_account_path(substitui: @account.id), class: "botao", data: { variant: "secondary" } %>
  <% end %>
  <% if @account.waiting_replacement? %>
    <%= confirmar_no_painel "Desistir da troca", titulo: "Desistir da troca?", mensagem: "A integração #{@account.nickname} é excluída, e a integração #{@account.replaces.nickname} continua emitindo.", acao: "Desistir da troca", url: settings_payment_account_path(@account), metodo: :delete %>
  <% elsif @account.active? %>
    <%= confirmar_no_painel "Desativar", titulo: "Desativar a integração?", mensagem: "A integração deixa de ser usada para emitir. O que já foi emitido não muda.", acao: "Desativar integração", url: settings_payment_account_activation_path(@account), metodo: :delete %>
  <% else %>
    <%= button_to "Ativar integração", settings_payment_account_activation_path(@account), method: :post %>
  <% end %>
  <% if @account.provider_available? && @account.manifest.field("webhook_secret") %>
    <%= confirmar_no_painel "Gerar novo segredo do webhook", titulo: "Gerar um novo segredo?", mensagem: "O segredo atual, se houver, continua valendo por 24 horas; depois só o novo vale.", acao: "Gerar novo segredo", url: settings_payment_account_webhook_secret_path(@account), perigoso: false, variante: "secondary" %>
  <% end %>
  <% unless @account.used? || @account.waiting_replacement? %>
    <%= confirmar_no_painel "Excluir", titulo: "Excluir a integração?", mensagem: "A integração #{@account.nickname} deixa de existir, com os segredos e o certificado. Isto fica registrado.", acao: "Excluir integração", url: settings_payment_account_path(@account), metodo: :delete %>
  <% end %>
<% end %>
<%= render "settings/modelo" %>

<%# O formulário estreito à esquerda; a conexão e o histórico à direita (modelo Entrada). Na recusa (422), a SPA troca a tela pela refeita, com a mensagem. %>
<div class="ficha" data-lateral="esquerda" data-refazer-no-erro>
<section class="cartao" aria-labelledby="dados">
  <header><h2 id="dados">Dados da integração</h2></header>
  <div>
    <%= form_with model: @account, scope: :payment_account, url: settings_payment_account_path(@account), method: :patch, multipart: true, class: "campos-do-cartao" do |form| %>
      <% if @account.errors.any? %><%= aviso(tom: :danger) { tag.p @account.errors.full_messages.to_sentence } %><% end %>
      <% if @account.waiting_replacement? %><%= aviso(tom: :warning) { tag.p t("payments.methods.replace.pending", nickname: @account.replaces.nickname, provider: @account.manifest.label, modality: modality_in_sentence(@account.modality)) } %><% end %>
      <% unless @account.provider_available? %><%= aviso(tom: :warning) { tag.p "O fornecedor desta integração não está mais instalado: ela não emite e pode ser desativada ou apagada." } %><% end %>
      <div class="campo">
        <%= label_tag "campo-nickname", "Apelido" %>
        <%= text_field_tag "payment_account[nickname]", @account.nickname, id: "campo-nickname", required: true, maxlength: 100 %>
      </div>
      <% if @account.provider_available? %><%= render "settings/payment_accounts/fields", form: form, account: @account %><% end %>
      <div class="acoes" data-rodape><button type="submit">Salvar a integração</button></div>
    <% end %>
  </div>
</section>

<div class="pilha-de-cartoes">
<section class="cartao" aria-labelledby="situacao-conta">
  <header><h2 id="situacao-conta">Conexão</h2></header>
  <div>
    <dl class="dados">
      <% if Payments::Connection.authorization?(@account) %><dt><%= t("payments.fields.connection.label") %></dt><dd><%= connection_state(@account) %></dd><% end %>
      <dt>Último teste</dt><dd><%= @account.last_test_status ? "#{@account.last_test_status == 'ok' ? 'Boa' : 'Falhou'}, #{datetime_br(@account.last_tested_at)}. #{@account.last_test_message}" : "Nunca testada" %></dd>
      <% if @account.provider_available? && @account.manifest.field("webhook_secret") %><dt>Segredo do webhook</dt><dd><%= @account.secret_set?("webhook_secret") ? "Definido (não é mostrado de novo)" : "Ainda não gerado" %></dd><% end %>
      <% if @account.persisted? && @account.provider_available? && Payments::WebhookUrl.per_charge?(@account) %><dt>Webhook</dt><dd><%= t("payments.webhook_registration.per_charge_line") %></dd>
      <% elsif @account.persisted? && @account.provider_available? && @account.modality.in?(%w[boleto pix]) %><dt>Webhook</dt><dd><%= @account.webhook_registered_at ? t("payments.webhook_registration.registered", date: date_br(@account.webhook_registered_at.to_date)) : t("payments.webhook_registration.not_registered") %></dd><% end %>
    </dl>
    <% if Payments::Connection.authorization?(@account) %>
      <%# Conexão por autorização (12, revisão 5, R284k): o gestor autoriza na página do fornecedor e volta; o link sai da casca (janela inteira). %>
      <% provider = @account.manifest.label %>
      <% if flash[:connection_notice] %><%= aviso(tom: :success) { tag.p flash[:connection_notice] } %><% end %>
      <% if flash[:connection_alert] %><%= aviso(tom: :danger) { tag.p flash[:connection_alert] } %><% end %>
      <% if Payments::Connection.app(@account.provider, @account.environment).nil? %>
        <%= aviso(tom: :warning) { tag.p t("payments.connection.no_app", provider: provider) } %>
      <% else %>
        <p><%= t("payments.connection.connect_help", provider: provider) %></p>
        <div class="acoes">
          <%= link_to t(Payments::Connection.connected?(@account) ? "payments.connection.reconnect" : "payments.connection.connect", provider: provider), new_settings_payment_account_connection_path(@account), target: "_top", class: "botao", data: { variant: (Payments::Connection.connected?(@account) ? "secondary" : nil) } %>
          <% if Payments::Connection.connected?(@account) %>
            <%= confirmar_no_painel t("payments.connection.disconnect"), titulo: t("payments.connection.disconnect_title", provider: provider), mensagem: t("payments.connection.disconnect_message"), acao: t("payments.connection.disconnect"), url: settings_payment_account_connection_path(@account), metodo: :delete, variante: "secondary" %>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <% if @secret %>
      <%= aviso(tom: :warning) do %>
        <p><strong>Copie o segredo agora:</strong> ele só aparece desta vez. <code><%= @secret %></code></p>
      <% end %>
    <% end %>
  </div>
</section>

<section class="cartao" aria-labelledby="historico">
  <header><h2 id="historico">Histórico</h2></header>
  <div>
    <% if @history.empty? %>
      <p class="vazio">Nenhum ato registrado.</p>
    <% else %>
      <div class="tabela" tabindex="0">
        <table>
          <caption class="apenas-leitor-de-tela">Histórico da integração</caption>
          <thead><tr><th scope="col">Quando</th><th scope="col">Quem</th><th scope="col">Ato</th><th scope="col">Campo</th><th scope="col">Antes</th><th scope="col">Depois</th></tr></thead>
          <tbody>
            <% @history.each do |change| %>
              <tr>
                <td><%= datetime_br(change.occurred_at) %></td>
                <td><%= change.user&.name || "—" %></td>
                <td><%= t("payments.accounts.history.#{change.event}", default: change.event) %></td>
                <td><%= account_field_label(@account, change.field) %></td>
                <td><%= change.before.presence || "—" %></td>
                <td><%= change.after.presence || change.note.presence || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
</div>
</div>
