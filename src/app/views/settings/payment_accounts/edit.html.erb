<% content_for :title, "Configuração · Conta #{@account.nickname_was || @account.nickname}" %>
<%= pagina "Conta #{@account.nickname_was || @account.nickname}", subtitulo: safe_join([ @account.tenant.name, " · ", t("payments.accounts.modalities.#{@account.modality}"), " em ", provider_name(@account.provider), " · ", t("payments.accounts.environments.#{@account.environment}"), " · ", link_to("Voltar para as contas", settings_payment_accounts_path) ]),
           indicadores: [ (@account.active? ? situacao("Ativa", tom: :success) : situacao("Desativada", tom: :neutral)) ] do %>
  <% if @account.provider_available? %><%= button_to "Testar conexão", settings_payment_account_connection_test_path(@account), method: :post, data: { variant: "secondary" } %><% end %>
  <% if @account.active? %>
    <%= confirmar_no_painel "Desativar", titulo: "Desativar a conta?", mensagem: "A conta deixa de ser usada para emitir. O que já foi emitido não muda.", acao: "Desativar conta", url: settings_payment_account_activation_path(@account), metodo: :delete %>
  <% else %>
    <%= button_to "Ativar conta", settings_payment_account_activation_path(@account), method: :post %>
  <% end %>
  <% if @account.provider_available? && @account.manifest.field("webhook_secret") %>
    <%= confirmar_no_painel (@account.secret_set?("webhook_secret") ? "Trocar o segredo do webhook" : "Gerar o segredo do webhook"), titulo: "Gerar um novo segredo?", mensagem: "O segredo atual, se houver, continua valendo por 24 horas; depois só o novo vale.", acao: "Gerar segredo", url: settings_payment_account_webhook_secret_path(@account), perigoso: false, variante: "secondary" %>
  <% end %>
  <% unless @account.used? %>
    <%= confirmar_no_painel "Apagar", titulo: "Apagar a conta?", mensagem: "A conta #{@account.nickname} deixa de existir, com os segredos e o certificado. Isto fica registrado.", acao: "Apagar conta", url: settings_payment_account_path(@account), metodo: :delete %>
  <% end %>
<% end %>
<%= render "settings/abas" %>

<div class="ficha">
<section class="cartao" aria-labelledby="dados">
  <header><h2 id="dados">Dados da conta</h2></header>
  <div>
    <% if @account.errors.any? %><%= aviso(tom: :danger) { tag.p @account.errors.full_messages.to_sentence } %><% end %>
    <% unless @account.provider_available? %><%= aviso(tom: :warning) { tag.p "O fornecedor desta conta não está mais instalado: ela não emite e pode ser desativada ou apagada." } %><% end %>
    <%= form_with model: @account, scope: :payment_account, url: settings_payment_account_path(@account), method: :patch, multipart: true, html: { "hx-boost": "false" } do |form| %>
      <div class="campo">
        <%= label_tag "campo-nickname", "Apelido" %>
        <%= text_field_tag "payment_account[nickname]", @account.nickname, id: "campo-nickname", required: true, maxlength: 100 %>
      </div>
      <div class="campo">
        <%= label_tag "campo-channel", "Canal de recebimento" %>
        <%= select_tag "payment_account[channel_id]", options_for_select(PaymentChannel.where(tenant_id: @account.tenant_id).order(:code).map { |channel| [ "#{channel.code} · #{channel.description}", channel.id ] }, @account.channel_id), id: "campo-channel", required: true %>
      </div>
      <% if @account.provider_available? %><%= render "settings/payment_accounts/fields", form: form, account: @account %><% end %>
      <div class="acoes" data-rodape>
        <%= link_to "Cancelar", settings_payment_accounts_path, class: "botao", data: { variant: "secondary" } %>
        <button type="submit">Salvar</button>
      </div>
    <% end %>
  </div>
</section>

<aside class="ficha-lateral">
<section class="cartao" aria-labelledby="situacao-conta">
  <header><h2 id="situacao-conta">Conexão</h2></header>
  <div>
    <dl class="dados">
      <dt>Último teste</dt><dd><%= @account.last_test_status ? "#{@account.last_test_status == 'ok' ? 'Boa' : 'Falhou'}, #{datetime_br(@account.last_tested_at)}. #{@account.last_test_message}" : "Nunca testada" %></dd>
      <% if @account.provider_available? && @account.manifest.field("webhook_secret") %><dt>Segredo do webhook</dt><dd><%= @account.secret_set?("webhook_secret") ? "Definido (não é mostrado de novo)" : "Ainda não gerado" %></dd><% end %>
    </dl>
    <% if @secret %>
      <%= aviso(tom: :warning) do %>
        <p><strong>Copie o segredo agora:</strong> ele só aparece desta vez. <code><%= @secret %></code></p>
      <% end %>
    <% end %>
  </div>
</section>
</aside>
</div>

<section class="cartao" aria-labelledby="historico">
  <header><h2 id="historico">Histórico</h2></header>
  <div>
    <% if @history.empty? %>
      <p class="vazio">Nenhum ato registrado.</p>
    <% else %>
      <div class="tabela" tabindex="0">
        <table>
          <caption class="apenas-leitor-de-tela">Histórico da conta</caption>
          <thead><tr><th scope="col">Quando</th><th scope="col">Quem</th><th scope="col">Ato</th><th scope="col">Campo</th><th scope="col">Antes</th><th scope="col">Depois</th></tr></thead>
          <tbody>
            <% @history.each do |change| %>
              <tr>
                <td><%= datetime_br(change.occurred_at) %></td>
                <td><%= change.user&.name || "—" %></td>
                <td><%= t("payments.accounts.history.#{change.event}", default: change.event) %></td>
                <td><%= account_field_label(@account, change.field) %></td>
                <td><%= change.before.presence || "—" %></td>
                <td><%= change.after.presence || change.note.presence || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
