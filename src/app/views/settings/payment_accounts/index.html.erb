<% content_for :title, "Configuração · Contas de pagamento" %>
<%= pagina "Contas de pagamento", subtitulo: "Fornecedor de boleto, Pix e cartão de cada credor, uma conta por modalidade e ambiente." do %>
  <%= link_to "Nova conta", new_settings_payment_account_path, class: "botao" %>
<% end %>
<%= render "settings/abas" %>

<div id="resultado">
  <% if @accounts.empty? %>
    <p class="vazio">Nenhuma conta de pagamento cadastrada.</p>
  <% else %>
    <div class="tabela" tabindex="0" data-fixa>
      <table>
        <caption class="apenas-leitor-de-tela">Contas de pagamento</caption>
        <thead>
          <tr>
            <th scope="col">Apelido</th>
            <% if @several_tenants %><th scope="col">Credor</th><% end %>
            <th scope="col">Modalidade</th>
            <th scope="col">Fornecedor</th>
            <th scope="col">Ambiente</th>
            <th scope="col">Canal</th>
            <th scope="col">Certificado</th>
            <th scope="col">Último teste</th>
            <th scope="col">Situação</th>
            <th scope="col"><span class="apenas-leitor-de-tela">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <% @accounts.each do |account| %>
            <tr>
              <th scope="row"><%= link_to account.nickname, edit_settings_payment_account_path(account) %></th>
              <% if @several_tenants %><td><%= account.tenant.name %></td><% end %>
              <td><%= t("payments.accounts.modalities.#{account.modality}") %></td>
              <td><%= provider_name(account.provider) %></td>
              <td><%= t("payments.accounts.environments.#{account.environment}") %></td>
              <td><%= account.channel.code %></td>
              <td><%= account.certificate_expires_on ? "vence em #{date_br(account.certificate_expires_on)}" : "—" %></td>
              <td><%= account.last_test_status ? "#{account.last_test_status == 'ok' ? 'Boa' : 'Falhou'}, #{datetime_br(account.last_tested_at)}" : "Nunca testada" %></td>
              <td><%= account.active? ? situacao("Ativa", tom: :success) : situacao("Desativada", tom: :neutral) %></td>
              <td data-acoes>
                <%= menu_de_linha("conta-#{account.id}", "Ações da conta #{account.nickname}") do %>
                  <%= link_to "Abrir conta", edit_settings_payment_account_path(account), class: "botao" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/paginacao", pagination: @pagination, unit: "contas", path: ->(page) { settings_payment_accounts_path(request.query_parameters.merge("page" => page)) } %>
  <% end %>
</div>
