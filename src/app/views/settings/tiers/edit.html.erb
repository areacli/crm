<% content_for :title, "Configuração · Regras do item #{@tier.name}" %>
<%= pagina "Regras do item #{@tier.name}", subtitulo: "#{@tenant.name} · Mudar a regra passa pela conferência do impacto antes de valer." %>
<%= render "settings/modelo" %>
<%# Modelo Configuração: os encargos e a promessa em cartões, um valor por linha; um Salvar só, que leva à conferência do impacto na mesma aba. Na recusa (422), a
    SPA troca a tela pela refeita, com o que foi digitado e as mensagens junto dos campos (`data-refazer-no-erro`). %>
<div class="pagina-em-secoes" data-refazer-no-erro>
  <%= form_with model: @tier, scope: :tier, url: settings_tier_path(@tier), method: :patch, class: "pilha-de-cartoes" do |form| %>
    <% if @tier.errors.any? %><%= aviso(tom: :danger) { tag.p @tier.errors.full_messages.to_sentence } %><% end %>
    <section class="cartao" aria-labelledby="regras-encargos">
      <header>
        <div>
          <h2 id="regras-encargos">Encargos</h2>
          <p>Campo vazio usa o parâmetro do credor (multa <%= charge_pct(@tenant.setting.charge_fine_pct) %>, juros <%= charge_pct(@tenant.setting.charge_interest_pct) %> ao mês, <%= charge_label(:index, @tenant.setting.charge_index) %>).</p>
        </div>
      </header>
      <div><%= render "settings/tiers/charges", form: form, tier: @tier, raw: @raw, setting: @tenant.setting %></div>
    </section>
    <section class="cartao" aria-labelledby="regras-promessa">
      <header>
        <div>
          <h2 id="regras-promessa">Promessa</h2>
          <p>As alçadas por perfil e as variáveis e limites de acordo ficam em Promessas e acordos.</p>
        </div>
      </header>
      <div>
        <%= politica "Prazo máximo da promessa", "prazo", ajuda: "Nenhuma promessa passa deste prazo, nem com aprovação." do %>
          <div class="em-linha"><%= form.number_field :promise_max_days, value: (@raw&.key?(:promise_max_days) ? @raw[:promise_max_days] : @tier.promise_max_days), min: 1, max: 365, required: true, class: "numero", "aria-label": "Prazo máximo da promessa, em dias" %> dias</div>
        <% end %>
      </div>
    </section>
    <div class="acoes" data-rodape><button type="submit">Conferir o impacto</button></div>
  <% end %>
</div>
