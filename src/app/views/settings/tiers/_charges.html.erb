<%# Regra de encargos do item do enquadramento (09, R160, R177), uma linha de política por valor. Locais: form, tier, raw, setting (os parâmetros do credor que o
    campo vazio herda). %>
<% erro = ->(campo) { safe_join(tier.errors[campo].map { |message| tag.small(message, id: "erro-#{campo}", class: "erro", role: "alert") }) } %>
<%= politica "Multa", "multa", ajuda: "Percentual sobre o principal, devido uma vez, no dia seguinte ao vencimento. Acima de 2% o aviso do CDC aparece na conferência." do %>
  <div class="em-linha"><%= form.text_field :fine_pct, value: charge_field_value(tier, raw, :fine_pct), inputmode: "decimal", autocomplete: "off", class: "numero", placeholder: charge_pct(setting.charge_fine_pct).delete("%"), "aria-label": "Multa, em porcentagem", "aria-describedby": ("erro-fine_pct" if tier.errors[:fine_pct].any?) %> %</div>
  <%= erro.call(:fine_pct) %>
<% end %>
<%= politica "Juros de mora", "juros", ajuda: "Taxa fixa ao mês, ou taxa legal (Código Civil, art. 406: Selic menos o índice de correção, sempre em juros simples; com ela, a taxa fixa e a forma dos juros não se aplicam)." do %>
  <div class="curto"><%= form.select :interest_kind, Tier::INTEREST_KINDS.map { |kind| [ charge_label(:interest_kind, kind), kind ] }, { selected: charge_choice(tier, raw, :interest_kind) }, "aria-label": "Juros de mora" %></div>
<% end %>
<%= politica "Taxa fixa", "taxa" do %>
  <div class="em-linha"><%= form.text_field :interest_pct, value: charge_field_value(tier, raw, :interest_pct), inputmode: "decimal", autocomplete: "off", class: "numero", placeholder: charge_pct(setting.charge_interest_pct).delete("%"), "aria-label": "Taxa fixa, em porcentagem ao mês", "aria-describedby": ("erro-interest_pct" if tier.errors[:interest_pct].any?) %> % ao mês</div>
  <%= erro.call(:interest_pct) %>
<% end %>
<%= politica "Forma dos juros fixos", "forma" do %>
  <div class="curto"><%= form.select :interest_form, Tier::INTEREST_FORMS.map { |value| [ charge_label(:interest_form, value), value ] }, { selected: charge_choice(tier, raw, :interest_form) }, "aria-label": "Forma dos juros fixos" %></div>
<% end %>
<%= politica "Correção monetária", "indice" do %>
  <div class="curto"><%= form.select :index_code, [ [ "Usar a do credor (#{charge_label(:index, setting.charge_index)})", "" ] ] + Tier::INDEX_CODES.map { |value| [ charge_label(:index, value), value ] }, { selected: charge_choice(tier, raw, :index_code) }, "aria-label": "Correção monetária" %></div>
<% end %>
<%= politica "Honorários de cobrança", "honorarios", ajuda: "Percentual sobre principal corrigido, multa e juros. Só vale com a marca \"o contrato prevê honorários\"." do %>
  <div class="em-linha"><%= form.text_field :fees_pct, value: charge_field_value(tier, raw, :fees_pct), inputmode: "decimal", autocomplete: "off", class: "numero", "aria-label": "Honorários de cobrança, em porcentagem", "aria-describedby": ("erro-fees_pct" if tier.errors[:fees_pct].any?) %> %</div>
  <%= erro.call(:fees_pct) %>
  <label>
    <%= check_box_tag "tier[fees_in_contract]", "1", (raw&.key?(:fees_in_contract) ? raw[:fees_in_contract].to_s == "1" : tier.fees_in_contract?), id: "tier_fees_in_contract" %>
    O contrato prevê honorários
  </label>
<% end %>
<%= politica "Convenção de dias dos juros", "convencao" do %>
  <div class="curto"><%= form.select :days_convention, [ [ "Usar a do credor (#{charge_label(:days_convention, setting.charge_days_convention)})", "" ] ] + Tier::DAYS_CONVENTIONS.map { |value| [ charge_label(:days_convention, value), value ] }, { selected: charge_choice(tier, raw, :days_convention) }, "aria-label": "Convenção de dias dos juros" %></div>
<% end %>
<%= politica "Base da multa", "base" do %>
  <div class="curto"><%= form.select :fine_base, [ [ "Usar a do credor (#{charge_label(:fine_base, setting.charge_fine_base)})", "" ] ] + Tier::FINE_BASES.map { |value| [ charge_label(:fine_base, value), value ] }, { selected: charge_choice(tier, raw, :fine_base) }, "aria-label": "Base da multa" %></div>
<% end %>
