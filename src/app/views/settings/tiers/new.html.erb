<%# Incluir segmento no enquadramento financeiro (13, R293): modal pequeno com o segmento, a posição e o item de onde copiar as regras (SG15).
    Continuar leva à conferência do impacto. %>
<%= formulario_de_painel titulo: "Incluir segmento", url: settings_tiers_path, enviar: "Conferir o impacto", escopo: :tier, variante: :modal,
      descricao: "Os contratos que o segmento pegar passam a ter as regras dele.", erro: @error, voltar: settings_tiers_path do |form| %>
  <%= hidden_field_tag :credor, @tenant.id, id: nil %>
  <% if @candidates.empty? %>
    <p class="vazio">Nenhum segmento de contratos disponível. <%= link_to "Crie um segmento", new_settings_segment_path(credor: @tenant.id, sujeito: "contracts") %> primeiro.</p>
  <% else %>
    <div class="campo">
      <%= form.label :segment_id, "Segmento" %>
      <%= form.select :segment_id, @candidates.map { |segment| [ "#{segment.name} — #{segment.text.lines.drop(1).map(&:short).join(' · ')}", segment.id ] }, { include_blank: "Escolha" }, required: true %>
      <% if @customer_segments.positive? %><small>Segmentos de clientes não aparecem: o enquadramento financeiro trabalha com contratos.</small><% end %>
    </div>
    <div class="campo">
      <%= form.label :before_id, "Posição" %>
      <%= form.select :before_id, @items.reject(&:catch_all?).map { |tier| [ "Antes de #{tier.name}", tier.id ] } + [ [ "Antes de Demais (no fim)", "" ] ], { selected: "" } %>
    </div>
    <div class="campo">
      <%= form.label :copy_from_id, "Copiar as regras de" %>
      <%= form.select :copy_from_id, @items.map { |tier| [ tier.name, tier.id ] }, { selected: @items.find(&:catch_all?)&.id } %>
      <small>Encargos, prazo da promessa, variáveis de acordo e os limites por perfil vêm iguais aos deste item. Depois você ajusta em "Editar regras".</small>
    </div>
  <% end %>
<% end %>
