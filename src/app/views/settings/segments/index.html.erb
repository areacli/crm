<% content_for :title, "Configuração · Segmentos" %>
<% content_for :cable_channels, @tenants.map { |tenant| { channel: "SegmentsChannel", tenant_id: tenant.id } }.to_json %>
<%= pagina "Segmentos", subtitulo: "Públicos descritos por condições. Um segmento sozinho não muda nada: ele vale quando um enquadramento o usa." do %>
  <%= link_to "Glossário", settings_segment_glossary_path, class: "botao", data: { variant: "secondary" } %>
<% end %>
<%= render "settings/modelo" %>

<%= form_with url: settings_segments_path, method: :get, class: "filtros", html: { role: "search", "aria-label": "Filtrar segmentos" } do %>
  <div class="campo"><%= label_tag :busca, "Nome" %><%= search_field_tag :busca, @filters[:busca] %></div>
  <div class="campo"><%= label_tag :seleciona, "Seleciona" %><%= select_tag :seleciona, options_for_select([ [ "Todos", "" ], [ "Contratos", "contracts" ], [ "Clientes", "customers" ] ], @filters[:seleciona]) %></div>
  <div class="campo"><%= label_tag :uso, "Uso" %><%= select_tag :uso, options_for_select([ [ "Todos", "" ], [ "Em uso", "em_uso" ], [ "Sem uso", "sem_uso" ] ], @filters[:uso]) %></div>
  <div class="campo"><%= label_tag :situacao, "Situação" %><%= select_tag :situacao, options_for_select([ [ "Todas", "" ], [ "Ativos", "ativos" ], [ "Desativados", "inativos" ] ], @filters[:situacao]) %></div>
  <button type="submit" data-variant="secondary">Filtrar</button>
<% end %>

<div id="segmentos" hx-get="<%= settings_segments_path(@filters) %>" hx-trigger="cable:segments-changed from:body" hx-swap="outerHTML" hx-push-url="false" hx-select="#segmentos" hx-disinherit="hx-select hx-swap hx-push-url">
  <% @tenants.each do |tenant| %>
    <% segments = @segments.fetch(tenant.id, []) %>
    <% can_change = @can_change.include?(tenant.id) %>
    <section class="cartao" aria-labelledby="credor-<%= tenant.id %>">
      <header>
        <h2 id="credor-<%= tenant.id %>"><%= tenant.name %></h2>
        <% if can_change %><div class="acoes"><%= link_to "Criar segmento", new_settings_segment_path(tenant_id: tenant.id), class: "botao", data: { size: "small" } %></div><% end %>
      </header>
      <div>
        <% if segments.empty? %>
          <p class="vazio">Nenhum segmento criado. Um segmento descreve um público, como "contratos com atraso acima de 90 dias".<%= " Crie o primeiro." if can_change %></p>
        <% else %>
          <div class="tabela" tabindex="0">
            <table>
              <caption class="apenas-leitor-de-tela">Segmentos de <%= tenant.name %></caption>
              <thead><tr><th scope="col">Nome</th><th scope="col">Seleciona</th><th scope="col">Condições</th><th scope="col">Onde é usado</th><th scope="col">Situação</th><th scope="col">Alterado em</th><th scope="col"><span class="apenas-leitor-de-tela">Ações</span></th></tr></thead>
              <tbody>
                <% segments.each do |segment| %>
                  <% text = segment.text(result_names: @result_names) %>
                  <% uses = segment.tiers.select(&:active) %>
                  <tr id="segmento-<%= segment.id %>">
                    <th scope="row"><%= link_to segment.name, settings_segment_path(segment) %></th>
                    <td><%= t("segments.subjects.#{segment.subject}") %></td>
                    <td><code><%= text.lines.drop(1).map(&:short).join(" · ") %></code> <%= informacao "condições de #{segment.name}", text.long_text, "leitura-#{segment.id}" %></td>
                    <td><%= uses.any? ? "Enquadramento financeiro, item #{uses.map(&:position).join(', ')}" : "Sem uso" %></td>
                    <td><%= segment.active? ? situacao("Ativo", tom: :success) : situacao("Desativado", tom: :neutral) %></td>
                    <td><%= datetime_br(segment.updated_at) %></td>
                    <td data-acoes>
                      <%= menu_de_linha("segmento-menu-#{segment.id}", "Ações de #{segment.name}") do %>
                        <%= link_to "Abrir", settings_segment_path(segment), class: "botao" %>
                        <% if can_change %>
                          <%= link_to "Editar", edit_settings_segment_path(segment), class: "botao" %>
                          <%= link_to "Duplicar", new_settings_segment_path(tenant_id: tenant.id, from: segment.id), class: "botao" %>
                          <% if segment.active? %>
                            <%= button_to "Desativar", settings_segment_activation_path(segment), method: :delete, form: { "hx-boost": "false" } %>
                          <% else %>
                            <%= button_to "Reativar", settings_segment_activation_path(segment), form: { "hx-boost": "false" } %>
                          <% end %>
                          <% if uses.empty? %>
                            <%= confirmar_no_painel "Apagar", titulo: "Apagar o segmento?", mensagem: "O segmento \"#{segment.name}\" será apagado. Ele não está em uso, então nada muda na carteira.", acao: "Apagar", url: settings_segment_path(segment), metodo: :delete %>
                          <% end %>
                        <% end %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
