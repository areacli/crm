<%# Coluna "Como fica" (13, R278, R302): a leitura de cada linha (cálculo à vista), "Conferir" e onde o segmento é usado. Locais: segment, source, parsed, probe. %>
<% text = parsed&.ok? ? Segments::Text.new(Segments::Expression.new(parsed.tree)) : nil %>
<% subject = parsed&.subject || segment.subject || "contracts" %>
<aside class="como-fica pilha-de-cartoes" aria-label="Como fica">
  <section class="cartao" aria-labelledby="titulo-como-fica">
    <header><h2 id="titulo-como-fica">Como fica</h2></header>
    <div class="campos-do-cartao">
      <%= resultado_do_calculo { render "settings/segments/leitura", segment: segment, source: source, parsed: parsed } %>
      <div>
        <button type="button" data-variant="secondary" data-spa-conferir="<%= probe_settings_segments_path(id: segment.id, credor: segment.tenant_id) %>">Conferir</button>
      </div>
      <%= render "settings/segments/probe", probe: probe, subject: subject, expression: (text ? Segments::Expression.new(parsed.tree) : nil) %>
    </div>
  </section>
  <% if segment.persisted? %>
    <section class="cartao" aria-labelledby="onde-e-usado">
      <header><h2 id="onde-e-usado">Onde é usado</h2></header>
      <div>
        <% uses = segment.uses.to_a %>
        <% if uses.any? %>
          <ul><% uses.each do |tier| %><li>Enquadramento financeiro, item <%= tier.position %></li><% end %></ul>
          <p><small>Salvar leva à conferência do impacto antes de valer.</small></p>
        <% else %>
          <p><small>Sem uso: mudar não muda nada na carteira.</small></p>
        <% end %>
      </div>
    </section>
  <% end %>
</aside>
