<% content_for :title, "Configuração · Novo segmento" %>
<% content_for :cable_channels, [ { channel: "SegmentsChannel", tenant_id: @segment.tenant_id } ].to_json %>
<%= pagina "Novo segmento", subtitulo: "#{@segment.tenant.name} · Um segmento só descreve um público; ele não muda nada até ser usado num enquadramento." %>
<%= render "settings/modelo" %>
<% if params[:exemplo].blank? && params[:de].blank? && @parsed.nil? %>
  <%# Os exemplos só preenchem o editor (a aba vai para o endereço com o exemplo); nada é salvo até salvar. %>
  <p class="exemplos-de-segmento" role="group" aria-label="Começar de um exemplo">
    <span>Começar de um exemplo:</span>
    <% Segments::Examples::LIST.each do |example| %>
      <%= link_to example.name, new_settings_segment_path(credor: @segment.tenant_id, exemplo: example.key), data: { mesma_aba: true } %>
    <% end %>
  </p>
<% end %>
<%= render "settings/segments/editor", segment: @segment, source: @source, parsed: @parsed, probe: @probe %>
