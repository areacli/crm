<% content_for :title, "Configuração · Operação #{@operation.short_name}" %>
<%= pagina @operation.short_name, subtitulo: safe_join([ @operation.legal_name, " · CNPJ #{Document.format(@operation.cnpj)} · #{@accreditation.tenant.name} · ", link_to("Voltar para as operações", settings_operations_path) ]),
           indicadores: [ situacao(t("operations.statuses.#{@accreditation.status}"), tom: { "active" => :success, "suspended" => :warning, "ended" => :neutral }[@accreditation.status]) ] do %>
  <% (Accreditation.statuses.keys - [ @accreditation.status ]).each do |status| %>
    <%= abrir_painel t("operations.status_actions.#{status}"), new_settings_operation_status_path(@accreditation, status: status), variante: (status == "active" ? nil : "secondary"), tamanho: "small" %>
  <% end %>
<% end %>
<%= render "settings/modelo" %>
<% if flash[:temporary_password] %><%= render "memberships/temporary_password", data: flash[:temporary_password] %><% end %>
<% if @accreditation.status_reason.present? %>
  <%= aviso(tom: @accreditation.active? ? :info : :warning) { tag.p "Último motivo: #{@accreditation.status_reason}" } %>
<% end %>

<section class="cartao" aria-labelledby="pessoas">
  <header><h2 id="pessoas">Pessoas da operação e vínculos neste credor</h2></header>
  <div>
    <p>O gestor da operação cadastra as pessoas; o vínculo neste credor, com o perfil, é dado aqui, com os perfis marcados como disponíveis para operações.</p>
    <% if @members.empty? %>
      <p class="vazio">A operação ainda não tem pessoas.</p>
    <% else %>
      <div class="tabela" tabindex="0">
        <table>
          <caption class="apenas-leitor-de-tela">Pessoas da operação</caption>
          <thead><tr><th scope="col">Pessoa</th><th scope="col">E-mail</th><th scope="col">Na operação</th><th scope="col">Vínculo neste credor</th><th scope="col"><span class="apenas-leitor-de-tela">Ações</span></th></tr></thead>
          <tbody>
            <% @members.each do |member| %>
              <% membership = @memberships[member.user_id] %>
              <tr>
                <th scope="row"><%= member.user.name %></th>
                <td><%= member.user.email_address %></td>
                <td><%= member.active? ? (member.manager? ? "Gestor" : "Ativa") : "Desativada" %></td>
                <td><%= membership&.active? ? membership.profile.name : "Sem vínculo" %></td>
                <td data-acoes>
                  <% if member.active? && policy(@accreditation).link? %>
                    <%= menu_de_linha("pessoa-#{member.id}", "Ações de #{member.user.name}") do %>
                      <%= abrir_painel (membership&.active? ? "Mudar o perfil" : "Dar vínculo"), new_settings_operation_link_path(@accreditation, member_id: member.id), variante: "modal", tamanho: "small" %>
                      <% if membership&.active? %>
                        <%= confirmar_no_painel "Tirar o vínculo", titulo: "Tirar o vínculo de #{member.user.name}?", mensagem: "Ela deixa de ver #{@accreditation.tenant.name} na hora.", acao: "Tirar o vínculo", url: settings_operation_link_path(@accreditation, membership), metodo: :delete %>
                      <% end %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
