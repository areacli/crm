<%# Campos do item do enquadramento da fila. Locais: form, item (nil ao incluir). %>
<% if @segments.empty? %>
  <p class="vazio">Nenhum segmento de <%= t("queues.subjects.#{@subject}").downcase %> disponível. <%= link_to "Crie um segmento", new_settings_segment_path(credor: @tenant.id, sujeito: @subject) %>.</p>
<% else %>
  <div class="campo"><%= form.label :name, "Nome" %><%= form.text_field :name, value: item&.name, required: true, maxlength: 100 %></div>
  <div class="campo"><%= form.label :segment_id, "Segmento" %><%= form.select :segment_id, @segments.map { [ _1.name, _1.id ] }, { selected: item&.segment_id }, required: true %></div>
  <div class="campo">
    <%= form.label :delivers, "Entrega a operadores" %>
    <%= form.select :delivers, [ [ "Sim, é uma fila", "1" ], [ "Não: sem fila (quem casa não é entregue a ninguém)", "0" ] ], selected: item.nil? || item.delivers ? "1" : "0" %>
  </div>
<% end %>
