<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= [ content_for(:title), "CRM AreaCli" ].compact_blank.join(" · ") %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="<%= image_path("simbolo.svg") %>" type="image/svg+xml">
    <%= stylesheet_link_tag :app %>
  </head>
  <body data-pagina="impressao">
    <main id="conteudo" tabindex="-1">
      <%= yield %>
    </main>
  </body>
</html>
