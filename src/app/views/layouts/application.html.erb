<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= [ content_for(:title), "CRM AreaCli" ].compact_blank.join(" · ") %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <meta name="cable-channels" content="<%= cable_channels %>">
    <link rel="icon" href="<%= image_path("simbolo.svg") %>" type="image/svg+xml">
    <%= stylesheet_link_tag :app %>
    <%# Sem JavaScript, os detalhes das linhas aparecem abertos e as setas somem (padrões de interface, revisão 25). %>
    <noscript><style>tr.detalhe-da-linha[hidden] { display: table-row; } .alternar-detalhe { display: none; }</style></noscript>
    <%= javascript_importmap_tags %>
  </head>

  <%# Design system, revisão 7: o menu escondido pelo botão do cabeçalho fica escondido nas próximas páginas (cookie, lido aqui para a página já nascer assim). %>
  <%# A ficha do cliente lembra a escolha à parte e começa com o menu recolhido (design system, revisão 9); as outras páginas, como antes. %>
  <% menu_cookie = content_for(:menu_memoria) == "ficha" ? "menu_ficha" : "menu" %>
  <% menu_escondido = menu_cookie == "menu_ficha" ? cookies[:menu_ficha] != "aberto" : cookies[:menu] == "recolhido" %>
  <body hx-boost="true" <%= tag.attributes(data: { menu: ("recolhido" if menu_escondido) }) %>>
    <a href="#conteudo" class="pular-para-o-conteudo">Ir para o conteúdo</a>
    <% if Demo.enabled? %>
      <aside class="demonstracao" aria-label="Aviso da demonstração">
        <p>Demonstração: os dados são fictícios e recriados todo dia às <%= Demo.reset_at %>, horário de Brasília. Os arquivos que você enviar são descartados sem ser lidos.</p>
      </aside>
    <% end %>
    <header>
      <div class="identidade">
        <%# Tela estreita: o menu fica fechado e abre por este botão (popover nativo: Esc e clique fora fecham). %>
        <% if authenticated? && menu_sections.present? %>
          <button type="button" class="botao-menu" command="toggle-popover" commandfor="menu-principal" aria-label="Menu"><%= icone "bars-3" %></button>
          <button type="button" class="alternar-menu" data-alternar-menu data-menu-cookie="<%= menu_cookie %>" aria-controls="menu-principal" aria-expanded="<%= !menu_escondido %>" aria-label="<%= menu_escondido ? "Mostrar o menu" : "Esconder o menu" %>"><%= icone "bars-3" %></button>
        <% end %>
        <a href="<%= root_path %>" class="marca">
          <%= image_tag "logotipo-negativo.svg", alt: "AreaCli" %>
          <strong>CRM</strong>
        </a>
      </div>
      <%# Busca global de cliente por nome ou documento: leva à lista de clientes (mesma consulta do filtro da lista). %>
      <% if authenticated? && !Current.user.temporary_password? && Current.user.permitted_anywhere?("view_portfolio") %>
        <form class="busca" role="search" action="<%= customers_path %>" method="get">
          <label class="apenas-leitor-de-tela" for="busca-global">Buscar cliente por nome ou documento</label>
          <input type="search" id="busca-global" name="q" placeholder="Buscar cliente por nome ou documento" autocomplete="off" maxlength="100">
          <button type="submit" aria-label="Buscar"><%= icone "magnifying-glass" %></button>
        </form>
      <% end %>
      <% if authenticated? %>
        <div class="conta">
          <%# 14, R324: o usuário de operação vê de qual operação ele é. %>
          <% if (operation = Current.user.operation) %><span class="operacao-atual" title="<%= operation.legal_name %>"><%= operation.short_name %></span><% end %>
          <%= render "notices/bell" unless Current.user.temporary_password? %>
          <details class="usuario">
            <summary><span class="iniciais" aria-hidden="true"><%= Current.user.name.first.upcase %></span> <span><%= Current.user.name %></span></summary>
            <div>
              <p><small><%= Current.user.email_address %></small></p>
              <%= link_to "Trocar a senha", edit_password_path, class: "botao", data: { variant: "secondary", size: "small" } unless Demo.enabled? %>
              <%= button_to "Sair", session_path, method: :delete, data: { variant: "secondary", size: "small" } %>
            </div>
          </details>
        </div>
      <% end %>
      <%= yield :cabecalho %>
    </header>
    <%= render "layouts/navegacao" if menu_sections.present? %>
    <main id="conteudo" tabindex="-1" <%= tag.attributes(data: { modelo: content_for(:modelo_da_pagina).presence }) %>>
      <%= yield %>
      <div id="avisos-da-pagina">
        <% if notice %><%= aviso(tom: :success) { tag.p notice } %><% end %>
        <% if alert && !current_page?(new_session_path) %><%= aviso(tom: :danger) { tag.p alert } %><% end %>
      </div>
    </main>
    <%= render "layouts/painel" %>
  </body>
</html>
