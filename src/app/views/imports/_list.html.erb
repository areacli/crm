<%# Refeito pelo htmx sempre que o WebSocket avisa que uma importação mudou (cable:import-changed). %>
<div id="importacoes" hx-get="<%= imports_path(request.query_parameters) %>" hx-trigger="cable:import-changed from:body delay:250ms, cable:connected from:body" hx-swap="outerHTML">
  <% if @imports.empty? %>
    <p class="vazio">Nenhuma importação ainda.</p>
  <% else %>
    <div class="tabela" tabindex="0" data-fixa>
      <table>
        <caption class="apenas-leitor-de-tela">Importações</caption>
        <thead>
          <tr><th scope="col">Recebida em</th><th scope="col">Credor</th><th scope="col">Tipo</th><th scope="col">Arquivo</th><th scope="col">Modo</th><th scope="col">Enviada por</th><th scope="col">Situação</th><th scope="col"><span class="apenas-leitor-de-tela">Ações</span></th></tr>
        </thead>
        <tbody>
          <% @imports.each do |import| %>
            <tr>
              <th scope="row"><%= link_to datetime_br(import.created_at), import_path(import) %></th>
              <td><%= import.tenant.name %></td>
              <td><%= t("imports.kinds.#{import.kind}") %></td>
              <td><%= import.original_name %></td>
              <td><%= import.portfolio? ? t("imports.modes.#{import.mode}") : "—" %></td>
              <td><%= import.user&.name || "—" %></td>
              <td><%= render "imports/status", import: import %></td>
              <td data-acoes>
                <%= menu_de_linha("importacao-#{import.id}", "Ações da importação de #{datetime_br(import.created_at)}") do %>
                  <%= link_to "Abrir importação", import_path(import), class: "botao" %>
                  <% if policy(import).confirm? %>
                    <%= confirmar_no_painel "Confirmar importação", titulo: "Confirmar a importação?", mensagem: t("imports.confirm_message.#{import.kind}") + (import.portfolio? && import.full_sync? ? " Os que não vieram no arquivo saem da cobrança." : ""),
                                            acao: "Confirmar importação", url: import_confirmation_path(import), perigoso: false, variante: "secondary" %>
                    <%= confirmar_no_painel "Descartar importação", titulo: "Descartar a importação?", mensagem: t("imports.discard_message.#{import.kind}"), acao: "Descartar importação", url: import_discard_path(import) %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/paginacao", pagination: @pagination, unit: "importações", path: ->(page) { imports_path(request.query_parameters.merge("page" => page)) } %>
  <% end %>
</div>
