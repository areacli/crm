<%
  titles = { "portfolio" => "Importar carteira", "payments" => "Importar pagamentos", "reversals" => "Importar estornos" }
  columns = if @kind == "portfolio"
              Portfolio::SheetModel::COLUMNS.map { |column| [ column, Portfolio::SheetModel.required?(column), Portfolio::SheetModel.format_text(column), Portfolio::SheetModel.example(column) ] }
            else
              Payments::SheetModel.columns(@kind).map { |column| [ column, Payments::SheetModel.required?(@kind, column), Payments::SheetModel.format_text(@kind, column), Payments::SheetModel.example(@kind, column) ] }
            end
%>
<% content_for :title, titles.fetch(@kind) %>
<% content_for :cable_channels, import_cable_channels %>
<%= pagina titles.fetch(@kind), subtitulo: "CSV com ponto e vírgula. O sistema confere o arquivo e só grava depois da confirmação." do %>
  <%= link_to "Baixar planilha modelo", template_imports_path(kind: @kind), class: "botao", data: { variant: "secondary" }, "hx-boost": "false" %>
<% end %>
<% if Demo.enabled? %>
  <%= aviso(tom: :warning) { tag.p "Demonstração: o arquivo que você enviar é descartado sem ser lido e trocado por um arquivo fictício de exemplo." } %>
<% end %>

<div class="ficha" data-lateral="esquerda">
  <section class="cartao" aria-labelledby="envio">
    <header><h2 id="envio">Arquivo</h2></header>
    <%= form_with scope: :import, url: imports_path, multipart: true, html: { "hx-boost": "false" } do |form| %>
      <% if @error %><%= aviso(tom: :danger) { tag.p @error } %><% end %>
      <%= form.hidden_field :kind, value: @kind %>
      <% if @tenants.size > 1 %>
        <div class="campo">
          <%= form.label :tenant_id, "Credor" %>
          <%= form.select :tenant_id, @tenants.map { |tenant| [ tenant.name, tenant.id ] }, { selected: @selected_tenant }, required: true %>
        </div>
      <% else %>
        <%= form.hidden_field :tenant_id, value: @tenants.first&.id %>
        <p><strong><%= @tenants.first&.name %></strong></p>
      <% end %>
      <div class="campo">
        <%= form.label :file, "Arquivo CSV" %>
        <%= form.file_field :file, accept: ".csv,text/csv", required: true %>
        <small>Até 50 MB e 200 mil linhas. Obrigatórias: <%= columns.select { |_, required, _, _| required }.map(&:first).to_sentence(two_words_connector: " e ", last_word_connector: " e ") %>.</small>
      </div>
      <% if @kind == "portfolio" %>
        <fieldset>
          <legend>Modo</legend>
          <label><%= form.radio_button :mode, "incremental", checked: true %> Incremental: acrescenta e atualiza; o que não vier fica como está</label>
          <label><%= form.radio_button :mode, "full_sync", checked: false %> Carga completa: o que não vier sai da cobrança</label>
        </fieldset>
      <% end %>
      <div class="acoes" data-rodape><button type="submit">Enviar e conferir</button></div>
    <% end %>
  </section>

  <section class="cartao" aria-labelledby="colunas">
    <header><h2 id="colunas">Colunas da planilha</h2><%= informacao "colunas", "Separador ponto e vírgula, UTF-8 ou Windows-1252. A ordem das colunas é livre; o cabeçalho é obrigatório.#{" A planilha modelo, sem alteração, é aceita na conferência." if @kind == "portfolio"}", "definicao-colunas" %></header>
    <div class="tabela" tabindex="0">
      <table>
        <caption class="apenas-leitor-de-tela">Colunas da planilha</caption>
        <thead><tr><th scope="col">Coluna</th><th scope="col">Obrigatória</th><th scope="col">Formato</th><th scope="col">Exemplo</th></tr></thead>
        <tbody>
          <% columns.each do |name, required, format_text, example| %>
            <tr>
              <th scope="row"><code><%= name %></code></th>
              <td><%= required ? "Sim" : "Não" %></td>
              <td><%= format_text %></td>
              <td><%= example %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
