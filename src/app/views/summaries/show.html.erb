<% content_for :title, "Resumo da carteira" %>
<header class="cabecalho-da-pagina"><h1>Resumo da carteira</h1></header>

<% if @summaries.empty? %>
  <p class="vazio">Nenhuma carteira para mostrar. Importe a carteira para ver o resumo.</p>
<% end %>

<% if @summaries.size > 1 %>
  <section class="cartao" aria-labelledby="total-pago">
    <header><h2 id="total-pago">Todos os credores</h2></header>
    <div>
      <dl class="valores">
        <% @summaries.first[:recovered].each_index do |index| %>
          <div><dt>Pago em <%= @summaries.first[:recovered][index][:label] %></dt><dd><%= money(@summaries.sum { |summary| summary[:recovered][index][:gross_cents] }) %></dd></div>
        <% end %>
      </dl>
      <p><small>Soma só dos valores em reais pagos e aplicados a títulos. O recuperado, os créditos e os encargos dependem das políticas de cada credor e ficam separados.</small></p>
    </div>
  </section>
<% end %>

<% @summaries.each do |summary| %>
  <% detail_only = summary[:upcoming_display] == "detail_only" %>
  <section class="cartao" aria-labelledby="carteira-<%= summary[:tenant].id %>">
    <header>
      <div>
        <h2 id="carteira-<%= summary[:tenant].id %>"><%= summary[:tenant].name %></h2>
        <% if summary[:tenant].trade_name.present? || summary[:tenant].legal_name.present? %>
          <p><%= summary[:tenant].display_name %> · carteira de <%= number_br(summary[:customers]) %> clientes · referência <%= date_br(Date.current) %></p>
        <% end %>
      </div>
    </header>
    <div>
      <dl class="valores">
        <div><dt>Clientes em cobrança</dt><dd><%= number_br(detail_only ? summary[:customers_overdue] : summary[:customers]) %></dd></div>
        <div><dt>Títulos</dt><dd><%= number_br(summary[:bills]) %></dd></div>
        <div><dt>Vencido</dt><dd><%= money(summary[:overdue_cents]) %></dd></div>
        <div><dt>A vencer</dt><dd><%= detail_only ? "—" : money(summary[:upcoming_cents]) %></dd></div>
        <div><dt>Atualizado</dt><dd><%= money(summary[:updated][:total_cents]) %></dd></div>
      </dl>
      <% if summary[:updated][:calculated_on] %>
        <p><small>Atualizado: principal corrigido, multa, juros e honorários dos títulos vencidos, pelas regras de <%= summary[:tenant].name %>, até <%= date_br(summary[:updated][:calculated_on]) %>. Não se soma com o de outro credor.</small></p>
      <% end %>
      <% if summary[:upcoming_display] == "summed" %>
        <p><small>Em cobrança, somando o a vencer: <%= money(summary[:overdue_cents] + summary[:upcoming_cents]) %> (vencido <%= money(summary[:overdue_cents]) %>).</small></p>
      <% end %>
    </div>
  </section>

  <section class="cartao" aria-labelledby="recebimentos-<%= summary[:tenant].id %>">
    <header><h2 id="recebimentos-<%= summary[:tenant].id %>">Recuperado — <%= summary[:tenant].name %></h2></header>
    <div>
      <dl class="valores">
        <% summary[:recovered].each do |month| %>
          <div><dt>Recuperado em <%= month[:label] %></dt><dd><%= money(month[:total_cents]) %></dd></div>
        <% end %>
        <div><dt>Créditos dos contratos</dt><dd><%= money(summary[:credit_cents]) %></dd></div>
        <div><dt>Pagamentos pendentes</dt><dd><%= number_br(summary[:pending_count]) %> <small>(<%= money(summary[:pending_cents]) %>)</small></dd></div>
      </dl>
      <% summary[:recovered].each do |month| %>
        <% next if month[:methods].empty? %>
        <p><small>Em <%= month[:label] %>, por meio: <%= month[:methods].sort_by { |_, cents| -cents }.map { |method, cents| "#{t("payments.methods.#{method}")} #{money(cents)}" }.join("; ") %>.</small></p>
      <% end %>
      <p><small>Recuperado é o que foi aplicado a títulos, pela data do pagamento, menos os estornos conforme a política do credor. Crédito (inclusive o excedente de título com valor reduzido) e pendente não entram.</small></p>
    </div>
  </section>

  <section class="cartao" aria-labelledby="acionamentos-<%= summary[:tenant].id %>">
    <header><div><h2 id="acionamentos-<%= summary[:tenant].id %>">Acionamentos — <%= summary[:tenant].name %></h2><p>Pela data do contato. O cliente acionado mais de uma vez conta uma vez em cada tipo.</p></div></header>
    <div class="tabela">
      <table>
        <caption class="apenas-leitor-de-tela">Acionamentos de <%= summary[:tenant].name %> nos últimos 7 e 30 dias</caption>
        <thead>
          <tr>
            <th scope="col">Tipo do resultado</th>
            <% summary[:contacts].each do |window| %>
              <th scope="col" data-numerico>Acionamentos em <%= window[:days] %> dias</th><th scope="col" data-numerico>Clientes em <%= window[:days] %> dias</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Total</th>
            <% summary[:contacts].each do |window| %><td data-numerico><%= number_br(window[:total][:attempts]) %></td><td data-numerico><%= number_br(window[:total][:customers]) %></td><% end %>
          </tr>
          <% ContactResult::KINDS.each_key do |kind| %>
            <tr>
              <th scope="row"><%= t("contacts.kinds.#{kind}") %></th>
              <% summary[:contacts].each do |window| %><td data-numerico><%= number_br(window[:kinds][kind][:attempts]) %></td><td data-numerico><%= number_br(window[:kinds][kind][:customers]) %></td><% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <div class="duas-colunas">
    <% [ [ "Por cliente", "Cada cliente na faixa do título mais atrasado, com todo o seu vencido.", summary[:by_customer], "Clientes" ],
         [ "Por título", "Cada título vencido na faixa do próprio atraso.", summary[:by_bill], "Títulos" ] ].each do |title, help, rows, unit| %>
      <% maximum = [ rows.sum { |row| row[:cents] }, 1 ].max %>
      <section class="cartao" aria-labelledby="faixas-<%= summary[:tenant].id %>-<%= title.parameterize %>">
        <header>
          <div><h2 id="faixas-<%= summary[:tenant].id %>-<%= title.parameterize %>">Faixas de atraso — <%= title %></h2><p><%= help %></p></div>
        </header>
        <div class="tabela">
          <table>
            <thead><tr><th scope="col">Faixa (dias)</th><th scope="col" data-numerico><%= unit %></th><th scope="col" data-numerico>Valor vencido</th><th scope="col" data-numerico>Atualizado</th><th scope="col"><span class="apenas-leitor-de-tela">Proporção do vencido</span></th></tr></thead>
            <tbody>
              <% rows.each do |row| %>
                <tr>
                  <td><%= row[:label] %></td>
                  <td data-numerico><%= number_br(row[:count]) %></td>
                  <td data-numerico><%= money(row[:cents]) %></td>
                  <td data-numerico><%= money(row[:updated_cents]) %></td>
                  <td><progress value="<%= row[:cents] %>" max="<%= maximum %>" aria-label="<%= row[:label] %> dias: <%= money(row[:cents]) %>"></progress></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  </div>

  <% if summary[:updated][:segments].any? %>
    <section class="cartao" aria-labelledby="segmentos-<%= summary[:tenant].id %>">
      <header><div><h2 id="segmentos-<%= summary[:tenant].id %>">Segmentos — <%= summary[:tenant].name %></h2><p>Clientes, saldo e valor atualizado dos títulos vencidos de cada segmento de contrato.</p></div></header>
      <div class="tabela">
        <table>
          <caption class="apenas-leitor-de-tela">Segmentos de <%= summary[:tenant].name %></caption>
          <thead><tr><th scope="col">Segmento</th><th scope="col" data-numerico>Clientes</th><th scope="col" data-numerico>Saldo</th><th scope="col" data-numerico>Atualizado</th></tr></thead>
          <tbody>
            <% summary[:updated][:segments].each do |row| %>
              <tr><th scope="row"><%= row[:name] %></th><td data-numerico><%= number_br(row[:customers]) %></td><td data-numerico><%= money(row[:balance_cents]) %></td><td data-numerico><%= money(row[:updated_cents]) %></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
<% end %>
