<% content_for :title, "Resumo da carteira" %>
<%= pagina "Resumo da carteira", subtitulo: ("Referência #{date_br(Date.current)}" if @summary) %>

<%# Filtro de credor (01, revisão 8, R23): só para quem consulta mais de um credor; sem estado guardado. %>
<% if @tenants.size > 1 %>
  <form class="filtros" role="search" action="<%= summary_path %>" method="get">
    <div class="campo">
      <label for="summary-tenant">Credor</label>
      <select id="summary-tenant" name="credor"><option value="">Todos os credores</option><%= options_for_select(@tenants.map { |tenant| [ tenant.name, tenant.id ] }, @tenant&.id) %></select>
    </div>
    <button type="submit" data-variant="secondary">Filtrar</button>
  </form>
<% end %>

<%= render "summaries/result" %>
