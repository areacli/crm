<% content_for :title, "Arquivo de acordos" %>
<%# Arquivo de acordos (11, R244): exportar para o credor emitir a entrada e as parcelas, e a lista das exportações. Só os credores em que o usuário administra acordos. %>
<%= pagina "Arquivo de acordos", subtitulo: safe_join([ "O que o credor precisa para emitir a entrada e as parcelas. ", link_to("Voltar para os acordos", agreements_path) ]) do %>
  <%= abrir_painel "Exportar", new_agreement_export_path %>
<% end %>

<% if @unseen.any? %>
  <%= aviso(tom: :warning) do %>
    <p>Entrada, título de estorno ou título reaberto com vencimento nos próximos 3 dias úteis que ainda não está em nenhum arquivo baixado:
      <%= safe_join(@unseen.map { |item| safe_join([ link_to(item.bill.number, agreement_path(item.agreement)), " (", item.tenant.name, ", vence em ", date_br(item.bill.due_date), ")" ]) }, "; ") %>.</p>
  <% end %>
<% end %>

<section class="cartao" aria-labelledby="exportacoes">
  <header><h2 id="exportacoes">Exportações</h2><%= informacao "arquivo do dia", "O arquivo do dia é gerado todos os dias e não muda o marco das novidades. Os arquivos duram 30 dias.", "definicao-arquivo-do-dia" %></header>
  <% if @exports.empty? %>
    <p class="vazio">Nenhuma exportação ainda.</p>
  <% else %>
    <div class="tabela" tabindex="0">
      <table>
        <caption class="apenas-leitor-de-tela">Exportações do arquivo de acordos</caption>
        <thead><tr><th scope="col">Quando</th><th scope="col">Credor</th><th scope="col">Forma</th><th scope="col" data-numerico>Linhas</th><th scope="col">Quem</th><th scope="col">Arquivo</th></tr></thead>
        <tbody>
          <% @exports.each do |export| %>
            <tr>
              <td><%= datetime_br(export.created_at) %></td>
              <td><%= export.tenant.name %></td>
              <td><%= t("agreements.export_forms.#{export.form}") %></td>
              <td data-numerico><%= number_br(export.lines) %></td>
              <td><%= export.user&.name || "Sistema" %></td>
              <td><%= export.available? ? link_to("Baixar", agreement_export_path(export), "hx-boost": "false") : "Apagado (mais de 30 dias)" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
