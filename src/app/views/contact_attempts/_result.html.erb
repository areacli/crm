<%# Trecho que o htmx refaz a cada filtro, página ou aviso do WebSocket: contagem, tabela e paginação. %>
<div id="resultado" aria-live="polite" hx-get="<%= contact_attempts_path(request.query_parameters) %>" hx-trigger="cable:contact-attempts-changed from:body, cable:connected from:body" hx-include="form.filtros" hx-sync="form.filtros:replace" hx-swap="outerHTML" hx-push-url="false">
  <% if @attempts.empty? %>
    <p class="vazio">Nenhum acionamento no período.</p>
  <% else %>
    <div class="tabela" tabindex="0" data-fixa>
      <table data-detalhes>
        <caption class="apenas-leitor-de-tela">Acionamentos</caption>
        <thead>
          <tr>
            <th scope="col"><%= alternar_todos_os_detalhes %>Contato</th><th scope="col">Cliente</th>
            <% if @several_tenants %><th scope="col">Credor</th><% end %>
            <th scope="col">Canal</th><th scope="col">Resultado</th><th scope="col">Tipo</th><th scope="col">Operador</th><% if @origins.present? %><th scope="col">Origem</th><% end %><th scope="col">Retorno</th>
          </tr>
        </thead>
        <tbody>
          <% @attempts.each do |attempt| %>
            <% detail_id = "detalhe-acionamento-#{attempt.id}" %>
            <tr>
              <th scope="row"><% if attempt.contract %><%= alternar_detalhe(detail_id, "acionamento de #{datetime_br(attempt.contacted_at)}") %><% end %><%= datetime_br(attempt.contacted_at) %></th>
              <td><%= link_to attempt.customer.name, customer_path(attempt.customer, anchor: "acionamentos") %></td>
              <% if @several_tenants %><td><%= attempt.tenant.name %></td><% end %>
              <td><%= t("contacts.channels.#{attempt.channel}") %></td>
              <td><%= attempt.result.name %></td>
              <td><%= t("contacts.kinds.#{attempt.result_kind}") %></td>
              <td><%= attempt.summary_only_for_viewer? ? "Outra origem" : (attempt.user&.name || "—") %></td>
              <% if @origins.present? %><td><%= origin_label(attempt) %></td><% end %>
              <td><%= attempt.return_at ? datetime_br(attempt.return_at) : "—" %></td>
            </tr>
            <% if attempt.contract %>
              <%= detalhe_da_linha(detail_id, 7 + (@several_tenants ? 1 : 0) + (@origins.present? ? 1 : 0)) { tag.p("Contrato #{attempt.contract.label}.") } %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/paginacao", pagination: @pagination, unit: "acionamentos", path: ->(page) { contact_attempts_path(request.query_parameters.merge("page" => page)) } %>
  <% end %>
</div>
