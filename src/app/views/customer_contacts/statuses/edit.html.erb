<% valores = params[:status].respond_to?(:permit) ? params[:status] : {} %>
<% titulo, enviar, perigoso = { "invalid" => [ "Marcar como inválido", "Marcar como inválido", true ], "do_not_disturb" => [ "Marcar não perturbe", "Marcar não perturbe", false ],
                                "valid" => [ "Voltar a válido", "Voltar a válido", false ] }.fetch(@status) %>
<%= formulario_de_painel(titulo: titulo, descricao: "Contato: #{@contact.value}", url: customer_contact_status_path(@customer, @contact), metodo: :patch, enviar: enviar, perigoso: perigoso, variante: :modal,
                         escopo: :status, erro: @error, voltar: customer_path(@customer, aba: "contatos")) do |form| %>
  <%= form.hidden_field :status, value: @status %>
  <% if @status == "do_not_disturb" %>
    <div class="campo"><%= form.label :requested_on, "Data do pedido do cliente" %><%= form.date_field :requested_on, value: (valores[:requested_on] || Date.current.iso8601), max: Date.current.iso8601, required: true %></div>
  <% else %>
    <div class="campo"><%= form.label :reason, "Motivo" %><%= form.text_field :reason, value: valores[:reason], required: true, maxlength: 300 %></div>
  <% end %>
<% end %>
