<% content_for :title, "Divergência do título #{@discrepancy.bill.number}" %>
<% item = @discrepancy %>
<%= pagina "Divergência do título #{item.bill.number}", subtitulo: safe_join([ item.tenant.name, " · ", link_to("Voltar para as divergências", value_discrepancies_path) ]),
           indicadores: [ (item.open? ? situacao("Aberta", tom: :warning) : situacao("Tratada", tom: :success)) ] do %>
  <% if item.open? && policy(item).create? %><%= abrir_painel "Tratar divergência", new_value_discrepancy_handling_path(item) %><% end %>
  <% if @can_view_customer %><%= link_to "Ver o histórico do título", bill_path(item.bill), class: "botao", data: { variant: "secondary" } %><% end %>
<% end %>

<div class="duas-colunas">
  <section class="cartao" aria-labelledby="dados">
    <header><h2 id="dados">O que mudou</h2><%= informacao "efeito", "O efeito aplicado depende da política de divergência do credor e do que já foi pago no título.", "definicao-efeito" %></header>
    <div>
      <dl class="dados">
        <dt>Cliente</dt><dd><% if @can_view_customer %><%= link_to item.bill.customer.name, customer_path(item.bill.customer) %><% else %><%= item.bill.customer.name %><% end %></dd>
        <dt>Título</dt><dd><%= item.bill.number %></dd>
        <dt>Valor anterior</dt><dd><%= money(item.previous_cents) %></dd>
        <dt>Valor informado</dt><dd><%= money(item.reported_cents) %></dd>
        <dt>Pago até então</dt><dd><%= money(item.allocated_cents) %></dd>
        <dt>Saldo antes</dt><dd><%= money(item.balance_before_cents) %></dd>
        <dt>Saldo depois</dt><dd><%= money(item.balance_after_cents) %></dd>
        <% if item.excess_cents.positive? %><dt>Excedente</dt><dd><%= money(item.excess_cents) %></dd><% end %>
        <dt>Efeito aplicado</dt><dd><%= t("discrepancies.effects.#{item.effect}") %> <small>(política: <%= t("discrepancies.policies.#{item.policy}").downcase %>)</small></dd>
        <dt>Registrada em</dt><dd><%= datetime_br(item.created_at) %></dd>
      </dl>
      <% if item.effect_record_only? %><p><small>Título pago: a carga nunca o altera. A divergência existe só para registro.</small></p><% end %>
    </div>
  </section>

  <section class="cartao" aria-labelledby="tratamento">
    <header><h2 id="tratamento">Tratamento</h2></header>
    <div>
      <% if item.handled? %>
        <dl class="dados">
          <dt>Tratada por</dt><dd><%= item.handled_by&.name || "—" %></dd>
          <dt>Em</dt><dd><%= datetime_br(item.handled_at) %></dd>
          <dt>Escolha</dt><dd><%= t("discrepancies.choices.#{item.choice}") %></dd>
          <dt>Nota</dt><dd><%= item.note %></dd>
        </dl>
      <% else %>
        <p class="vazio">Ainda não tratada. Use "Tratar divergência" na barra da página.</p>
      <% end %>
    </div>
  </section>
</div>
