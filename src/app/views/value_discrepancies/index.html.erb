<% content_for :title, "Divergências de valor" %>
<%= pagina "Divergências de valor", subtitulo: "Títulos com pagamento cujo valor o credor mudou numa carga." %>

<form class="filtros" role="search" action="<%= value_discrepancies_path %>" method="get">
  <div class="campo">
    <label for="status">Situação</label>
    <select id="status" name="situacao">
      <%= opcoes_de_filtro([ [ "Abertas", "open" ], [ "Tratadas", "handled" ], [ "Todas", "all" ] ], params[:situacao].presence || FilterValue.to_url("open")) %>
    </select>
  </div>
  <% if @several_tenants %>
    <div class="campo">
      <label for="tenant">Credor</label>
      <select id="tenant" name="credor"><option value="">Todos</option><%= options_for_select(@tenants, params[:credor]) %></select>
    </div>
  <% end %>
  <div class="campo">
    <label for="per_page" class="apenas-leitor-de-tela">Por página</label>
    <select id="per_page" name="por_pagina"><%= options_for_select(Pagination::PER_PAGE_OPTIONS, @pagination.per_page) %></select>
  </div>
  <button type="submit" data-variant="secondary">Filtrar</button>
</form>

<%= render "value_discrepancies/result" %>
