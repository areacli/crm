<% content_for :title, "Acordos" %>
<% content_for :cable_channels, @cable %>
<%= pagina "Acordos", subtitulo: "Propostas e acordos dos credores em que você negocia. A proposta nasce da simulação, na ficha do cliente." do %>
  <% if policy(AgreementExport).index? %><%= link_to "Ver o arquivo de acordos", agreement_exports_path, class: "botao", data: { variant: "secondary" } %><% end %>
<% end %>

<form class="filtros" role="search" action="<%= agreements_path %>" method="get">
  <div class="campo">
    <label for="state">Situação</label>
    <select id="state" name="estado"><option value="">Todas</option><%= opcoes_de_filtro(Agreement::STATES.map { |state| [ t("agreements.states.#{state}"), state ] }, @filters[:state]) %></select>
  </div>
  <div class="campo">
    <label for="from">De</label>
    <input type="date" id="from" name="de" value="<%= @filters[:from]&.iso8601 %>">
  </div>
  <div class="campo">
    <label for="to">Até</label>
    <input type="date" id="to" name="ate" value="<%= @filters[:to]&.iso8601 %>">
  </div>
  <div class="campo">
    <label for="user">Quem montou</label>
    <select id="user" name="usuario"><option value="">Todos</option><%= options_for_select(@operators, @filters[:user]) %></select>
  </div>
  <% if @origins.present? %>
    <div class="campo">
      <label for="origin">Origem</label>
      <select id="origin" name="origem"><option value="">Todas</option><%= opcoes_de_filtro([ [ "Equipe do credor", "team" ] ] + @origins, params[:origem]) %></select>
    </div>
  <% end %>
  <% if @several_tenants %>
    <div class="campo">
      <label for="tenant">Credor</label>
      <select id="tenant" name="credor"><option value="">Todos</option><%= options_for_select(@tenants, @filters[:tenant]) %></select>
    </div>
  <% end %>
  <div class="campo">
    <label for="per_page" class="apenas-leitor-de-tela">Por página</label>
    <select id="per_page" name="por_pagina"><%= options_for_select(Pagination::PER_PAGE_OPTIONS, @pagination.per_page) %></select>
  </div>
  <button type="submit" data-variant="secondary">Filtrar</button>
</form>

<%= render "agreements/result" %>
