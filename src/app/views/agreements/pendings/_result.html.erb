<%# Propostas pendentes que o usuário pode aprovar (R216, R243). Refeita a cada evento do WebSocket (cable:agreements-changed). %>
<div id="resultado" hx-get="<%= pending_agreements_path(tenant: params[:tenant].presence) %>" hx-trigger="cable:agreements-changed from:body" hx-swap="outerHTML" hx-target="this">
  <% if @agreements.empty? %>
    <p class="vazio">Nenhuma proposta pendente para você aprovar.</p>
  <% else %>
    <div class="tabela" tabindex="0">
      <table data-compacta>
        <caption class="apenas-leitor-de-tela">Propostas pendentes de aprovação</caption>
        <thead>
          <tr>
            <% if @several_tenants %><th scope="col">Credor</th><% end %>
            <th scope="col">Número</th><th scope="col">Cliente</th><th scope="col" data-numerico>Valor do acordo</th><th scope="col" data-numerico>Desconto</th>
            <th scope="col">Desconto por componente</th><th scope="col" data-numerico>Parcelas</th><th scope="col">Montou</th><th scope="col">Vale até</th><th scope="col">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @agreements.each do |agreement| %>
            <tr>
              <% if @several_tenants %><td><%= agreement.tenant.name %></td><% end %>
              <th scope="row"><%= agreement_link(agreement) %></th>
              <td><%= link_to agreement.customer.name, customer_path(agreement.customer, anchor: "acordos") %></td>
              <td data-numerico><%= money(agreement.value_cents) %></td>
              <td data-numerico><%= money(agreement.discount_cents) %></td>
              <td><%= discounts_text(agreement.discounts) %></td>
              <td data-numerico><%= number_br(agreement.installments_count) %></td>
              <td><%= agreement.user&.name || "—" %></td>
              <td><%= date_br(agreement.valid_until) %></td>
              <td>
                <div class="acoes">
                  <%= button_to "Aprovar proposta", agreement_approval_path(agreement), form: { "hx-boost": "false" }, data: { variant: "secondary", size: "small" }, "aria-label": "Aprovar proposta #{agreement.number}" %>
                </div>
                <details>
                  <summary>Recusar proposta</summary>
                  <%= form_with scope: :agreement, url: agreement_refusal_path(agreement), html: { "hx-boost": "false" } do |form| %>
                    <div class="campo"><%= form.label :reason, "Motivo da recusa", for: "recusa-#{agreement.id}" %><%= form.text_field :reason, id: "recusa-#{agreement.id}", required: true, maxlength: 300 %></div>
                    <div class="acoes"><button type="submit" data-variant="danger-outline" data-size="small" aria-label="Recusar proposta <%= agreement.number %>">Recusar proposta</button></div>
                  <% end %>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
