<% content_for :title, "Acordos pendentes" %>
<% content_for :cable_channels, @cable %>
<%= pagina "Acordos pendentes", subtitulo: "Propostas fora dos limites de quem as montou, que você pode aprovar. A que você montou espera outra pessoa." %>

<% if @several_tenants %>
  <form class="filtros" role="search" action="<%= pending_agreements_path %>" method="get" hx-sync="this:replace" hx-get="<%= pending_agreements_path %>" hx-trigger="change" hx-target="#resultado" hx-push-url="true" hx-swap="outerHTML">
    <div class="campo">
      <label for="tenant">Credor</label>
      <select id="tenant" name="tenant"><option value="">Todos</option><%= options_for_select(@tenants, params[:tenant]) %></select>
    </div>
    <button type="submit" data-variant="secondary">Filtrar</button>
  </form>
<% end %>

<%= render "agreements/pendings/result" %>
