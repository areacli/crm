<% content_for :title, "Acordos pendentes" %>
<% content_for :cable_channels, @cable %>
<%= pagina "Acordos pendentes", subtitulo: "Propostas fora dos limites de quem as montou, que você pode aprovar. A que você montou espera outra pessoa." %>

<form class="filtros" role="search" action="<%= pending_agreements_path %>" method="get">
  <% if @several_tenants %>
    <div class="campo">
      <label for="tenant">Credor</label>
      <select id="tenant" name="credor"><option value="">Todos</option><%= options_for_select(@tenants, params[:credor]) %></select>
    </div>
  <% end %>
  <div class="campo">
    <label for="per_page">Por página</label>
    <select id="per_page" name="por_pagina"><%= options_for_select(Pagination::PER_PAGE_OPTIONS, @pagination.per_page) %></select>
  </div>
  <button type="submit" data-variant="secondary">Filtrar</button>
</form>

<%= render "agreements/pendings/result" %>
