<%# Trecho que o htmx refaz a cada filtro, página ou aviso do WebSocket: casos do gestor, contagem, tabela e paginação. %>
<div id="resultado" aria-live="polite" hx-get="<%= agreements_path(request.query_parameters) %>" hx-trigger="cable:agreements-changed from:body, cable:connected from:body" hx-swap="outerHTML" hx-push-url="false">
  <% if @cases.present? %>
    <section class="cartao" id="casos" aria-labelledby="casos-do-gestor">
      <header><div><h2 id="casos-do-gestor">Casos que pedem o gestor</h2><p>Vistos só por quem administra acordos.</p></div></header>
      <div class="tabela" tabindex="0">
        <table>
          <caption class="apenas-leitor-de-tela">Casos que pedem o gestor</caption>
          <thead><tr><th scope="col">Caso</th><th scope="col">Acordo</th><th scope="col">Cliente</th><th scope="col">Credor</th><th scope="col">Detalhe</th></tr></thead>
          <tbody>
            <% @cases.each do |item| %>
              <tr>
                <th scope="row"><%= t("agreements.cases.#{item.kind}") %></th>
                <td><%= item.agreement ? agreement_link(item.agreement) : "—" %></td>
                <td><%= item.customer ? link_to(item.customer.name, customer_path(item.customer, anchor: "acordos")) : "—" %></td>
                <td><%= item.tenant.name %></td>
                <td><%= item.link ? link_to(item.detail, item.link) : item.detail %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
  <% if @agreements.empty? %>
    <p class="vazio">Nenhuma proposta ou acordo com estes filtros.</p>
  <% else %>
    <p><small>Mostrando <%= number_br(@pagination.first_item) %> a <%= number_br(@pagination.last_item) %> de <%= number_br(@pagination.total) %> acordos.</small></p>
    <div class="tabela" tabindex="0">
      <table data-compacta>
        <caption class="apenas-leitor-de-tela">Propostas e acordos</caption>
        <thead>
          <tr>
            <th scope="col">Número</th><th scope="col">Cliente</th>
            <% if @several_tenants %><th scope="col">Credor</th><% end %>
            <th scope="col">Situação</th><th scope="col">Forma</th><th scope="col" data-numerico>Valor</th><th scope="col" data-numerico>Desconto</th>
            <th scope="col" data-numerico>Entrada</th><th scope="col" data-numerico>Parcelas</th><th scope="col">Montou</th><th scope="col">Aprovou</th><th scope="col">Vale até</th>
          </tr>
        </thead>
        <tbody>
          <% @agreements.each do |agreement| %>
            <tr>
              <th scope="row"><%= agreement_link(agreement) %></th>
              <td><%= link_to agreement.customer.name, customer_path(agreement.customer, anchor: "acordos") %></td>
              <% if @several_tenants %><td><%= agreement.tenant.name %></td><% end %>
              <td><%= agreement_state(agreement) %></td>
              <td><%= agreement_mode(agreement) %></td>
              <td data-numerico><%= money(agreement.value_cents) %></td>
              <td data-numerico><%= money(agreement.discount_cents) %></td>
              <td data-numerico><%= money(agreement.down_payment_cents) %></td>
              <td data-numerico><%= number_br(agreement.installments_count) %></td>
              <td><%= agreement.user&.name || "—" %></td>
              <td><%= agreement.decided_by&.name || "—" %></td>
              <td><%= date_br(agreement.valid_until) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/paginacao", pagination: @pagination, path: ->(page) { agreements_path(request.query_parameters.merge("page" => page)) } %>
  <% end %>
</div>
