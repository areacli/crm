<%= formulario_de_painel(titulo: "Novo usuário", descricao: "Se o e-mail já pertence a alguém de outro credor, a pessoa é ligada a este credor na hora; senão, nasce com senha temporária.", url: memberships_path, enviar: "Salvar",
                         escopo: :membership, erro: @error, voltar: memberships_path) do |form| %>
  <% if @tenants.size > 1 %>
    <div class="campo">
      <%= form.label :tenant_id, "Credor" %>
      <%= form.select :tenant_id, @tenants.map { |tenant| [ tenant.name, tenant.id ] }, { selected: @tenant.id }, required: true,
                      "hx-get": new_membership_path, "hx-trigger": "change", "hx-target": "#campo-perfil", "hx-swap": "outerHTML", "hx-push-url": "false", "hx-include": "this" %>
    </div>
  <% else %>
    <%= form.hidden_field :tenant_id, value: @tenant.id %>
    <p>Credor: <strong><%= @tenant.name %></strong></p>
  <% end %>
  <div class="campo">
    <%= form.label :email_address, "E-mail" %>
    <%= form.email_field :email_address, required: true, autocomplete: "off", value: @form&.dig(:email_address) %>
    <small>É o identificador de entrada; nada é enviado para ele.</small>
  </div>
  <div class="campo">
    <%= form.label :name, "Nome" %>
    <%= form.text_field :name, autocomplete: "off", maxlength: 150, value: @form&.dig(:name) %>
    <small>Obrigatório para um usuário novo; ignorado se o e-mail já existe.</small>
  </div>
  <%= render "memberships/profile_field" %>
<% end %>
