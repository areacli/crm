<%# Trecho que o htmx refaz a cada busca: tabela, contagem e paginação. %>
<div id="resultado" aria-live="polite">
  <% if @memberships.empty? %>
    <p class="vazio">Nenhum usuário encontrado.</p>
  <% else %>
    <div class="tabela" tabindex="0" data-fixa>
      <table>
        <caption class="apenas-leitor-de-tela">Usuários dos credores</caption>
        <thead>
          <tr>
            <th scope="col">Nome</th>
            <th scope="col">E-mail</th>
            <% if @several_tenants %><th scope="col">Credor</th><% end %>
            <th scope="col">Perfil</th>
            <th scope="col">Situação</th>
            <th scope="col"><span class="apenas-leitor-de-tela">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <% @memberships.each do |membership| %>
            <tr>
              <th scope="row"><%= link_to membership.user.name, membership_path(membership) %><%= " (você)" if membership.user_id == Current.user.id %></th>
              <td><%= membership.user.email_address %></td>
              <% if @several_tenants %><td><%= membership.tenant.name %></td><% end %>
              <td><%= membership.profile.name %></td>
              <td><%= membership_status(membership) %></td>
              <td data-acoes>
                <%= menu_de_linha("vinculo-#{membership.id}", "Ações de #{membership.user.name}") do %>
                  <%= link_to "Abrir usuário", membership_path(membership), class: "botao" %>
                  <% unless membership.user_id == Current.user.id %>
                    <%= abrir_painel "Mudar o perfil", edit_membership_profile_path(membership) %>
                    <% if membership.active? %>
                      <%= confirmar_no_painel "Desativar o acesso", titulo: "Desativar o acesso?", acao: "Desativar o acesso", url: membership_activation_path(membership), metodo: :delete,
                                              mensagem: "#{membership.user.name} deixa de operar #{membership.tenant.name} na próxima ação. Os acessos em outros credores não mudam." %>
                    <% else %>
                      <%= confirmar_no_painel "Reativar o acesso", titulo: "Reativar o acesso?", acao: "Reativar o acesso", url: membership_activation_path(membership), perigoso: false,
                                              mensagem: "#{membership.user.name} volta a operar #{membership.tenant.name}." %>
                    <% end %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/paginacao", pagination: @pagination, unit: "usuários", path: ->(page) { memberships_path(request.query_parameters.merge("page" => page)) } %>
  <% end %>
</div>
