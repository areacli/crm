<%# Perfis do credor escolhido: só este campo muda quando o credor muda (`data-spa-dependentes` no seletor do credor). %>
<div class="campo" id="campo-perfil"<% if local_assigns[:fora_de_banda] %> data-fora-de-banda="true"<% end %>>
  <label for="membership_profile_id">Perfil</label>
  <%= select_tag "membership[profile_id]", options_for_select(@profiles.map { |profile| [ profile.name, profile.id ] }, @form&.dig(:profile_id)),
                 id: "membership_profile_id", required: true %>
</div>
