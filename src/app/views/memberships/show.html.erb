<% user = @membership.user %>
<% self_membership = user.id == Current.user.id %>
<% content_for :title, user.name %>
<%= pagina user.name, subtitulo: "#{user.email_address} · #{@membership.tenant.name}", indicadores: [ membership_status(@membership) ] do %>
  <% unless self_membership %>
    <% if @membership.active? %>
      <%= confirmar_no_painel "Desativar o acesso", titulo: "Desativar o acesso?", acao: "Desativar o acesso", url: membership_activation_path(@membership), metodo: :delete,
                              mensagem: "#{user.name} deixa de operar #{@membership.tenant.name} na próxima ação. Os acessos em outros credores não mudam." %>
    <% else %>
      <%= confirmar_no_painel "Reativar o acesso", titulo: "Reativar o acesso?", acao: "Reativar o acesso", url: membership_activation_path(@membership), perigoso: false,
                              mensagem: "#{user.name} volta a operar #{@membership.tenant.name}.", variante: "secondary" %>
    <% end %>
    <% if @membership.personal_data_editable? %>
      <%= menu_de_linha("mais-acoes", "Mais ações do usuário") do %>
        <%= confirmar_no_painel "Redefinir a senha", titulo: "Redefinir a senha?", acao: "Redefinir a senha", url: membership_password_reset_path(@membership), perigoso: false,
                                mensagem: "Uma nova senha temporária será gerada e mostrada uma única vez. A senha atual e as sessões abertas de #{user.name} deixam de valer." %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if flash[:temporary_password] %><%= render "memberships/temporary_password", data: flash[:temporary_password] %><% end %>

<%# Na SPA: o acesso à esquerda, com o nome e o perfil editáveis na linha (design system, 7.1), e o histórico à direita. %>
<div class="ficha" data-lateral="esquerda">
  <section class="cartao" aria-labelledby="acesso">
    <header><h2 id="acesso">Acesso em <%= @membership.tenant.name %></h2></header>
    <div>
      <dl class="dados">
        <dt>Nome</dt>
        <dd><%= !self_membership && @membership.personal_data_editable? ? campo_inline(user.name, rotulo: "Nome", url: membership_path(@membership), nome: "user[name]", maximo: 150) : user.name %></dd>
        <dt>Perfil</dt>
        <dd><%= self_membership ? @membership.profile.name : campo_inline(@membership.profile.name, rotulo: "Perfil", url: membership_profile_path(@membership), nome: "membership[profile_id]",
                                                                           opcoes: @membership.tenant.profiles.order(:name).map { |profile| [ profile.name, profile.id ] }, selecionado: @membership.profile_id) %></dd>
        <dt>Último acesso</dt><dd><%= user.last_login_at ? datetime_br(user.last_login_at) : "Nunca entrou" %></dd>
        <% if user.temporary_password? %><dt>Senha temporária até</dt><dd><%= datetime_br(user.temporary_password_until) %></dd><% end %>
      </dl>
      <% if self_membership %>
        <p><small>Esta é a sua conta. Outra pessoa com a permissão de gerenciar usuários muda o seu perfil ou o seu acesso; a senha você troca pelo menu do seu nome, no alto da tela.</small></p>
      <% elsif !@membership.personal_data_editable? %>
        <p><small>Nome e senha são da pessoa, não do credor. Como ela atua em mais de um credor, só ela mesma e o administrador do sistema os alteram.</small></p>
      <% end %>
    </div>
  </section>
  <%= render "memberships/history", user: user %>
</div>
