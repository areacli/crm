<% content_for :title, "Usuários" %>
<%= pagina "Usuários", subtitulo: "Quem tem acesso aos credores que você administra" do %>
  <%= abrir_painel "Criar usuário", new_membership_path %>
<% end %>

<form class="filtros" role="search" action="<%= memberships_path %>" method="get">
  <div class="campo">
    <label for="q" class="apenas-leitor-de-tela">Buscar por nome ou e-mail</label>
    <input type="search" id="q" name="busca" value="<%= params[:busca] %>" autocomplete="off" placeholder="Nome ou e-mail">
  </div>
  <% if @several_tenants %>
    <div class="campo">
      <label for="tenant">Credor</label>
      <select id="tenant" name="credor">
        <option value="">Todos</option>
        <%= options_for_select(@tenants, params[:credor]) %>
      </select>
    </div>
  <% end %>
  <div class="campo">
    <label for="per_page" class="apenas-leitor-de-tela">Por página</label>
    <select id="per_page" name="por_pagina"><%= options_for_select(Pagination::PER_PAGE_OPTIONS, @pagination.per_page) %></select>
  </div>
  <button type="submit" data-variant="secondary">Buscar</button>
</form>

<%= render "memberships/result" %>
