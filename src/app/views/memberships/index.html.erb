<% content_for :title, "Usuários" %>
<%= pagina "Usuários", subtitulo: "Quem tem acesso aos credores que você administra" do %>
  <%= abrir_painel "Novo usuário", new_membership_path %>
<% end %>

<% if flash[:temporary_password] %><%= render "memberships/temporary_password", data: flash[:temporary_password] %><% end %>

<form class="filtros" role="search" action="<%= memberships_path %>" method="get"
      hx-sync="this:replace" hx-get="<%= memberships_path %>" hx-trigger="input changed delay:300ms from:#q, change" hx-target="#resultado" hx-push-url="true" hx-swap="outerHTML">
  <div class="campo">
    <label for="q" class="apenas-leitor-de-tela">Buscar por nome ou e-mail</label>
    <input type="search" id="q" name="q" value="<%= params[:q] %>" autocomplete="off" placeholder="Nome ou e-mail">
  </div>
  <% if @several_tenants %>
    <div class="campo">
      <label for="tenant">Credor</label>
      <select id="tenant" name="tenant">
        <option value="">Todos</option>
        <%= options_for_select(@tenants, params[:tenant]) %>
      </select>
    </div>
  <% end %>
  <div class="campo">
    <label for="per_page" class="apenas-leitor-de-tela">Por página</label>
    <select id="per_page" name="per_page"><%= options_for_select(Pagination::PER_PAGE_OPTIONS, @pagination.per_page) %></select>
  </div>
  <button type="submit" data-variant="secondary">Buscar</button>
</form>

<%= render "memberships/result" %>
