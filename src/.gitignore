# Arquivos do Rails que não vão para o git (segredos, logs, temporários).
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets
/config/master.key
/config/credentials/*.key
/.env*
/node_modules
/test/fixtures/files/tmp

# Chaves de desenvolvimento e produção ficam fora do repositório; a de teste só decifra chaves de teste, descartáveis, e é versionada.
!/config/credentials/test.key
