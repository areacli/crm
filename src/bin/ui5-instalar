#!/usr/bin/env ruby
# Instala o OpenUI5 em public/ui5/<versão> (decisão 0025): baixa o pacote oficial da versão fixada, confere o SHA-256 e extrai só as bibliotecas,
# o tema e os idiomas que o CRM usa. Nunca de CDN; o repositório não guarda o OpenUI5 (public/ui5 está no .gitignore).
# Uso: bin/ui5-instalar [pasta de destino]   (no Dockerfile de produção e uma vez no ambiente de desenvolvimento)
# Precisa de `curl` e `unzip` (o Dockerfile de produção os instala no estágio de construção; em desenvolvimento, deploy/rails/ui5.sh).
require "digest"
require "fileutils"
require "open3"
require "tmpdir"

VERSAO = File.read(File.expand_path("../config/ui5_versao", __dir__)).strip
SHA256 = "ea4021f7fc41dfb9c0264e287f8d0a7db7a663981a26a9708acf09aa007dee8b"
ORIGEM = "https://github.com/UI5/openui5/releases/download/#{VERSAO}/openui5-runtime-#{VERSAO}.zip"
destino = File.expand_path(ARGV[0] || "../public/ui5/#{VERSAO}", __dir__)

# Bibliotecas que o CRM não usa (e as de teste, edição e suporte), fora da extração.
FORA = %w[ui/codeeditor ui/integration ui/commons ui/mdc ui/rta ui/ux3 ui/test ui/dt ui/support ui/suite ui/testrecorder ui/webc
          ui/documentation ui/export ui/qunit ui/richtexteditor uxap].freeze
IDIOMAS = /(?:_|\/)(pt|pt_BR|pt_PT|en|en_US)(?:\.|_)|\/messagebundle\.properties\z|\/i18n\.properties\z/

def quer?(caminho)
  return true if %w[LICENSE.txt resources/sap-ui-core.js resources/sap-ui-version.json].include?(caminho)
  return false unless caminho.start_with?("resources/sap/") && !caminho.end_with?("/")

  resto = caminho.delete_prefix("resources/sap/")
  return false if FORA.any? { |lib| resto.start_with?("#{lib}/") }
  return false if caminho.match?(%r{\.map\z|-dbg\.|\.less\z|/designtime/|\.(ts|md)\z})
  return false if (tema = caminho[%r{/themes/([^/]+)/}, 1]) && !%w[base sap_horizon].include?(tema)
  # Textos e dados de idioma: só português e inglês (o inglês é a reserva do OpenUI5).
  return false if caminho.match?(%r{/cldr/[^/]+\.json\z}) && !caminho.match?(%r{/cldr/(pt|pt_BR|en|en_US)\.json\z})
  return false if caminho.match?(%r{/(messagebundle|i18n)_[^/]+\.properties\z}) && !caminho.match?(IDIOMAS)

  true
end

if File.exist?(File.join(destino, "resources/sap-ui-core.js"))
  puts "OpenUI5 #{VERSAO} já está em #{destino}."
  exit
end

Dir.mktmpdir do |tmp|
  zip = File.join(tmp, "openui5.zip")
  system("curl", "-fsSL", "-o", zip, ORIGEM, exception: true)
  abort "SHA-256 diferente do esperado para #{ORIGEM}." unless Digest::SHA256.file(zip).hexdigest == SHA256

  lista, status = Open3.capture2("unzip", "-Z1", zip)
  abort "unzip falhou." unless status.success?
  arquivos = lista.lines(chomp: true).select { |caminho| quer?(caminho) }
  FileUtils.mkdir_p(destino)
  arquivos.each_slice(500) { |lote| system("unzip", "-q", "-o", zip, *lote, "-d", destino, exception: true) }
  puts "OpenUI5 #{VERSAO}: #{arquivos.size} arquivos em #{destino}."
end
